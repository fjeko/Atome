<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Les tests peuvent appeler les méthodes « internal » (détails de la logique de mise à jour). -->
    <InternalsVisibleTo Include="Revisions.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Banque de messages de la mascotte (fichier de ressources, voir Mascotte/BanqueMessages.cs). -->
    <EmbeddedResource Include="Mascotte\messages-mascotte.json" LogicalName="Mascotte/messages-mascotte.json" />
  </ItemGroup>

</Project>
