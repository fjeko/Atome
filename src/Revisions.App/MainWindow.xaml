<Window x:Class="Revisions.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Révisions BTS SIO"
        Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre de navigation (masquée pendant une session ou une lecture). -->
        <DockPanel Grid.RowSpan="2" Width="200" Margin="12,16,0,16"
                   Visibility="{Binding NavigationVisible, Converter={StaticResource VisibleSi}}">
            <TextBlock DockPanel.Dock="Top" Text="Révisions" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,2" />
            <TextBlock DockPanel.Dock="Top" Text="BTS SIO" Style="{StaticResource Discret}" Margin="12,0,0,18" />
            <ListBox SelectedValue="{Binding Rubrique, Mode=TwoWay}" SelectedValuePath="Tag"
                     Background="Transparent" BorderThickness="0" FontSize="15">
                <ListBoxItem Tag="accueil" Content="Accueil" Padding="12,10" />
                <ListBoxItem Tag="bibliotheque" Content="Bibliothèque" Padding="12,10" />
                <ListBoxItem Tag="statistiques" Content="Statistiques" Padding="12,10" />
                <ListBoxItem Tag="reglages" Content="Réglages" Padding="12,10" />
            </ListBox>
        </DockPanel>

        <!-- Écran courant : la vue est choisie d'après le type du ViewModel (voir App.xaml). -->
        <ContentControl Grid.Column="1" Content="{Binding VueCourante}" Focusable="False" />

        <!-- Bandeau d'information (résultat d'un import). -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Carte}" Padding="14,8" Margin="28,0,28,14"
                Visibility="{Binding Bandeau, Converter={StaticResource VisibleSi}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="OK" Command="{Binding FermerBandeauCommand}" Padding="14,4" />
                <TextBlock Text="{Binding Bandeau}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
