<Window x:Class="Revisions.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Revisions.App.Views"
        xmlns:ds="clr-namespace:Revisions.App.Controles"
        xmlns:s="clr-namespace:Revisions.App.Services"
        Title="Atome" Icon="Ressources/mini.ico"
        Width="1240" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <!--
        Fenêtre principale (docs/design-atome.md, section 5) : barre latérale à gauche (icônes et libellés,
        repliable, repliée d'office sous 1100 px), écran courant au centre, bandeaux et toasts par-dessus.
        En session et en lecture, la barre disparaît (mode concentration) ; F11 passe en plein écran.
        Le fond est celui du thème Fluent : l'effet Mica de Windows 11, ou la couleur unie du thème.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Barre latérale ===== -->
        <DockPanel x:Name="Barre" Grid.RowSpan="2" Margin="12,12,0,12" Visibility="{Binding NavigationVisible, Converter={StaticResource VisibleSi}}">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Width" Value="224" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NavigationCompacte}" Value="True">
                            <Setter Property="Width" Value="60" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- Bouton ☰ (replier / déplier), logo et nom. -->
            <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Marge.Bas.16}">
                <Button Style="{StaticResource BoutonIcone}" ds:Forme.Icone="{x:Static ds:Icones.Menu}" HorizontalAlignment="Left"
                        Margin="6,0,0,0" Command="{Binding BasculerNavigationCommand}"
                        ToolTip="Replier ou déplier le menu" AutomationProperties.Name="Replier ou déplier le menu" />
                <StackPanel Orientation="Horizontal" Margin="10,16,0,0">
                    <v:LogoArbre Width="32" Height="32" />
                    <StackPanel Margin="{StaticResource Marge.Gauche.12}" VerticalAlignment="Center"
                                Visibility="{Binding NavigationCompacte, Converter={StaticResource VisibleSi}, ConverterParameter=inverse}">
                        <TextBlock Text="Atome" Style="{StaticResource Texte.SousTitre}" />
                        <TextBlock Text="Tes révisions, at home." Style="{StaticResource Texte.Meta}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Accès discret au Discord, tout en bas du menu (pas une rubrique : il ouvre le navigateur). -->
            <Button DockPanel.Dock="Bottom" Style="{StaticResource BoutonListe}" HorizontalAlignment="Left" Margin="8,8,0,0"
                    Padding="8,8,12,8" Command="{Binding OuvrirDiscordCommand}"
                    ToolTip="Un bug, une coquille, une idée ? Rejoins le Discord"
                    AutomationProperties.Name="Rejoindre le Discord d'Atome">
                <StackPanel Orientation="Horizontal">
                    <!-- Logo officiel en blurple ; le libellé disparaît quand le menu est replié (l'infobulle reste). -->
                    <Viewbox Width="20" Height="20">
                        <Path Data="{StaticResource Logo.Discord}" Fill="{StaticResource Pinceau.Discord}" />
                    </Viewbox>
                    <TextBlock Text="Discord" Margin="{StaticResource Marge.Gauche.12}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Pinceau.TexteSecondaire}"
                               Visibility="{Binding NavigationCompacte, Converter={StaticResource VisibleSi}, ConverterParameter=inverse}" />
                </StackPanel>
            </Button>

            <!-- Rubriques : une icône et un libellé (le libellé disparaît quand la barre est repliée, l'infobulle reste). -->
            <ListBox SelectedValue="{Binding Rubrique, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource ListeNue}"
                     ItemContainerStyle="{StaticResource ElementNavigation}" AutomationProperties.Name="Menu principal">
                <ListBox.Resources>
                    <Style x:Key="Libelle" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="{StaticResource Marge.Gauche.12}" />
                        <Setter Property="Visibility" Value="{Binding DataContext.NavigationCompacte, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource VisibleSi}, ConverterParameter=inverse}" />
                    </Style>
                    <Style x:Key="IconeNav" TargetType="TextBlock" BasedOn="{StaticResource Texte.Icone}">
                        <Setter Property="FontSize" Value="{DynamicResource Taille.IconeGrande}" />
                        <Setter Property="Width" Value="24" />
                        <Setter Property="TextAlignment" Value="Center" />
                    </Style>
                </ListBox.Resources>
                <ListBoxItem Tag="accueil" ToolTip="Accueil" AutomationProperties.Name="Accueil">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ds:Icones.Accueil}" Style="{StaticResource IconeNav}" />
                        <TextBlock Text="Accueil" Style="{StaticResource Libelle}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="bibliotheque" ToolTip="Bibliothèque" AutomationProperties.Name="Bibliothèque">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ds:Icones.Bibliotheque}" Style="{StaticResource IconeNav}" />
                        <TextBlock Text="Bibliothèque" Style="{StaticResource Libelle}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="td" ToolTip="TD en groupe : le même TD à plusieurs, chacun sur son PC" AutomationProperties.Name="TD en groupe">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ds:Icones.Groupe}" Style="{StaticResource IconeNav}" />
                        <TextBlock Text="TD en groupe" Style="{StaticResource Libelle}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="acquis" ToolTip="Mes acquis" AutomationProperties.Name="Mes acquis">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ds:Icones.Acquis}" Style="{StaticResource IconeNav}" />
                        <TextBlock Text="Mes acquis" Style="{StaticResource Libelle}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="planning" ToolTip="Planning" AutomationProperties.Name="Planning">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ds:Icones.Planning}" Style="{StaticResource IconeNav}" />
                        <TextBlock Text="Planning" Style="{StaticResource Libelle}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="statistiques" ToolTip="Statistiques" AutomationProperties.Name="Statistiques">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ds:Icones.Statistiques}" Style="{StaticResource IconeNav}" />
                        <TextBlock Text="Statistiques" Style="{StaticResource Libelle}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="reglages" ToolTip="Réglages" AutomationProperties.Name="Réglages">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ds:Icones.Reglages}" Style="{StaticResource IconeNav}" />
                        <TextBlock Text="Réglages" Style="{StaticResource Libelle}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="aide" ToolTip="Aide" AutomationProperties.Name="Aide">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ds:Icones.Aide}" Style="{StaticResource IconeNav}" />
                        <TextBlock Text="Aide" Style="{StaticResource Libelle}" />
                    </StackPanel>
                </ListBoxItem>
                <!-- Version de développement seulement : la Galerie des composants. -->
                <ListBoxItem Tag="galerie" ToolTip="Galerie des composants (développement)" AutomationProperties.Name="Galerie"
                             Visibility="{Binding GalerieVisible, Converter={StaticResource VisibleSi}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ds:Icones.Galerie}" Style="{StaticResource IconeNav}" />
                        <TextBlock Text="Galerie" Style="{StaticResource Libelle}" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- ===== Écran courant (vue choisie d'après le type du ViewModel, voir App.xaml) ===== -->
        <!-- Chaque nouvel écran apparaît en fondu avec un léger glissement (Services/Mouvement.cs). -->
        <ContentControl x:Name="Ecran" Grid.Column="1" Content="{Binding VueCourante, NotifyOnTargetUpdated=True}"
                        Binding.TargetUpdated="EcranChange" Focusable="False" />

        <!-- ===== Bandeaux, posés en bas du contenu ===== -->
        <StackPanel Grid.Column="1" Grid.Row="1" MaxWidth="{StaticResource Largeur.Contenu}" Margin="32,0,32,12">
            <!-- Nouvelle version disponible : jamais pendant une session (voir MiseAJourVisible). -->
            <ds:Bandeau DataContext="{Binding MiseAJour}" Icone="{x:Static ds:Icones.Telecharger}"
                        Titre="{Binding Titre}" Texte="{Binding SousTitre}" Margin="{StaticResource Marge.Haut.12}"
                        Visibility="{Binding DataContext.MiseAJourVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleSi}}">
                <ds:Bandeau.Actions>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ChoixVisibles, Converter={StaticResource VisibleSi}}">
                            <Button Content="{Binding TexteBoutonPrincipal}" Command="{Binding MettreAJourCommand}" Style="{StaticResource BoutonPrincipal}" />
                            <Button Content="Plus tard" Command="{Binding PlusTardCommand}" Style="{StaticResource BoutonSecondaire}" Margin="{StaticResource Marge.Gauche.8}"
                                    ToolTip="La proposition reviendra au prochain lancement d'Atome." />
                            <Button Content="Ignorer cette version" Command="{Binding IgnorerCommand}" Style="{StaticResource BoutonFantome}" Margin="{StaticResource Marge.Gauche.8}"
                                    ToolTip="Cette version ne sera plus proposée. Les suivantes, si." />
                        </StackPanel>
                        <Button Content="Annuler" Command="{Binding AnnulerCommand}" Style="{StaticResource BoutonSecondaire}"
                                Visibility="{Binding EnTelechargement, Converter={StaticResource VisibleSi}}" />
                        <Button Content="Installer maintenant" Command="{Binding InstallerCommand}" Style="{StaticResource BoutonPrincipal}"
                                Visibility="{Binding PretAInstaller, Converter={StaticResource VisibleSi}}" />
                    </StackPanel>
                </ds:Bandeau.Actions>
                <StackPanel>
                    <!-- Résumé des notes de version (texte simple, quelques lignes). -->
                    <ItemsControl ItemsSource="{Binding Notes}" Margin="{StaticResource Marge.Haut.4}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Texte.Meta}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="{StaticResource Marge.Haut.4}" FontSize="{DynamicResource Taille.Meta}">
                        <Hyperlink Command="{Binding OuvrirPageReleaseCommand}" Style="{StaticResource Texte.Lien}">Voir toutes les nouveautés</Hyperlink>
                    </TextBlock>
                    <ProgressBar Style="{StaticResource BarreProgression}" Value="{Binding Progression, Mode=OneWay}" Margin="{StaticResource Marge.Haut.8}"
                                 Visibility="{Binding EnTelechargement, Converter={StaticResource VisibleSi}}" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Texte.Secondaire}" Margin="{StaticResource Marge.Haut.8}"
                               Visibility="{Binding Message, Converter={StaticResource VisibleSi}}" />
                </StackPanel>
            </ds:Bandeau>

            <!-- Information (résultat d'un import, bilan d'une mise à jour). -->
            <ds:Bandeau Texte="{Binding Bandeau}" Icone="{x:Static ds:Icones.Info}" Margin="{StaticResource Marge.Haut.12}"
                        Visibility="{Binding Bandeau, Converter={StaticResource VisibleSi}}">
                <ds:Bandeau.Actions>
                    <Button Content="OK" Command="{Binding FermerBandeauCommand}" Style="{StaticResource BoutonSecondaire}" />
                </ds:Bandeau.Actions>
            </ds:Bandeau>
        </StackPanel>

        <!-- ===== Toasts (notifications brèves) ===== -->
        <ItemsControl Grid.ColumnSpan="2" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="{StaticResource Marge.Bas.24}"
                      ItemsSource="{x:Static s:ServiceToast.Visibles}" ItemTemplate="{StaticResource Modele.Toast}"
                      IsHitTestVisible="False" Focusable="False" />
    </Grid>
</Window>
