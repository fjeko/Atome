<Window x:Class="Revisions.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Revisions.App.Views"
        Title="Atome" Icon="Ressources/mini.ico"
        Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre de navigation (masquée pendant une session ou une lecture). -->
        <Border Grid.RowSpan="2" Width="232" Margin="14,14,0,14" Padding="10,22,10,14" CornerRadius="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding NavigationVisible, Converter={StaticResource VisibleSi}}">
            <DockPanel>
                <!-- Logo, puis nom de l'application. -->
                <v:LogoArbre DockPanel.Dock="Top" Width="112" Height="112" />
                <TextBlock DockPanel.Dock="Top" Text="Atome" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock DockPanel.Dock="Top" Text="Atome : tes révisions, at home." Style="{StaticResource Discret}"
                           FontSize="11.5" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,22" />

                <!-- Rubriques : une icône (police d'icônes de Windows) et un libellé. -->
                <ListBox SelectedValue="{Binding Rubrique, Mode=TwoWay}" SelectedValuePath="Tag"
                         Background="Transparent" BorderThickness="0" FontSize="15.5">
                    <ListBox.Resources>
                        <Style x:Key="Icone" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="Width" Value="34" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem Tag="accueil" Padding="14,13">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Icone}" />
                            <TextBlock Text="Accueil" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="bibliotheque" Padding="14,13">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource Icone}" />
                            <TextBlock Text="Bibliothèque" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="acquis" Padding="14,13">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icone}" />
                            <TextBlock Text="Mes acquis" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="planning" Padding="14,13">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" Style="{StaticResource Icone}" />
                            <TextBlock Text="Planning" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="statistiques" Padding="14,13">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource Icone}" />
                            <TextBlock Text="Statistiques" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="reglages" Padding="14,13">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icone}" />
                            <TextBlock Text="Réglages" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="aide" Padding="14,13">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" Style="{StaticResource Icone}" />
                            <TextBlock Text="Aide" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Écran courant : la vue est choisie d'après le type du ViewModel (voir App.xaml). -->
        <!-- Chaque nouvel écran apparaît en fondu, en remontant légèrement : l'appli paraît plus vivante. -->
        <ContentControl Grid.Column="1" Content="{Binding VueCourante, NotifyOnTargetUpdated=True}" Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="RenderTransform"><Setter.Value><TranslateTransform /></Setter.Value></Setter>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" />
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.28">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <!-- Bandeau « nouvelle version disponible » : jamais pendant une session (voir MiseAJourVisible). -->
            <Border Style="{StaticResource Carte}" Padding="18,12" Margin="28,0,28,14"
                    Visibility="{Binding MiseAJourVisible, Converter={StaticResource VisibleSi}}">
                <DockPanel DataContext="{Binding MiseAJour}">
                    <!-- Pictogramme « téléchargement » de la police d'icônes de Windows. -->
                    <TextBlock DockPanel.Dock="Left" Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Margin="0,2,14,0" />

                    <!-- Boutons à droite : les trois choix, ou « Annuler » pendant le téléchargement. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ChoixVisibles, Converter={StaticResource VisibleSi}}">
                            <Button Content="{Binding TexteBoutonPrincipal}" Command="{Binding MettreAJourCommand}"
                                    Style="{DynamicResource AccentButtonStyle}" Padding="16,6" />
                            <Button Content="Plus tard" Command="{Binding PlusTardCommand}" Padding="14,6" Margin="8,0,0,0"
                                    ToolTip="La proposition reviendra au prochain lancement d'Atome." />
                            <Button Content="Ignorer cette version" Command="{Binding IgnorerCommand}" Padding="14,6" Margin="8,0,0,0"
                                    ToolTip="Cette version ne sera plus proposée. Les suivantes, si." />
                        </StackPanel>
                        <Button Content="Annuler" Command="{Binding AnnulerCommand}" Padding="14,6"
                                Visibility="{Binding EnTelechargement, Converter={StaticResource VisibleSi}}" />
                        <Button Content="Installer maintenant" Command="{Binding InstallerCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,6"
                                Visibility="{Binding PretAInstaller, Converter={StaticResource VisibleSi}}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap">
                            <Run Text="{Binding Titre, Mode=OneWay}" />
                            <Run Text="{Binding SousTitre, Mode=OneWay}" FontWeight="Normal" FontSize="13"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <!-- Résumé des notes de version (texte simple, quelques lignes). -->
                        <ItemsControl ItemsSource="{Binding Notes}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Discret}" FontSize="12.5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="12.5" Margin="0,4,0,0">
                            <Hyperlink Command="{Binding OuvrirPageReleaseCommand}">Voir toutes les nouveautés</Hyperlink>
                        </TextBlock>
                        <ProgressBar Value="{Binding Progression, Mode=OneWay}" Maximum="1" Height="6" Margin="0,8,0,0"
                                     Visibility="{Binding EnTelechargement, Converter={StaticResource VisibleSi}}" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,0"
                                   Visibility="{Binding Message, Converter={StaticResource VisibleSi}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Bandeau d'information (résultat d'un import). -->
            <Border Style="{StaticResource Carte}" Padding="14,8" Margin="28,0,28,14"
                    Visibility="{Binding Bandeau, Converter={StaticResource VisibleSi}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="OK" Command="{Binding FermerBandeauCommand}" Padding="14,4" />
                    <TextBlock Text="{Binding Bandeau}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
