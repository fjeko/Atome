<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Atome</AssemblyName>
    <RootNamespace>Revisions.App</RootNamespace>
    <Version>0.2.0</Version>
    <!-- Icône de l'exécutable, reprise par la barre des tâches, les fenêtres et le raccourci. -->
    <ApplicationIcon>Ressources\icone.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Logo du menu et icône des petites tailles (barre de titre, barre des tâches). -->
    <Resource Include="Ressources/logo.png" />
    <Resource Include="Ressources/mini.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Revisions.Core\Revisions.Core.csproj" />
    <ProjectReference Include="..\Revisions.Data\Revisions.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- Pages de l'aide (Markdown), incorporées dans l'exécutable sous le nom « Aide/<fichier> ».
       Aide\prompt-type.md est une copie de docs\prompt-type.md : la recopier si le prompt change. -->
  <ItemGroup>
    <EmbeddedResource Include="Aide\*.md" LogicalName="Aide/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Page de rendu et bibliothèques JavaScript : copiées à côté de l'exécutable. -->
  <ItemGroup>
    <Content Include="Web\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Cours libres (CC BY-SA 4.0) livrés avec Atome : copiés dans « contenu-libre » à côté de l'exécutable
       (build, publier.ps1, setup Inno et ZIP portable partent tous du dossier de publication). -->
  <ItemGroup>
    <Content Include="..\..\contenu-libre\**\*" Link="contenu-libre\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
