<UserControl x:Class="Revisions.App.Views.VueLecture"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Revisions.App.Controles"
             xmlns:ds="clr-namespace:Revisions.App.Controles">
    <!--
        Lecture d'une séance : sommaire latéral (toujours visible), texte de largeur limitée (environ 70 caractères,
        voir Web/app.css), progression de lecture aux couleurs de la matière, taille du texte (A- / A+),
        « Réviser cette séance », « Voir le PDF » et signalement.
    -->
    <Grid Margin="24,20,24,16" ds:Ton.Matiere="{Binding Matiere}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== En-tête : retour, titre de la séance, actions ===== -->
        <DockPanel Grid.ColumnSpan="2">
            <Button DockPanel.Dock="Left" Style="{StaticResource BoutonIcone}" ds:Forme.Icone="{x:Static ds:Icones.Retour}" Command="{Binding RetourCommand}"
                    Margin="{StaticResource Marge.Droite.12}" VerticalAlignment="Center" ToolTip="Retour à la bibliothèque"
                    AutomationProperties.Name="Retour à la bibliothèque"
                    Visibility="{Binding PeutReviser, Converter={StaticResource VisibleSi}}" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding MessageSignalement}" Style="{StaticResource Texte.Meta}" VerticalAlignment="Center" TextWrapping="NoWrap"
                           Margin="{StaticResource Marge.Droite.4}" Visibility="{Binding MessageSignalement, Converter={StaticResource VisibleSi}}" />
                <Button Style="{StaticResource BoutonIcone}" ds:Forme.Icone="{x:Static ds:Icones.Drapeau}" Command="{Binding SignalerCommand}"
                        AutomationProperties.Name="Signaler une erreur" Margin="{StaticResource Marge.Droite.8}"
                        ToolTip="Signaler une erreur : une faute ou une erreur dans cette section ?" />
                <!-- Taille du texte : réglage général, aussi dans les Réglages. -->
                <Border Style="{StaticResource PastilleNeutre}" Padding="2" Margin="{StaticResource Marge.Droite.8}" CornerRadius="{StaticResource Rayon.Controle}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="A−" Style="{StaticResource BoutonFantome}" Foreground="{DynamicResource Pinceau.Texte}" Padding="10,4"
                                Command="{Binding RetrecirTexteCommand}" ToolTip="Texte plus petit" AutomationProperties.Name="Texte plus petit" />
                        <TextBlock Text="{Binding TailleTexte}" Style="{StaticResource Texte.Meta}" VerticalAlignment="Center" MinWidth="36" TextAlignment="Center" />
                        <Button Content="A+" Style="{StaticResource BoutonFantome}" Foreground="{DynamicResource Pinceau.Texte}" Padding="10,4"
                                Command="{Binding AgrandirTexteCommand}" ToolTip="Texte plus grand" AutomationProperties.Name="Texte plus grand" />
                    </StackPanel>
                </Border>
                <Button Content="{Binding LibelleSource}" Command="{Binding VoirPdfCommand}" Style="{StaticResource BoutonSecondaire}"
                        ds:Forme.Icone="{x:Static ds:Icones.Pdf}" Margin="{StaticResource Marge.Droite.8}"
                        ToolTip="Ouvrir le document d'origine (à la page de cette section pour un PDF)"
                        Visibility="{Binding ADocumentSource, Converter={StaticResource VisibleSi}}" />
                <Button Content="Réviser cette séance" Command="{Binding ReviserCommand}" Style="{StaticResource BoutonPrincipal}"
                        ds:Forme.Icone="{x:Static ds:Icones.Jouer}"
                        Visibility="{Binding PeutReviser, Converter={StaticResource VisibleSi}}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center" Margin="{StaticResource Marge.Droite.16}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Texte.Icone}" FontSize="{DynamicResource Taille.Meta}" Margin="{StaticResource Marge.Droite.4}"
                               Text="{Binding (ds:Ton.Icone), RelativeSource={RelativeSource Self}}"
                               Foreground="{Binding (ds:Ton.Texte), RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="{Binding Matiere}" Style="{StaticResource Texte.Meta}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Foreground="{Binding (ds:Ton.Texte), RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <TextBlock Text="{Binding Titre}" Style="{StaticResource Texte.TitreCours}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           ToolTip="{Binding Titre}" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Progression de lecture ===== -->
        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource BarreTon}" Height="4" Value="{Binding Progression, Mode=OneWay}"
                     Margin="0,16,0,16" AutomationProperties.Name="Progression de lecture" />

        <!-- ===== Sommaire (toujours visible à gauche) ===== -->
        <DockPanel Grid.Row="2" Grid.RowSpan="2" Margin="{StaticResource Marge.Droite.16}">
            <TextBlock DockPanel.Dock="Top" Text="Sommaire" Style="{StaticResource Texte.Meta}" FontWeight="SemiBold" Margin="12,0,0,8" />
            <ListBox ItemsSource="{Binding Sections}" SelectedIndex="{Binding Index, Mode=TwoWay}" Style="{StaticResource ListeNue}"
                     ItemContainerStyle="{StaticResource ElementNavigation}" AutomationProperties.Name="Sommaire de la séance"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Titre}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== Contenu de la section ===== -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CarteSurface}" Padding="8,12,8,4">
            <c:VueMarkdown Message="{Binding MessageRendu}" CommandeTouche="{Binding ToucheCommand}" />
        </Border>

        <!-- ===== Section précédente / suivante (← →) ===== -->
        <Grid Grid.Row="3" Grid.Column="1" Margin="{StaticResource Marge.Haut.12}">
            <Button Content="Précédent" Command="{Binding PrecedentCommand}" Style="{StaticResource BoutonSecondaire}"
                    ds:Forme.Icone="{x:Static ds:Icones.Retour}" ds:Forme.Raccourci="←" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Position}" Style="{StaticResource Texte.Meta}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button Command="{Binding SuivantCommand}" Style="{StaticResource BoutonSecondaire}" ds:Forme.Raccourci="→" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Suivant" />
                    <TextBlock Style="{StaticResource Texte.Icone}" Text="{x:Static ds:Icones.Suivant}" Margin="{StaticResource Marge.Gauche.8}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
