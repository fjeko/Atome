<UserControl x:Class="Revisions.App.Views.VueAide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Revisions.App.Controles">
    <Grid Margin="28,28,28,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête : titre, et bouton de copie du prompt sur la page qui en a un. -->
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Copier le prompt" Command="{Binding CopierPromptCommand}"
                    Style="{DynamicResource AccentButtonStyle}" Padding="18,8" VerticalAlignment="Center"
                    Visibility="{Binding PromptDisponible, Converter={StaticResource VisibleSi}}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Confirmation}" Style="{StaticResource Discret}"
                       VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock Text="Aide" Style="{StaticResource Titre}" />
        </DockPanel>

        <!-- Sommaire. -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Pages}" SelectedIndex="{Binding Index, Mode=TwoWay}"
                 Margin="0,0,14,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Titre}" TextWrapping="Wrap" Margin="2,5" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Page affichée. -->
        <Border Grid.Row="1" Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <c:VueMarkdown Message="{Binding MessageRendu}" />
        </Border>
    </Grid>
</UserControl>
