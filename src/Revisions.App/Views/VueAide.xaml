<UserControl x:Class="Revisions.App.Views.VueAide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Revisions.App.Controles"
             xmlns:ds="clr-namespace:Revisions.App.Controles">
    <!-- Aide : même présentation que la Lecture (sommaire à gauche, texte de largeur limitée dans une carte). -->
    <Grid Margin="24,20,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête : titre, et bouton de copie du prompt sur la page qui en a un. -->
        <DockPanel Grid.ColumnSpan="2" Margin="{StaticResource Marge.Bas.16}">
            <Button DockPanel.Dock="Right" Content="Copier le prompt" Command="{Binding CopierPromptCommand}" Style="{StaticResource BoutonPrincipal}"
                    ds:Forme.Icone="{x:Static ds:Icones.Copier}" VerticalAlignment="Center"
                    Visibility="{Binding PromptDisponible, Converter={StaticResource VisibleSi}}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Confirmation}" Style="{StaticResource Texte.Secondaire}"
                       VerticalAlignment="Center" Margin="{StaticResource Marge.Droite.12}" />
            <TextBlock Text="Aide" Style="{StaticResource Texte.Titre}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Sommaire. -->
        <DockPanel Grid.Row="1" Margin="{StaticResource Marge.Droite.16}">
            <!-- Sous le sommaire : une phrase et le bouton vers le Discord. -->
            <StackPanel DockPanel.Dock="Bottom" Margin="12,12,0,0">
                <TextBlock Text="Un bug, une coquille, une idée ? Signale-le sur le Discord." Style="{StaticResource Texte.Meta}"
                           TextWrapping="Wrap" Margin="{StaticResource Marge.Bas.8}" />
                <Button Command="{Binding OuvrirDiscordCommand}" Style="{StaticResource BoutonSecondaire}" HorizontalAlignment="Left"
                        AutomationProperties.Name="Rejoindre le Discord">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18">
                            <Path Data="{StaticResource Logo.Discord}" Fill="{StaticResource Pinceau.Discord}" />
                        </Viewbox>
                        <TextBlock Text="Rejoindre le Discord" Margin="{StaticResource Marge.Gauche.8}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="Sommaire" Style="{StaticResource Texte.Meta}" FontWeight="SemiBold" Margin="12,0,0,8" />
            <ListBox ItemsSource="{Binding Pages}" SelectedIndex="{Binding Index, Mode=TwoWay}" Style="{StaticResource ListeNue}"
                     ItemContainerStyle="{StaticResource ElementNavigation}" AutomationProperties.Name="Pages de l'aide">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Titre}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Page affichée. -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CarteSurface}" Padding="8,12,8,4">
            <c:VueMarkdown Message="{Binding MessageRendu}" />
        </Border>
    </Grid>
</UserControl>
