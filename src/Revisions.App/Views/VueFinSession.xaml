<UserControl x:Class="Revisions.App.Views.VueFinSession"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Revisions.App.Views"
             xmlns:ds="clr-namespace:Revisions.App.Controles"
             x:Name="Racine">
    <!--
        Fin de session : la mascotte, fière ; un anneau de réussite, l'XP gagnée et le niveau ;
        les cartes ratées à revoir, présentées comme une occasion (avec un lien vers le cours), jamais comme un reproche.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="{StaticResource Largeur.Contenu}" Margin="{StaticResource Marge.Ecran}">
            <v:BandeauMascotte Taille="96" Message="{Binding MessageMascotte}" Humeur="{Binding HumeurMascotte}"
                               HorizontalAlignment="Left" Margin="{StaticResource Marge.Bas.16}" />

            <!-- Le bilan, en une carte. -->
            <Border Style="{StaticResource CarteSurface}" Padding="{StaticResource Remplissage.CarteLarge}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Anneau de réussite. -->
                    <StackPanel VerticalAlignment="Center" Margin="{StaticResource Marge.Droite.24}">
                        <ds:Anneau Width="140" Height="140" Epaisseur="12" Valeur="{Binding TauxReussite}"
                                   Trait="{DynamicResource Ton.Succes.Trait}" Piste="{DynamicResource Pinceau.Voile}"
                                   AutomationProperties.Name="Réussite de la session">
                            <TextBlock Text="{Binding Reussite}" Style="{StaticResource Texte.Chiffre}" FontSize="{DynamicResource Taille.Titre}" />
                        </ds:Anneau>
                        <TextBlock Text="de réussite" Style="{StaticResource Texte.Meta}" HorizontalAlignment="Center" Margin="{StaticResource Marge.Haut.8}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Titre}" Style="{StaticResource Texte.Salut}" />
                        <TextBlock Text="{Binding Objectif}" Style="{StaticResource Texte.Secondaire}" Margin="{StaticResource Marge.Haut.4}"
                                   Visibility="{Binding Objectif, Converter={StaticResource VisibleSi}}" />
                        <WrapPanel Margin="{StaticResource Marge.Haut.16}">
                            <Border Style="{StaticResource PastilleNeutre}" Padding="12,6" Margin="{StaticResource Marge.Droite.8}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Texte.Icone}" Text="{x:Static ds:Icones.Coche}" Margin="{StaticResource Marge.Droite.8}" />
                                    <TextBlock FontSize="{DynamicResource Taille.Interface}"><Run Text="{Binding Cartes, Mode=OneWay}" /> revues</TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pastille}" ds:Ton.Nom="Info" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Texte.Icone}" Text="{x:Static ds:Icones.Etoile}" Margin="{StaticResource Marge.Droite.8}" />
                                    <TextBlock Text="{Binding Xp}" FontSize="{DynamicResource Taille.Interface}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <v:CompteurXp x:Name="Compteur" Niveau="{Binding Niveau}" Progression="{Binding ProgressionNiveau}" Texte="{Binding XpTotal}"
                                      Margin="{StaticResource Marge.Haut.24}" MaxWidth="420" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cartes ratées : une occasion de revoir la notion, pas un reproche. -->
            <Border Style="{StaticResource CarteSurface}" Margin="{StaticResource Marge.Haut.16}"
                    Visibility="{Binding ADesRatees, Converter={StaticResource VisibleSi}}">
                <StackPanel>
                    <TextBlock Text="À revoir tranquillement" Style="{StaticResource Texte.SousTitre}" />
                    <TextBlock Text="Ces cartes reviendront bientôt toutes seules. Tu peux relire la notion maintenant si tu veux."
                               Style="{StaticResource Texte.Secondaire}" Margin="{StaticResource Marge.Haut.4}" />
                    <TextBlock Text="{Binding MessageSignalement}" Style="{StaticResource Texte.Meta}" Margin="{StaticResource Marge.Haut.8}"
                               Visibility="{Binding MessageSignalement, Converter={StaticResource VisibleSi}}" />
                    <ItemsControl ItemsSource="{Binding Ratees}" Margin="{StaticResource Marge.Haut.8}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Pinceau.Bordure}" BorderThickness="0,1,0,0" Padding="0,12,0,4">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Revoir la notion" Style="{StaticResource BoutonSecondaire}"
                                                ds:Forme.Icone="{x:Static ds:Icones.Lire}" Margin="{StaticResource Marge.Gauche.12}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RevoirNotionCommand, ElementName=Racine}" CommandParameter="{Binding}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BoutonIcone}" ds:Forme.Icone="{x:Static ds:Icones.Drapeau}"
                                                VerticalAlignment="Center" AutomationProperties.Name="Signaler une erreur"
                                                ToolTip="Signaler une erreur dans cette carte : une faute, une réponse fausse ?"
                                                Command="{Binding DataContext.SignalerCommand, ElementName=Racine}" CommandParameter="{Binding}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Texte}" Style="{StaticResource Texte.Base}" />
                                            <TextBlock Text="{Binding Seance}" Style="{StaticResource Texte.Meta}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Button Content="Retour à l'accueil" Command="{Binding AccueilCommand}" IsDefault="True" Style="{StaticResource BoutonPrincipal}"
                    ds:Forme.Raccourci="Entrée" Margin="{StaticResource Marge.Haut.24}" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
