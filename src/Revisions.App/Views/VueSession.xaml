<UserControl x:Class="Revisions.App.Views.VueSession"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Revisions.App.Controles"
             xmlns:v="clr-namespace:Revisions.App.Views"
             xmlns:ds="clr-namespace:Revisions.App.Controles">
    <!--
        Session de révision, en mode concentration (sans barre latérale ; F11 pour le plein écran).
        De haut en bas : avancement, d'où vient la carte et pourquoi, la carte, la saisie facultative,
        puis une seule rangée d'actions à la fois (révéler, continuer, noter, ou confirmer la pause).
    -->
    <Grid Margin="{StaticResource Marge.Ecran}" MaxWidth="{StaticResource Largeur.Contenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Avancement ===== -->
        <DockPanel>
            <Button DockPanel.Dock="Left" Content="Pause" Command="{Binding ArreterCommand}" Style="{StaticResource BoutonFantome}"
                    ds:Forme.Icone="{x:Static ds:Icones.Pause}" Foreground="{DynamicResource Pinceau.TexteSecondaire}"
                    ToolTip="Faire une pause : ce qui est fait est enregistré (Échap)" />
            <Grid DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BoutonFantome}" Content="Calculatrice" ds:Forme.Icone="{x:Static ds:Icones.Calculatrice}"
                            DataContext="{Binding Calculatrice}" Command="{Binding BasculerCommand}" Margin="{StaticResource Marge.Droite.8}"
                            Visibility="{Binding Visible, Converter={StaticResource VisibleSi}}"
                            Foreground="{DynamicResource Pinceau.TexteSecondaire}" AutomationProperties.Name="Calculatrice"
                            ToolTip="Ouvrir ou fermer la calculatrice (Ctrl + K)" />

                    <TextBlock Text="{Binding MessageSignalement}" Style="{StaticResource Texte.Meta}" VerticalAlignment="Center"
                               Margin="{StaticResource Marge.Droite.4}" TextWrapping="NoWrap"
                               Visibility="{Binding MessageSignalement, Converter={StaticResource VisibleSi}}" />
                    <!-- Annuler la dernière note (Ctrl+Z) : discret, visible juste après une note. -->
                    <Button Content="Annuler" Command="{Binding AnnulerCommand}" Style="{StaticResource BoutonFantome}" ds:Forme.Icone="{x:Static ds:Icones.Retour}"
                            Margin="{StaticResource Marge.Droite.8}" AutomationProperties.Name="Annuler la dernière note"
                            ToolTip="Tu t'es trompé de bouton ? Reviens à la carte précédente (Ctrl + Z)"
                            Visibility="{Binding AnnulerVisible, Converter={StaticResource VisibleSi}}" />
                    <!-- Signalement discret : un petit drapeau (touche S). -->
                    <Button Style="{StaticResource BoutonIcone}" ds:Forme.Icone="{x:Static ds:Icones.Drapeau}" Command="{Binding SignalerCommand}"
                            Margin="{StaticResource Marge.Droite.8}" AutomationProperties.Name="Signaler une erreur"
                            ToolTip="Signaler une erreur dans cette carte : une faute, une réponse fausse ? (touche S)" />
                    <Border Style="{StaticResource PastilleNeutre}" Padding="10,3">
                        <TextBlock Text="{Binding Compteur}" FontSize="{DynamicResource Taille.Interface}" />
                    </Border>
                </StackPanel>
                <!-- Scène des « +10 » qui montent après chaque note. -->
                <Canvas x:Name="SceneXp" IsHitTestVisible="False" HorizontalAlignment="Right" Width="1" />
            </Grid>
            <ProgressBar Style="{StaticResource BarreProgression}" Value="{Binding Avancement, Mode=OneWay}" Margin="16,0" VerticalAlignment="Center"
                         AutomationProperties.Name="Avancement de la session" />
        </DockPanel>

        <!-- ===== D'où vient la carte et pourquoi elle est là. Un clic sur le fil ouvre la section du cours. ===== -->
        <WrapPanel Grid.Row="1" Margin="0,16,0,12">
            <Border Style="{StaticResource Pastille}" ds:Ton.Matiere="{Binding Matiere}" ds:Ton.Partie="{Binding Partie}"
                    Margin="{StaticResource Marge.Droite.8}" Padding="8,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Texte.Icone}" FontSize="{DynamicResource Taille.Meta}"
                               Text="{Binding (ds:Ton.Icone), RelativeSource={RelativeSource Self}}" Margin="{StaticResource Marge.Droite.4}" />
                    <TextBlock Text="{Binding Matiere}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <TextBlock VerticalAlignment="Center" Margin="{StaticResource Marge.Droite.8}" MaxWidth="520"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="{DynamicResource Taille.Meta}">
                <Hyperlink Command="{Binding RevoirNotionCommand}" TextDecorations="{x:Null}"
                           Foreground="{DynamicResource Pinceau.TexteSecondaire}" ToolTip="Ouvrir la section du cours">
                    <Run Text="{Binding FilCourt, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
            <Border Visibility="{Binding Motif, Converter={StaticResource VisibleSi}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PastilleNeutre}">
                        <Style.Triggers>
                            <!-- Carte ratée qui revient : ton ambre, et le texte le dit. -->
                            <DataTrigger Binding="{Binding EstUnRetour}" Value="True">
                                <Setter Property="ds:Ton.Nom" Value="Attention" />
                                <Setter Property="Background" Value="{DynamicResource Ton.Attention.Pale}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Ton.Attention.Texte}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Motif}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
            </Border>
        </WrapPanel>

        <!-- ===== La carte : un liseré aux couleurs de la matière, puis le contenu (Markdown et LaTeX). ===== -->
        <Grid Grid.Row="2" ds:Ton.Matiere="{Binding Matiere}" ds:Ton.Partie="{Binding Partie}">
            <Border Style="{StaticResource CarteSurface}" Padding="12,16,12,8" Background="{DynamicResource Pinceau.Surface}">
                <c:VueMarkdown Message="{Binding MessageRendu}" CommandeChoix="{Binding ChoisirCommand}" CommandeTouche="{Binding ToucheCommand}" />
            </Border>
            <Border Height="4" VerticalAlignment="Top" Margin="12,0" CornerRadius="0,0,4,4"
                    Background="{Binding (ds:Ton.Trait), RelativeSource={RelativeSource Self}}" />
        </Grid>

        <StackPanel Grid.Row="3">
            <!-- Réponse écrite, facultative (cartes « question »). Quand le curseur est dans la zone,
                 Espace (une fois du texte écrit) et 1-4 écrivent du texte : on révèle avec Entrée, on sort avec Échap. -->
            <v:VueSaisieMatrice DataContext="{Binding Matrice}" Margin="{StaticResource Marge.Haut.12}"
                                Visibility="{Binding DataContext.MatriceVisible, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}, Converter={StaticResource VisibleSi}}" />
            <StackPanel Margin="{StaticResource Marge.Haut.12}" Visibility="{Binding SaisieVisible, Converter={StaticResource VisibleSi}}">
                <TextBox x:Name="ZoneSaisie" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="110"
                         VerticalScrollBarVisibility="Auto" FontSize="{DynamicResource Taille.Corps}"
                         Text="{Binding ReponseSaisie, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Ta réponse (facultatif)"
                         ToolTip="Écris ta réponse si tu veux la comparer à la bonne (facultatif)"
                         PreviewKeyDown="ZoneSaisie_PreviewKeyDown" />
                <TextBlock Style="{StaticResource Texte.Meta}" Margin="{StaticResource Marge.Haut.4}"
                           Text="Facultatif : écris ta réponse pour la comparer. Tab pour écrire, Entrée pour voir la réponse, Maj+Entrée pour un saut de ligne, Échap pour sortir." />
            </StackPanel>

            <!-- Carte coriace : une proposition douce (relire, signaler, mettre de côté). -->
            <Border Margin="{StaticResource Marge.Haut.12}" Padding="14,10" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource Ton.Info.Pale}" BorderBrush="{DynamicResource Ton.Info.Trait}"
                    Visibility="{Binding CoriaceVisible, Converter={StaticResource VisibleSi}}">
                <StackPanel>
                    <TextBlock Text="{Binding CoriaceTexte}" TextWrapping="Wrap" Foreground="{DynamicResource Ton.Info.Texte}" />
                    <WrapPanel Margin="{StaticResource Marge.Haut.8}">
                        <Button Content="Relire le passage" Command="{Binding CoriaceRelireCommand}" Style="{StaticResource BoutonSecondaire}"
                                ds:Forme.Icone="{x:Static ds:Icones.Lire}" Margin="{StaticResource Marge.Droite.8}" />
                        <Button Content="Signaler" Command="{Binding CoriaceSignalerCommand}" Style="{StaticResource BoutonSecondaire}"
                                ds:Forme.Icone="{x:Static ds:Icones.Drapeau}" Margin="{StaticResource Marge.Droite.8}" />
                        <Button Content="Mettre de côté" Command="{Binding CoriaceMettreDeCoteCommand}" Style="{StaticResource BoutonSecondaire}"
                                Margin="{StaticResource Marge.Droite.8}" ToolTip="Elle ne sera plus proposée ; tu pourras la remettre dans les Statistiques." />
                        <Button Content="Plus tard" Command="{Binding CoriaceFermerCommand}" Style="{StaticResource BoutonSecondaire}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Encouragement (objectif du jour atteint). -->
            <ds:Bandeau ds:Ton.Nom="Succes" Icone="{x:Static ds:Icones.Etoile}" Texte="{Binding Bandeau}" Margin="{StaticResource Marge.Haut.12}"
                        Visibility="{Binding Bandeau, Converter={StaticResource VisibleSi}}" />
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding Consigne}" Style="{StaticResource Texte.Secondaire}" HorizontalAlignment="Center"
                   TextAlignment="Center" Margin="0,16,0,12" />

        <!-- ===== Actions : une seule rangée visible à la fois. ===== -->
        <Grid Grid.Row="5" MinHeight="64">
            <Grid Visibility="{Binding ConfirmationQuitter, Converter={StaticResource VisibleSi}, ConverterParameter=inverse}">
                <Button Content="{Binding TexteReveler}" Command="{Binding RevelerCommand}" Style="{StaticResource BoutonHeros}"
                        ds:Forme.Raccourci="Espace" HorizontalAlignment="Center" MinWidth="280"
                        Visibility="{Binding RevelerVisible, Converter={StaticResource VisibleSi}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding ContinuerVisible, Converter={StaticResource VisibleSi}}">
                    <Button Content="Revoir la notion" Command="{Binding RevoirNotionCommand}" Style="{StaticResource BoutonSecondaire}"
                            ds:Forme.Icone="{x:Static ds:Icones.Lire}" Margin="{StaticResource Marge.Droite.12}" VerticalAlignment="Center" />
                    <Button Content="Continuer" Command="{Binding ContinuerCommand}" Style="{StaticResource BoutonHeros}" ds:Forme.Raccourci="Entrée" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding NotesVisibles, Converter={StaticResource VisibleSi}}">
                    <StackPanel.Resources>
                        <Style x:Key="Delai" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource Taille.Meta}" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                        </Style>
                    </StackPanel.Resources>
                    <Button Command="{Binding RevoirNotionCommand}" Style="{StaticResource BoutonIcone}" ds:Forme.Icone="{x:Static ds:Icones.Lire}"
                            Margin="{StaticResource Marge.Droite.12}" VerticalAlignment="Center"
                            ToolTip="Revoir la notion dans le cours" AutomationProperties.Name="Revoir la notion" />
                    <Button Command="{Binding NoterCommand}" CommandParameter="1" Style="{StaticResource BoutonRate}" ds:Forme.Raccourci="1"
                            MinWidth="132" Margin="{StaticResource Marge.Droite.8}" HorizontalContentAlignment="Left"
                            Visibility="{Binding RateVisible, Converter={StaticResource VisibleSi}}" AutomationProperties.Name="Raté">
                        <StackPanel>
                            <TextBlock Text="Raté" />
                            <TextBlock Text="{Binding DelaiRate}" Style="{StaticResource Delai}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NoterCommand}" CommandParameter="2" Style="{StaticResource BoutonDifficile}" ds:Forme.Raccourci="2"
                            MinWidth="132" Margin="{StaticResource Marge.Droite.8}" HorizontalContentAlignment="Left" AutomationProperties.Name="Difficile">
                        <StackPanel>
                            <TextBlock Text="Difficile" />
                            <TextBlock Text="{Binding DelaiDifficile}" Style="{StaticResource Delai}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NoterCommand}" CommandParameter="3" Style="{StaticResource BoutonBien}" ds:Forme.Raccourci="3"
                            MinWidth="132" Margin="{StaticResource Marge.Droite.8}" HorizontalContentAlignment="Left" AutomationProperties.Name="Bien">
                        <StackPanel>
                            <TextBlock Text="Bien" />
                            <TextBlock Text="{Binding DelaiBien}" Style="{StaticResource Delai}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NoterCommand}" CommandParameter="4" Style="{StaticResource BoutonFacile}" ds:Forme.Raccourci="4"
                            MinWidth="132" HorizontalContentAlignment="Left" AutomationProperties.Name="Facile">
                        <StackPanel>
                            <TextBlock Text="Facile" />
                            <TextBlock Text="{Binding DelaiFacile}" Style="{StaticResource Delai}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Pause : confirmation douce, à la place des actions (rien ne passe au-dessus de la carte). -->
            <Border Style="{StaticResource CarteFlottante}" Padding="{StaticResource Remplissage.Compact}" HorizontalAlignment="Center"
                    Visibility="{Binding ConfirmationQuitter, Converter={StaticResource VisibleSi}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource Marge.Gauche.24}">
                        <Button Content="Arrêter là" Command="{Binding ConfirmerQuitterCommand}" Style="{StaticResource BoutonSecondaire}"
                                Margin="{StaticResource Marge.Droite.8}" />
                        <Button Content="Continuer" Command="{Binding ResterCommand}" Style="{StaticResource BoutonPrincipal}" ds:Forme.Raccourci="Échap" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Faire une pause ?" Style="{StaticResource Texte.SousTitre}" />
                        <TextBlock Text="Tes cartes déjà notées sont enregistrées. Le reste t'attendra." Style="{StaticResource Texte.Secondaire}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
