<UserControl x:Class="Revisions.App.Views.VueSession"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Revisions.App.Controles">
    <Grid Margin="28,18,28,20" MaxWidth="900">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Avancement. -->
        <DockPanel>
            <Button DockPanel.Dock="Left" Content="Arrêter" Command="{Binding ArreterCommand}" Padding="14,6"
                    ToolTip="Arrêter la session : ce qui est fait est enregistré" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Compteur}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ProgressBar Value="{Binding Avancement, Mode=OneWay}" Maximum="1" Height="6" Margin="16,0" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding Contexte}" Style="{StaticResource Discret}" Margin="0,14,0,8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

        <!-- La carte. -->
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <c:VueMarkdown Message="{Binding MessageRendu}" CommandeChoix="{Binding ChoisirCommand}" CommandeTouche="{Binding ToucheCommand}" />
        </Border>

        <!-- Encouragement (objectif du jour atteint). -->
        <Border Grid.Row="3" Style="{StaticResource Carte}" Padding="14,8" Margin="0,10,0,0"
                Visibility="{Binding Bandeau, Converter={StaticResource VisibleSi}}">
            <TextBlock Text="{Binding Bandeau}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding Consigne}" Style="{StaticResource Discret}" HorizontalAlignment="Center" Margin="0,12,0,8" />

        <!-- Actions : une seule rangée visible à la fois. -->
        <Grid Grid.Row="5" MinHeight="62">
            <Button Content="{Binding TexteReveler}" Command="{Binding RevelerCommand}" Style="{DynamicResource AccentButtonStyle}"
                    FontSize="16" Padding="40,12" HorizontalAlignment="Center"
                    Visibility="{Binding RevelerVisible, Converter={StaticResource VisibleSi}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Visibility="{Binding ContinuerVisible, Converter={StaticResource VisibleSi}}">
                <Button Content="Revoir la notion" Command="{Binding RevoirNotionCommand}" FontSize="15" Padding="22,12" Margin="0,0,12,0" />
                <Button Content="Continuer" Command="{Binding ContinuerCommand}" Style="{DynamicResource AccentButtonStyle}" FontSize="16" Padding="40,12" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Visibility="{Binding NotesVisibles, Converter={StaticResource VisibleSi}}">
                <Button Content="Revoir la notion" Command="{Binding RevoirNotionCommand}" Padding="16,10" Margin="0,0,24,0" VerticalAlignment="Center" />
                <Button Command="{Binding NoterCommand}" CommandParameter="1" Width="118" Margin="4,0" Padding="0,8"
                        Visibility="{Binding RateVisible, Converter={StaticResource VisibleSi}}">
                    <StackPanel>
                        <TextBlock Text="1 · Raté" FontSize="15" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DelaiRate}" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NoterCommand}" CommandParameter="2" Width="118" Margin="4,0" Padding="0,8">
                    <StackPanel>
                        <TextBlock Text="2 · Difficile" FontSize="15" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DelaiDifficile}" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NoterCommand}" CommandParameter="3" Width="118" Margin="4,0" Padding="0,8"
                        Style="{DynamicResource AccentButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="3 · Bien" FontSize="15" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DelaiBien}" FontSize="11" Opacity="0.8" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NoterCommand}" CommandParameter="4" Width="118" Margin="4,0" Padding="0,8">
                    <StackPanel>
                        <TextBlock Text="4 · Facile" FontSize="15" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DelaiFacile}" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
