<UserControl x:Class="Revisions.App.Views.VueTdGroupe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Revisions.App.Controles"
             xmlns:vm="clr-namespace:Revisions.App.ViewModels"
             xmlns:ds="clr-namespace:Revisions.App.Controles"
             x:Name="Racine">
    <UserControl.Resources>
        <!-- Vert (succès) pour « juste », ambre (attention) pour « à reprendre » : jamais de rouge (R1, pas de punition).
             Couleurs du système de design : contrastes vérifiés dans chaque thème. -->

        <!-- Une case de la grille (ou le champ d'un nombre). -->
        <Style x:Key="Case" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="62" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="{DynamicResource Taille.SousTitre}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="c:SaisieEntiere.Active" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Modifiable}" Value="False">
                    <Setter Property="IsReadOnly" Value="True" />
                    <Setter Property="IsTabStop" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Etat}" Value="{x:Static vm:EtatCase.Juste}">
                    <Setter Property="Background" Value="{DynamicResource Ton.Succes.Pale}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Ton.Succes.Trait}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Etat}" Value="{x:Static vm:EtatCase.AReprendre}">
                    <Setter Property="Background" Value="{DynamicResource Ton.Attention.Pale}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Ton.Attention.Trait}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Une proposition d'un choix (« 2 × 3 », « Oui »…). -->
        <Style x:Key="BoutonChoix" TargetType="Button" BasedOn="{StaticResource BoutonSecondaire}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="{StaticResource Marge.Tuile}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstChoisi}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Pinceau.AccentTrait}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Etat}" Value="{x:Static vm:EtatCase.Juste}">
                    <Setter Property="Background" Value="{DynamicResource Ton.Succes.Pale}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Ton.Succes.Trait}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Etat}" Value="{x:Static vm:EtatCase.AReprendre}">
                    <Setter Property="Background" Value="{DynamicResource Ton.Attention.Pale}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Ton.Attention.Trait}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ==== 1. Créer ou rejoindre un TD ==================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding EstChoix, Converter={StaticResource VisibleSi}}">
            <StackPanel MaxWidth="{StaticResource Largeur.Contenu}" Margin="{StaticResource Marge.Ecran}">
                <TextBlock Text="TD en groupe" Style="{StaticResource Texte.Titre}" />
                <TextBlock Style="{StaticResource Texte.Secondaire}" Margin="{StaticResource Marge.Haut.8}"
                           Text="Faites le même TD ensemble, chacun sur son PC, en vocal sur Discord. Pas de réseau ni de compte : l'un crée le TD et dicte le code, les autres le saisissent. Ça marche aussi en solo." />

                <Grid Margin="{StaticResource Marge.Haut.24}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Créer. -->
                    <Border Style="{StaticResource CarteSurface}">
                        <StackPanel>
                            <TextBlock Text="Créer un TD" Style="{StaticResource Texte.SousTitre}" />
                            <TextBlock Text="Thème" Margin="0,14,0,4" />
                            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding ThemeChoisi}" DisplayMemberPath="Nom" HorizontalAlignment="Stretch" />
                            <StackPanel Visibility="{Binding ChoixSeanceVisible, Converter={StaticResource VisibleSi}}">
                                <TextBlock Text="Séance" Margin="0,12,0,4" />
                                <ComboBox ItemsSource="{Binding Seances}" SelectedItem="{Binding SeanceChoisie}" DisplayMemberPath="Libelle" HorizontalAlignment="Stretch" />
                                <TextBlock Style="{StaticResource Texte.Meta}" Margin="2,4,0,0"
                                           Text="Ses cartes « exercice » et « QCM ». Tout le monde doit avoir le même pack." />
                            </StackPanel>
                            <Grid Margin="{StaticResource Marge.Haut.12}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Niveau" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding NiveauxDuTheme}" SelectedIndex="{Binding NiveauIndex}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Exercices" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding NombresPossibles}" SelectedItem="{Binding Nombre}" MinWidth="90" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Compte à rebours de 3 secondes avant chaque exercice" IsChecked="{Binding CompteARebours}" Style="{StaticResource Interrupteur}" Margin="{StaticResource Marge.Haut.12}" />
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Marge.Haut.8}">
                                <CheckBox Content="Minuteur indicatif :" IsChecked="{Binding MinuteurActif}" Style="{StaticResource Interrupteur}" VerticalAlignment="Center"
                                          ToolTip="Un simple repère, sans aucune conséquence quand il arrive à zéro." />
                                <ComboBox ItemsSource="{Binding MinutesPossibles}" SelectedItem="{Binding MinutesParExercice}" Margin="8,0,6,0" MinWidth="70"
                                          IsEnabled="{Binding MinuteurActif}" />
                                <TextBlock Text="min par exercice" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="Créer le TD" Command="{Binding CreerCommand}" Style="{StaticResource BoutonPrincipal}"
                                    Margin="{StaticResource Marge.Haut.16}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Rejoindre. -->
                    <Border Grid.Column="2" Style="{StaticResource CarteSurface}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Rejoindre un camarade" Style="{StaticResource Texte.SousTitre}" />
                            <TextBlock Text="Saisis le code qu'il te dicte (majuscules, minuscules et espaces : peu importe)." Style="{StaticResource Texte.Secondaire}" Margin="0,8,0,10" />
                            <TextBox x:Name="ZoneCode" Text="{Binding CodeSaisi, UpdateSourceTrigger=PropertyChanged}" FontSize="{DynamicResource Taille.Titre}"
                                     FontFamily="{DynamicResource Police.Code}" Padding="10,6" KeyDown="ZoneCode_KeyDown" />
                            <Button Content="Rejoindre" Command="{Binding RejoindreCommand}" Style="{StaticResource BoutonPrincipal}"
                                    Margin="{StaticResource Marge.Haut.12}" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource Texte.Meta}" Margin="{StaticResource Marge.Haut.16}"
                                       Text="Astuce : comparez l'empreinte (deux mots, par exemple « volcan-panda ») affichée au début. Mêmes mots = même TD pour tout le monde." />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Erreur (code mal dicté, version différente, pack manquant…). -->
                <Border Style="{StaticResource CarteSurface}" Padding="16,12" Margin="{StaticResource Marge.Haut.16}"
                        Visibility="{Binding MessageErreur, Converter={StaticResource VisibleSi}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Vérifier les mises à jour" Command="{Binding VerifierMisesAJourCommand}"
                                Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding MiseAJourConseillee, Converter={StaticResource VisibleSi}}" />
                        <TextBlock Text="{Binding MessageErreur}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==== 2. « Prêts ? » et compte à rebours ============================================== -->
        <Grid Visibility="{Binding EstPret, Converter={StaticResource VisibleSi}}">
            <Border Style="{StaticResource CarteFlottante}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="48,36" MinWidth="520">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TitreTd}" Style="{StaticResource Texte.Secondaire}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource Marge.Haut.8}">
                        <TextBlock Text="{Binding Code}" FontFamily="{DynamicResource Police.Code}" FontSize="{DynamicResource Taille.Salut}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Command="{Binding CopierCodeCommand}" Style="{StaticResource BoutonIcone}" ds:Forme.Icone="{x:Static ds:Icones.Copier}" Margin="{StaticResource Marge.Gauche.12}" VerticalAlignment="Center" ToolTip="Copier le code (pour le coller sur Discord)" AutomationProperties.Name="Copier le code" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Center" Margin="{StaticResource Marge.Haut.8}" Style="{StaticResource Texte.Secondaire}">
                        <Run Text="Empreinte :" />
                        <Run Text="{Binding Empreinte, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Pinceau.Texte}" />
                        <Run Text="(la même pour tout le monde ?)" />
                    </TextBlock>
                    <TextBlock Text="{Binding Confirmation}" HorizontalAlignment="Center" Style="{StaticResource Texte.Meta}" Margin="{StaticResource Marge.Haut.4}"
                               Visibility="{Binding Confirmation, Converter={StaticResource VisibleSi}}" />

                    <TextBlock Text="{Binding Avancement}" HorizontalAlignment="Center" Style="{StaticResource Texte.Corps}" Margin="{StaticResource Marge.Haut.24}" />
                    <TextBlock Text="{Binding TitreExercice}" HorizontalAlignment="Center" Style="{StaticResource Texte.SousTitre}" Margin="0,2,0,0" />
                    <TextBlock Text="Prêts ?" HorizontalAlignment="Center" Style="{StaticResource Texte.Salut}" Margin="{StaticResource Marge.Haut.24}" />
                    <Button Content="Go !" Command="{Binding PartirCommand}" Style="{StaticResource BoutonHeros}"
                            Margin="{StaticResource Marge.Haut.16}" HorizontalAlignment="Center" MinWidth="200" ds:Forme.Raccourci="Espace" />
                    <TextBlock Text="{Binding Consigne}" Style="{StaticResource Texte.Meta}" HorizontalAlignment="Center" Margin="{StaticResource Marge.Haut.16}" />
                    <Button Content="Quitter le TD" Command="{Binding QuitterCommand}" Style="{StaticResource BoutonFantome}" Margin="{StaticResource Marge.Haut.16}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding EstCompte, Converter={StaticResource VisibleSi}}">
            <TextBlock Text="{Binding CompteRestant}" FontSize="{DynamicResource Taille.Geante}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Pinceau.AccentTrait}" FontFamily="{DynamicResource Police.Titres}" />
        </Grid>

        <!-- ==== 3. L'exercice : « On cherche » puis « Correction » ============================== -->
        <Grid Margin="{StaticResource Marge.Ecran}" Visibility="{Binding EnExercice, Converter={StaticResource VisibleSi}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Barre du haut. -->
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Quitter" Command="{Binding QuitterCommand}" Style="{StaticResource BoutonFantome}" ds:Forme.Icone="{x:Static ds:Icones.Fermer}" Foreground="{DynamicResource Pinceau.TexteSecondaire}"
                        ToolTip="Quitter le TD : les exercices faits comptent dans ton récap" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Avancement}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Minuteur}" Style="{StaticResource Texte.Secondaire}" VerticalAlignment="Center" Margin="0,0,16,0"
                           Visibility="{Binding Minuteur, Converter={StaticResource VisibleSi}}" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,16,0" Style="{StaticResource Texte.Meta}">
                    <Run Text="{Binding Code, Mode=OneWay}" FontFamily="{DynamicResource Police.Code}" />
                    <Run Text="·" />
                    <Run Text="{Binding TitreExercice, Mode=OneWay}" />
                </TextBlock>
                <ProgressBar Style="{StaticResource BarreProgression}" Value="{Binding Progression, Mode=OneWay}" Margin="16,0" VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="{StaticResource Marge.Haut.12}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" MinWidth="300" MaxWidth="440" />
                </Grid.ColumnDefinitions>

                <!-- Énoncé, indice et correction pas à pas : Markdown + LaTeX (matrices rendues par KaTeX). -->
                <Border Style="{StaticResource CarteSurface}" Padding="8,12,8,4">
                    <c:VueMarkdown Message="{Binding MessageRendu}" />
                </Border>

                <!-- Zone de réponse : une carte par sous-question. -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Questions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CarteSurface}" Padding="16,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Texte.Corps}">
                                            <Run Text="{Binding Lettre, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Libelle, Mode=OneWay}" />
                                        </TextBlock>

                                        <!-- Grille d'une matrice (entre parenthèses) ou case d'un nombre. -->
                                        <Border HorizontalAlignment="Left" Margin="{StaticResource Marge.Haut.8}" Padding="6,2" CornerRadius="12" BorderThickness="2,0,2,0"
                                                Visibility="{Binding EstGrille, Converter={StaticResource VisibleSi}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Pinceau.TexteSecondaire}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstNombre}" Value="True">
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ItemsControl ItemsSource="{Binding Cases}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="{Binding Colonnes}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="3">
                                                            <TextBox Text="{Binding Valeur, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Case}" />
                                                            <TextBlock Text="{Binding TexteAttendu}" FontSize="{DynamicResource Taille.Meta}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource Ton.Attention.Texte}"
                                                                       Visibility="{Binding TexteAttendu, Converter={StaticResource VisibleSi}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <!-- Choix. -->
                                        <ItemsControl ItemsSource="{Binding Choix}" Margin="{StaticResource Marge.Haut.8}" Focusable="False"
                                                      Visibility="{Binding EstChoix, Converter={StaticResource VisibleSi}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding ChoisirCommand}" Style="{StaticResource BoutonChoix}">
                                                        <TextBlock TextWrapping="Wrap" MaxWidth="360">
                                                            <Run Text="{Binding Lettre, Mode=OneWay}" FontWeight="SemiBold" />
                                                            <Run Text="·" />
                                                            <Run Text="{Binding Texte, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Réponse rédigée : chacun dit lui-même s'il avait juste, une fois la correction affichée. -->
                                        <StackPanel Margin="{StaticResource Marge.Haut.8}" Visibility="{Binding EstLibre, Converter={StaticResource VisibleSi}}">
                                            <TextBlock Text="Cherche sur papier, puis compare avec la correction." Style="{StaticResource Texte.Secondaire}"
                                                       Visibility="{Binding DataContext.EstRecherche, ElementName=Racine, Converter={StaticResource VisibleSi}}" />
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding DataContext.EstCorrection, ElementName=Racine, Converter={StaticResource VisibleSi}}">
                                                <Button Content="J'avais juste" Command="{Binding AutoEvaluerCommand}" CommandParameter="oui" Margin="{StaticResource Marge.Droite.8}" />
                                                <Button Content="Pas tout à fait" Command="{Binding AutoEvaluerCommand}" CommandParameter="non" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Bilan}" Margin="{StaticResource Marge.Haut.8}" FontWeight="SemiBold"
                                                   Visibility="{Binding Bilan, Converter={StaticResource VisibleSi}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <TextBlock Grid.Row="2" Text="{Binding Consigne}" Style="{StaticResource Texte.Secondaire}" HorizontalAlignment="Center" Margin="0,12,0,8" />

            <!-- Actions : « On cherche » puis « Correction ». -->
            <Grid Grid.Row="3" MinHeight="50">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding EstRecherche, Converter={StaticResource VisibleSi}}">
                    <Button Content="Indice" Command="{Binding IndiceCommand}" ds:Forme.Icone="{x:Static ds:Icones.Ampoule}" IsEnabled="{Binding IndiceDisponible}" Margin="{StaticResource Marge.Droite.12}"
                            ToolTip="Un rappel de méthode tiré du cours (touche I hors des cases)" />
                    <Button Content="Vérifier" Command="{Binding VerifierCommand}" Style="{StaticResource BoutonPrincipal}"
                            ToolTip="Ctrl + Entrée" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding EstCorrection, Converter={StaticResource VisibleSi}}">
                    <Button Content="Revoir la notion" Command="{Binding RevoirNotionCommand}" ds:Forme.Icone="{x:Static ds:Icones.Lire}" IsEnabled="{Binding NotionDisponible}" Margin="{StaticResource Marge.Droite.12}"
                            ToolTip="La section du cours (pack de maths SQ1), dans une fenêtre à part" />
                    <Button Content="Indice" Command="{Binding IndiceCommand}" ds:Forme.Icone="{x:Static ds:Icones.Ampoule}" IsEnabled="{Binding IndiceDisponible}" Margin="{StaticResource Marge.Droite.12}" />
                    <Button Content="Tout voir" Command="{Binding ToutVoirCommand}" IsEnabled="{Binding ResteDesEtapes}" Margin="{StaticResource Marge.Droite.12}" />
                    <Button Content="Étape suivante" Command="{Binding EtapeSuivanteCommand}" IsEnabled="{Binding ResteDesEtapes}" Margin="{StaticResource Marge.Droite.12}"
                            ToolTip="Espace" />
                    <Button Content="{Binding TexteSuivant}" Command="{Binding ExerciceSuivantCommand}" IsEnabled="{Binding PeutContinuer}"
                            Style="{StaticResource BoutonPrincipal}" ToolTip="Entrée" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ==== 4. Récap personnel ============================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding EstFin, Converter={StaticResource VisibleSi}}">
            <StackPanel MaxWidth="{StaticResource Largeur.Contenu}" Margin="{StaticResource Marge.Ecran}">
                <TextBlock Text="TD terminé, bravo !" Style="{StaticResource Texte.Titre}" />
                <TextBlock Style="{StaticResource Texte.Secondaire}" Margin="{StaticResource Marge.Haut.4}">
                    <Run Text="{Binding TitreTd, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding Code, Mode=OneWay}" FontFamily="{DynamicResource Police.Code}" />
                </TextBlock>

                <Border Style="{StaticResource CarteSurface}" Margin="{StaticResource Marge.Haut.24}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Copier" Command="{Binding CopierPhraseCommand}" ds:Forme.Icone="{x:Static ds:Icones.Copier}" VerticalAlignment="Center"
                                ToolTip="Pour la coller sur Discord" />
                        <StackPanel>
                            <TextBlock Text="{Binding PhraseRecap}" Style="{StaticResource Texte.Salut}" />
                            <TextBlock Text="À dire aux autres pour comparer. Le but n'est pas de gagner : c'est de voir ce qu'on reprend ensemble." Style="{StaticResource Texte.Secondaire}" Margin="{StaticResource Marge.Haut.4}" />
                            <TextBlock Text="{Binding TexteXp}" Style="{StaticResource Texte.Corps}" Margin="{StaticResource Marge.Haut.12}" Foreground="{DynamicResource Pinceau.AccentTexte}" />
                            <TextBlock Text="{Binding Confirmation}" Style="{StaticResource Texte.Meta}" Margin="{StaticResource Marge.Haut.4}"
                                       Visibility="{Binding Confirmation, Converter={StaticResource VisibleSi}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource CarteSurface}" Margin="{StaticResource Marge.Haut.12}">
                    <ItemsControl ItemsSource="{Binding Recap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Issue}" Style="{StaticResource Texte.Secondaire}" />
                                    <TextBlock Text="{Binding Numero}" Width="30" Style="{StaticResource Texte.Secondaire}" />
                                    <TextBlock Text="{Binding Titre}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Button Content="Faire un autre TD" Command="{Binding RevenirAuChoixCommand}" Style="{StaticResource BoutonPrincipal}"
                        Margin="{StaticResource Marge.Haut.24}" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
