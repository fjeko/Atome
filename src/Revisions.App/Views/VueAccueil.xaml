<UserControl x:Class="Revisions.App.Views.VueAccueil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Revisions.App.Views"
             xmlns:ds="clr-namespace:Revisions.App.Controles">
    <!--
        Accueil (docs/design-atome.md) : calme et aéré, avec un peu de jeu.
        La mascotte dit bonjour ; une grande carte dit quoi faire aujourd'hui, avec UN gros bouton ;
        l'objectif du jour est un anneau ; les matières du jour sont des tuiles colorées.
        En dessous, discrètement : à lire, échéances, semaine et niveau. Les statistiques détaillées sont ailleurs.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="{StaticResource Largeur.Contenu}" Margin="{StaticResource Marge.Ecran}">

            <!-- La mascotte et sa bulle. -->
            <v:BandeauMascotte Taille="96" Message="{Binding MessageMascotte}" Humeur="{Binding HumeurMascotte}"
                               HorizontalAlignment="Left" Margin="{StaticResource Marge.Bas.16}" />

            <!-- Mode reprise après une pause : on l'explique, sans pression. -->
            <ds:Bandeau ds:Ton.Nom="Succes" Icone="{x:Static ds:Icones.Coeur}" Titre="On reprend en douceur"
                        Texte="Pendant quelques jours, des sessions courtes et sans nouvelle carte, le temps de retrouver le rythme."
                        Margin="{StaticResource Marge.Bas.16}"
                        Visibility="{Binding ModeReprise, Converter={StaticResource VisibleSi}}" />

            <!-- ===== Aujourd'hui : la seule décision de l'écran ===== -->
            <Border Style="{StaticResource CarteSurface}" Padding="{StaticResource Remplissage.CarteLarge}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Aujourd'hui" Style="{StaticResource Texte.Meta}" />
                        <TextBlock Text="{Binding Titre}" Style="{StaticResource Texte.Salut}" Margin="{StaticResource Marge.Haut.4}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Texte.Corps}" Foreground="{DynamicResource Pinceau.TexteSecondaire}"
                                   Margin="{StaticResource Marge.Haut.8}" />

                        <WrapPanel Margin="{StaticResource Marge.Haut.24}">
                            <Button Content="Session du jour" Command="{Binding CommencerCommand}" IsDefault="True"
                                    Style="{StaticResource BoutonHeros}" ds:Forme.Icone="{x:Static ds:Icones.Jouer}" Margin="{StaticResource Marge.Tuile}"
                                    ToolTip="Recommandée : tes cartes à revoir, puis des nouvelles cartes des cours lus"
                                    Visibility="{Binding PeutCommencer, Converter={StaticResource VisibleSi}}" />
                            <Button Content="Aller à la bibliothèque" Command="{Binding AllerBibliothequeCommand}"
                                    Style="{StaticResource BoutonHeros}" ds:Forme.Icone="{x:Static ds:Icones.Bibliotheque}" Margin="{StaticResource Marge.Tuile}"
                                    Visibility="{Binding ProposerLecture, Converter={StaticResource VisibleSi}}" />
                            <Button Content="Ouvrir mes collections" Command="{Binding AllerReglagesCommand}"
                                    Style="{StaticResource BoutonHeros}" ds:Forme.Icone="{x:Static ds:Icones.Reglages}" Margin="{StaticResource Marge.Tuile}"
                                    Visibility="{Binding CollectionsToutesMasquees, Converter={StaticResource VisibleSi}}" />
                            <Button Content="Encore 5 cartes" Command="{Binding EncoreCinqCommand}" Style="{StaticResource BoutonSecondaire}"
                                    ds:Forme.Icone="{x:Static ds:Icones.Ajouter}" Margin="{StaticResource Marge.Tuile}" VerticalAlignment="Center"
                                    ToolTip="Seulement si tu en as envie : 5 cartes de plus"
                                    Visibility="{Binding PeutContinuer, Converter={StaticResource VisibleSi}}" />
                            <Button Content="Autre révision…" Command="{Binding AutreRevisionCommand}" Style="{StaticResource BoutonSecondaire}"
                                    Margin="{StaticResource Marge.Tuile}" VerticalAlignment="Center"
                                    ToolTip="Une matière, tes points faibles, ce que tu viens de lire ou un devoir à préparer" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Objectif du jour : un anneau qui se remplit (et une coche quand il est atteint). -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource Marge.Gauche.24}"
                                ToolTip="{Binding Objectif}">
                        <ds:Anneau Width="132" Height="132" Epaisseur="10" Valeur="{Binding ObjectifProgression}"
                                   Trait="{DynamicResource Pinceau.AccentTrait}" Piste="{DynamicResource Pinceau.Voile}"
                                   AutomationProperties.Name="{Binding Objectif}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Texte.Icone}" Text="{x:Static ds:Icones.Coche}" HorizontalAlignment="Center"
                                           FontSize="{DynamicResource Taille.Titre}" Foreground="{DynamicResource Ton.Succes.Trait}"
                                           Visibility="{Binding ObjectifAtteint, Converter={StaticResource VisibleSi}}" />
                                <TextBlock Text="{Binding ObjectifCourt}" Style="{StaticResource Texte.SousTitre}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ds:Anneau>
                        <TextBlock Text="Objectif du jour" Style="{StaticResource Texte.Meta}" HorizontalAlignment="Center" Margin="{StaticResource Marge.Haut.8}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Au menu aujourd'hui : une tuile colorée par matière ===== -->
            <StackPanel Margin="{StaticResource Marge.Haut.24}" Visibility="{Binding AfficherMatieresDuJour, Converter={StaticResource VisibleSi}}">
                <TextBlock Text="Au menu aujourd'hui" Style="{StaticResource Texte.SousTitre}" />
                <ItemsControl ItemsSource="{Binding MatieresDuJour}" Margin="{StaticResource Marge.Haut.12}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border ds:Ton.Matiere="{Binding Matiere}" Style="{StaticResource EncadreTon}" CornerRadius="{StaticResource Rayon.Tuile}"
                                    Width="{StaticResource Largeur.Tuile}" Margin="{StaticResource Marge.Tuile}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Pinceau.Surface}">
                                        <TextBlock Style="{StaticResource Texte.Icone}" HorizontalAlignment="Center"
                                                   Text="{Binding (ds:Ton.Icone), RelativeSource={RelativeSource Self}}"
                                                   Foreground="{Binding (ds:Ton.Trait), RelativeSource={RelativeSource Self}}" />
                                    </Border>
                                    <StackPanel Margin="{StaticResource Marge.Gauche.12}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Matiere}" Style="{StaticResource Texte.Fort}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding Libelle}" Style="{StaticResource Texte.Meta}"
                                                   Foreground="{Binding (ds:Ton.Texte), RelativeSource={RelativeSource Self}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Planning : séances à lire et prochaines échéances (masqué sans planning suivi ni suggestion) ===== -->
            <Grid Margin="{StaticResource Marge.Haut.16}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding AfficherAuProgramme}" Value="False" />
                                    <Condition Binding="{Binding AfficherEcheances}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="{StaticResource Gouttiere}" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Visibility="{Binding AfficherAuProgramme, Converter={StaticResource VisibleSi}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CarteSurface}">
                            <Style.Triggers>
                                <!-- Seule carte de la rangée : elle prend toute la largeur. -->
                                <DataTrigger Binding="{Binding AfficherEcheances}" Value="False">
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding TitreAuProgramme}" Style="{StaticResource Texte.SousTitre}" />
                        <TextBlock Text="{Binding DetailAuProgramme}" Style="{StaticResource Texte.Secondaire}" Margin="{StaticResource Marge.Haut.4}" />
                        <ItemsControl ItemsSource="{Binding AuProgramme}" Margin="{StaticResource Marge.Haut.8}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.LireCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource BoutonListe}" Margin="-12,4,-12,0"
                                            ToolTip="Ouvrir la séance" ds:Ton.Matiere="{Binding Matiere}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="{StaticResource Marge.Droite.12}"
                                                    Background="{Binding (ds:Ton.Trait), RelativeSource={RelativeSource Self}}" />
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Texte.Icone}" Text="{x:Static ds:Icones.Chevron}"
                                                       Foreground="{DynamicResource Pinceau.TexteDiscret}" Margin="{StaticResource Marge.Gauche.8}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Seance}" Style="{StaticResource Texte.Fort}" />
                                                <TextBlock Style="{StaticResource Texte.Meta}">
                                                    <Run Text="{Binding Matiere, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Raison, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Visibility="{Binding AfficherEcheances, Converter={StaticResource VisibleSi}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CarteSurface}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AfficherAuProgramme}" Value="False">
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Prochaines échéances" Style="{StaticResource Texte.SousTitre}" />
                        <TextBlock Text="Proposition du CNED, pour te repérer." Style="{StaticResource Texte.Secondaire}" Margin="{StaticResource Marge.Haut.4}" />
                        <ItemsControl ItemsSource="{Binding Echeances}" Margin="{StaticResource Marge.Haut.8}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="{StaticResource Marge.Haut.8}">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Texte.Icone}" Text="{x:Static ds:Icones.Calendrier}"
                                                   Foreground="{DynamicResource Pinceau.TexteDiscret}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource Texte.Base}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Voir le planning" Command="{Binding AllerPlanningCommand}" Style="{StaticResource BoutonFantome}"
                                ds:Forme.Icone="{x:Static ds:Icones.Suivant}" HorizontalAlignment="Left" Margin="-10,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Semaine et progression : discrets ===== -->
            <Grid Margin="{StaticResource Marge.Haut.16}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource Gouttiere}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CarteSurface}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SerieTexte}" Style="{StaticResource Texte.Fort}" VerticalAlignment="Center" />
                            <TextBlock Text="Cette semaine" Style="{StaticResource Texte.SousTitre}" />
                        </DockPanel>
                        <v:Semaine Jours="{Binding Semaine}" Margin="{StaticResource Marge.Haut.16}" />
                        <TextBlock Text="{Binding SerieDetail}" Style="{StaticResource Texte.Meta}" Margin="{StaticResource Marge.Haut.12}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CarteSurface}">
                    <StackPanel>
                        <TextBlock Text="Progression" Style="{StaticResource Texte.SousTitre}" />
                        <v:CompteurXp Niveau="{Binding Niveau}" Progression="{Binding ProgressionNiveau}" Texte="{Binding Xp}"
                                      Margin="{StaticResource Marge.Haut.16}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
