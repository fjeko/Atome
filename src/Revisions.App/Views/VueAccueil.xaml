<UserControl x:Class="Revisions.App.Views.VueAccueil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Revisions.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="940" Margin="32,32,32,28">

            <!-- La mascotte et sa bulle, centrées en haut. -->
            <v:BandeauMascotte Taille="112" Message="{Binding MessageMascotte}" Expression="{Binding ExpressionMascotte}"
                               HorizontalAlignment="Center" Margin="0,0,0,18" />

            <!-- La seule décision de l'écran : commencer. -->
            <Border Style="{StaticResource Carte}" Padding="40,36">
                <StackPanel>
                    <TextBlock Text="{Binding Titre}" Style="{StaticResource Titre}" FontSize="36" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Discret}" FontSize="18" Margin="0,10,0,0" />
                    <Button Content="Commencer" Command="{Binding CommencerCommand}" IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}" FontSize="19" Padding="52,15" Margin="0,28,0,0"
                            HorizontalAlignment="Left"
                            Visibility="{Binding PeutCommencer, Converter={StaticResource VisibleSi}}" />
                    <Button Content="Aller à la bibliothèque" Command="{Binding AllerBibliothequeCommand}"
                            FontSize="15" Padding="24,10" Margin="0,22,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding ProposerLecture, Converter={StaticResource VisibleSi}}" />
                    <Button Content="Encore 5 cartes" Command="{Binding EncoreCinqCommand}"
                            Padding="18,8" Margin="0,22,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding PeutContinuer, Converter={StaticResource VisibleSi}}" />
                    <TextBlock Text="{Binding Objectif}" Style="{StaticResource Discret}" FontSize="14" Margin="0,22,0,0" />
                </StackPanel>
            </Border>

            <!-- Planning du CNED : séances à lire et prochaines échéances (masqué sans planning suivi). -->
            <Grid Margin="0,18,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding AfficherAuProgramme}" Value="False" />
                                    <Condition Binding="{Binding AfficherEcheances}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Carte}" Visibility="{Binding AfficherAuProgramme, Converter={StaticResource VisibleSi}}">
                    <StackPanel>
                        <TextBlock Text="Au programme" Style="{StaticResource SousTitre}" />
                        <TextBlock Text="Des séances à lire quand tu veux : leurs cartes arriveront ensuite." Style="{StaticResource Discret}"
                                   TextWrapping="Wrap" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding AuProgramme}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.LireCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="12,8" Margin="0,6,0,0" ToolTip="Ouvrir la séance">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Seance}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource Discret}" TextWrapping="Wrap" FontSize="13">
                                                <Run Text="{Binding Matiere, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Raison, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Carte}" Visibility="{Binding AfficherEcheances, Converter={StaticResource VisibleSi}}">
                    <StackPanel>
                        <TextBlock Text="Prochaines échéances" Style="{StaticResource SousTitre}" />
                        <TextBlock Text="Proposition du CNED, pour te repérer." Style="{StaticResource Discret}" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding Echeances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Voir le planning" Command="{Binding AllerPlanningCommand}" Padding="14,6" Margin="0,14,0,0"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Semaine et série. -->
                <Border Style="{StaticResource Carte}">
                    <StackPanel>
                        <TextBlock Text="Cette semaine" Style="{StaticResource SousTitre}" />
                        <ItemsControl ItemsSource="{Binding Semaine}" Margin="0,14,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,14,0">
                                        <Grid Width="34" Height="34">
                                            <Ellipse Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1.5" />
                                            <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                     Visibility="{Binding Actif, Converter={StaticResource VisibleSi}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Lettre}" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstAujourdhui}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SerieTexte}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SerieDetail}" Style="{StaticResource Discret}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- XP et niveau. -->
                <Border Grid.Column="2" Style="{StaticResource Carte}">
                    <StackPanel>
                        <TextBlock Text="Progression" Style="{StaticResource SousTitre}" />
                        <TextBlock Margin="0,16,0,12" FontSize="32" FontWeight="SemiBold">
                            <Run Text="Niveau" /> <Run Text="{Binding Niveau, Mode=OneWay}" />
                        </TextBlock>
                        <ProgressBar Value="{Binding ProgressionNiveau, Mode=OneWay}" Maximum="1" Height="10" />
                        <TextBlock Text="{Binding Xp}" Style="{StaticResource Discret}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="Atome : tes révisions, at home." Style="{StaticResource Discret}" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,22,0,0" Opacity="0.7" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
