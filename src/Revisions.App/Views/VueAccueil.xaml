<UserControl x:Class="Revisions.App.Views.VueAccueil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="940" Margin="32,32,32,28">

            <!-- La seule décision de l'écran : commencer. -->
            <Border Style="{StaticResource Carte}" Padding="40,36">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#40E8A33C" Offset="0" />
                        <GradientStop Color="#18F0C8A0" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="{Binding Titre}" Style="{StaticResource Titre}" FontSize="36" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Discret}" FontSize="18" Margin="0,10,0,0" />
                    <Button Content="Commencer" Command="{Binding CommencerCommand}" IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}" FontSize="19" Padding="52,15" Margin="0,28,0,0"
                            HorizontalAlignment="Left"
                            Visibility="{Binding PeutCommencer, Converter={StaticResource VisibleSi}}" />
                    <Button Content="Aller à la bibliothèque" Command="{Binding AllerBibliothequeCommand}"
                            FontSize="15" Padding="24,10" Margin="0,22,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding ProposerLecture, Converter={StaticResource VisibleSi}}" />
                    <Button Content="Encore 5 cartes" Command="{Binding EncoreCinqCommand}"
                            Padding="18,8" Margin="0,22,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding PeutContinuer, Converter={StaticResource VisibleSi}}" />
                    <TextBlock Text="{Binding Objectif}" Style="{StaticResource Discret}" FontSize="14" Margin="0,22,0,0" />
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Semaine et série. -->
                <Border Style="{StaticResource Carte}">
                    <StackPanel>
                        <TextBlock Text="Cette semaine" Style="{StaticResource SousTitre}" />
                        <ItemsControl ItemsSource="{Binding Semaine}" Margin="0,14,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,14,0">
                                        <Grid Width="34" Height="34">
                                            <Ellipse Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1.5" />
                                            <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                     Visibility="{Binding Actif, Converter={StaticResource VisibleSi}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Lettre}" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstAujourdhui}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SerieTexte}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SerieDetail}" Style="{StaticResource Discret}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- XP et niveau. -->
                <Border Grid.Column="2" Style="{StaticResource Carte}">
                    <StackPanel>
                        <TextBlock Text="Progression" Style="{StaticResource SousTitre}" />
                        <TextBlock Margin="0,16,0,12" FontSize="32" FontWeight="SemiBold">
                            <Run Text="Niveau" /> <Run Text="{Binding Niveau, Mode=OneWay}" />
                        </TextBlock>
                        <ProgressBar Value="{Binding ProgressionNiveau, Mode=OneWay}" Maximum="1" Height="10" />
                        <TextBlock Text="{Binding Xp}" Style="{StaticResource Discret}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
