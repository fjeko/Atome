<UserControl x:Class="Revisions.App.Views.VueCalculatrice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ds="clr-namespace:Revisions.App.Controles"
             x:Name="Racine" Focusable="False">
    <!--
        Calculatrice : une petite fenêtre flottante posée par-dessus l'exercice (on la déplace en tirant son titre).
        Deux onglets : « Calcul » (une ligne, un résultat) et « Matrices » (définir A, B, C…).
        Au clavier : Entrée calcule, ↑ ↓ parcourent l'historique, Échap ferme (Ctrl + K ouvre ou ferme).
        Toute la logique est dans CalculatriceViewModel ; ce fichier ne contient que l'apparence.
    -->
    <UserControl.Resources>
        <!-- Une case de l'éditeur de matrice : gabarit simple (celui du thème Fluent ajoute un bouton « × » qui mange la case). -->
        <Style x:Key="CaseMatrice" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="{StaticResource Hauteur.CaseNombre}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="{StaticResource Remplissage.CaseNombre}" />
            <Setter Property="FontSize" Value="{DynamicResource Taille.Interface}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Pinceau.Texte}" />
            <Setter Property="Background" Value="{DynamicResource Pinceau.Controle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pinceau.Bordure}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Cadre" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Rayon.Controle}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{DynamicResource Pinceau.Accent}" />
                                <Setter TargetName="Cadre" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Width="{StaticResource Largeur.Calculatrice}" Style="{StaticResource CarteFlottante}" Padding="0"
            AutomationProperties.Name="Calculatrice">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Deplacement" />
        </Border.RenderTransform>
        <DockPanel>

            <!-- ===== Titre (on tire ici pour déplacer la fenêtre) + fermer ===== -->
            <Border x:Name="Titre" DockPanel.Dock="Top" Padding="16,8,8,0" Background="Transparent" Cursor="SizeAll"
                    ToolTip="Tire ici pour déplacer. Entrée : calculer · ↑ ↓ : historique · Échap : fermer · Ctrl + K : ouvrir ou fermer">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BoutonIcone}" ds:Forme.Icone="{x:Static ds:Icones.Fermer}"
                            Command="{Binding FermerCommand}" ToolTip="Fermer (Échap)" AutomationProperties.Name="Fermer la calculatrice" />
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource BoutonIcone}" ds:Forme.Icone="{x:Static ds:Icones.Ampoule}"
                                  IsChecked="{Binding AideOuverte, Mode=OneWay}" Command="{Binding BasculerAideCommand}"
                                  ToolTip="Aide : comment taper les calculs" AutomationProperties.Name="Aide de la calculatrice" />
                    <TextBlock Text="{x:Static ds:Icones.Calculatrice}" Style="{StaticResource Texte.Icone}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Pinceau.AccentTexte}" Margin="{StaticResource Marge.Droite.8}" />
                    <TextBlock Text="Calculatrice" Style="{StaticResource Texte.Fort}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- ===== Aide : s'affiche à la place de la calculatrice quand on clique sur l'ampoule ===== -->
            <DockPanel DockPanel.Dock="Top" Visibility="{Binding AideOuverte, Converter={StaticResource VisibleSi}}">
            <!-- Bouton toujours visible, en haut : pas besoin de faire défiler l'aide pour revenir. -->
            <Button DockPanel.Dock="Top" Content="Retour à la calculatrice" Style="{StaticResource BoutonPrincipal}" Command="{Binding BasculerAideCommand}"
                    ds:Forme.Icone="{x:Static ds:Icones.Retour}" Margin="16,4,16,8" HorizontalAlignment="Stretch" />
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="16,0,16,16" Focusable="False">
                <StackPanel>
                    <TextBlock Text="Comment taper tes calculs" Style="{StaticResource Texte.SousTitre}" />
                    <ItemsControl ItemsSource="{Binding LignesAide}" Focusable="False" Margin="{StaticResource Marge.Haut.8}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <TextBlock Text="{Binding Titre}" Style="{StaticResource Texte.Fort}" Margin="0,10,0,0"
                                               Foreground="{DynamicResource Pinceau.AccentTexte}"
                                               Visibility="{Binding Titre, Converter={StaticResource VisibleSi}}" />
                                    <StackPanel Visibility="{Binding Code, Converter={StaticResource VisibleSi}}">
                                        <TextBlock Text="{Binding Code}" FontFamily="{DynamicResource Police.Code}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Sens}" Style="{StaticResource Texte.Secondaire}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            </DockPanel>



            <StackPanel Margin="16,4,16,16" Visibility="{Binding AideOuverte, Converter={StaticResource VisibleSi}, ConverterParameter=inverse}">

                <!-- Calculatrice grisée : l'exercice demande justement de calculer à la main. -->
                <Border Style="{StaticResource CarteSurface}" Margin="{StaticResource Marge.Bas.12}"
                        Background="{DynamicResource Ton.Attention.Pale}" BorderBrush="{DynamicResource Ton.Attention.Trait}"
                        Visibility="{Binding Desactivee, Converter={StaticResource VisibleSi}}">
                    <DockPanel>
                        <TextBlock Text="{x:Static ds:Icones.Attention}" Style="{StaticResource Texte.Icone}" Foreground="{DynamicResource Ton.Attention.Texte}"
                                   DockPanel.Dock="Left" VerticalAlignment="Top" Margin="{StaticResource Marge.Droite.12}" />
                        <TextBlock Text="{Binding Raison}" TextWrapping="Wrap" Foreground="{DynamicResource Ton.Attention.Texte}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </Border>

                <!-- Tout le reste est grisé (et inutilisable) quand la calculatrice est désactivée. -->
                <StackPanel IsEnabled="{Binding Active}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Active}" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Deux onglets, rien d'autre au premier regard. -->
                    <UniformGrid Columns="2" Margin="{StaticResource Marge.Bas.12}">
                        <ToggleButton Content="Calcul" Style="{StaticResource BoutonBascule}" IsChecked="{Binding OngletCalcul}" Margin="0,0,4,0" />
                        <ToggleButton Content="Matrices" Style="{StaticResource BoutonBascule}" IsChecked="{Binding EditeurOuvert}" Margin="4,0,0,0"
                                      ToolTip="Définir les matrices A, B, C… pour les utiliser dans un calcul" />
                    </UniformGrid>

                    <!-- ================= Onglet « Calcul » ================= -->
                    <StackPanel Visibility="{Binding EditeurOuvert, Converter={StaticResource VisibleSi}, ConverterParameter=inverse}">
                        <TextBox x:Name="SaisieBox" Text="{Binding Saisie, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{DynamicResource Police.Code}" FontSize="{DynamicResource Taille.SousTitre}" MinHeight="44"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Ton calcul" AutomationProperties.HelpText="Par exemple 1/3+1/6 ou A*B. Entrée pour calculer."
                                 ToolTip="Entrée pour calculer. Ex. : 1/3+1/6   2(3+4)   sqrt(16)   A*B   A^-1   det(A)   A^T   I3   Ans" />
                        <TextBlock Style="{StaticResource Texte.Meta}" Margin="{StaticResource Marge.Haut.4}" TextWrapping="Wrap"
                                   Text="Entrée pour calculer. Ex. : 1/3+1/6, A*B, det(A), Ans" />

                        <!-- Erreur expliquée en français (ambre, jamais rouge : le ton reste doux). -->
                        <Border Margin="{StaticResource Marge.Haut.8}" Padding="12,8" CornerRadius="{StaticResource Rayon.Controle}"
                                Background="{DynamicResource Ton.Attention.Pale}" BorderBrush="{DynamicResource Ton.Attention.Trait}" BorderThickness="1"
                                Visibility="{Binding Erreur, Converter={StaticResource VisibleSi}}">
                            <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" Foreground="{DynamicResource Ton.Attention.Texte}"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </Border>

                        <!-- Résultat : n'apparaît qu'après un calcul. -->
                        <StackPanel Margin="{StaticResource Marge.Haut.12}" Visibility="{Binding APasDeResultat, Converter={StaticResource VisibleSi}, ConverterParameter=inverse}">
                            <TextBlock Text="{Binding ResultatTexte}" Style="{StaticResource Texte.Titre}" TextWrapping="Wrap"
                                       FontFamily="{DynamicResource Police.Code}" Visibility="{Binding ResultatEstNombre, Converter={StaticResource VisibleSi}}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="valeur approchée" Style="{StaticResource Texte.Meta}"
                                       Visibility="{Binding ResultatApproche, Converter={StaticResource VisibleSi}}" />

                            <Border HorizontalAlignment="Left" Padding="8,4" CornerRadius="12" BorderThickness="2,0,2,0" BorderBrush="{DynamicResource Pinceau.Texte}"
                                    Visibility="{Binding ResultatEstMatrice, Converter={StaticResource VisibleSi}}">
                                <ItemsControl ItemsSource="{Binding ResultatCases}" Focusable="False" AutomationProperties.Name="Matrice résultat">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding DataContext.ResultatColonnes, ElementName=Racine}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextAlignment="Center" Margin="10,4" MinWidth="28"
                                                       FontFamily="{DynamicResource Police.Code}" FontSize="{DynamicResource Taille.SousTitre}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <DockPanel Margin="{StaticResource Marge.Haut.12}">
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource BoutonBascule}" IsChecked="{Binding ModeDecimal}"
                                              Content="Décimal" Padding="10,4" ToolTip="Fractions exactes ou valeurs décimales (avec la virgule)"
                                              AutomationProperties.Name="Afficher en valeur décimale" />
                                <Button Content="Copier dans la réponse" Style="{StaticResource BoutonSecondaire}" Command="{Binding CopierDansReponseCommand}"
                                        ds:Forme.Icone="{x:Static ds:Icones.Copier}" HorizontalAlignment="Left" Padding="10,4"
                                        Visibility="{Binding PeutCopier, Converter={StaticResource VisibleSi}}"
                                        ToolTip="Remplit la grille de réponse de l'exercice avec ce résultat (si les tailles correspondent)" />
                            </DockPanel>
                            <TextBlock Text="{Binding Retour}" Style="{StaticResource Texte.Secondaire}" TextWrapping="Wrap" Margin="{StaticResource Marge.Haut.8}"
                                       Visibility="{Binding Retour, Converter={StaticResource VisibleSi}}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>

                        <!-- Historique : replié, à ouvrir si besoin. Un clic remet le calcul dans la ligne. -->
                        <Expander Header="Historique" Margin="{StaticResource Marge.Haut.12}"
                                  Visibility="{Binding Historique.Count, Converter={StaticResource VisibleSi}}">
                            <StackPanel>
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <ItemsControl ItemsSource="{Binding Historique}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource BoutonListe}" HorizontalContentAlignment="Stretch" Padding="8,4"
                                                        Command="{Binding DataContext.ReprendreCommand, ElementName=Racine}" CommandParameter="{Binding}"
                                                        ToolTip="Remettre ce calcul dans la ligne de saisie">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Expression}" FontFamily="{DynamicResource Police.Code}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Resume}" Style="{StaticResource Texte.Secondaire}" TextWrapping="Wrap"
                                                                   FontFamily="{DynamicResource Police.Code}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button Content="Effacer l'historique" Style="{StaticResource BoutonFantome}" Command="{Binding ViderHistoriqueCommand}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- ================= Onglet « Matrices » ================= -->
                    <StackPanel Visibility="{Binding EditeurOuvert, Converter={StaticResource VisibleSi}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Noms}" SelectedValuePath="Nom" SelectedValue="{Binding NomEdite}" DisplayMemberPath="Etiquette"
                                      AutomationProperties.Name="Nom de la matrice" ToolTip="Nom de la matrice à définir" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Tailles}" SelectedItem="{Binding LignesEditeur}" MinWidth="56"
                                      AutomationProperties.Name="Nombre de lignes" ToolTip="Nombre de lignes (1 à 5)" />
                            <TextBlock Grid.Column="3" Text="×" Margin="8,0" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="4" ItemsSource="{Binding Tailles}" SelectedItem="{Binding ColonnesEditeur}" MinWidth="56"
                                      AutomationProperties.Name="Nombre de colonnes" ToolTip="Nombre de colonnes (1 à 5)" />
                        </Grid>

                        <!-- La grille : Entrée dans une case enregistre. -->
                        <Border HorizontalAlignment="Stretch" Padding="6,4" CornerRadius="12" BorderThickness="2,0,2,0"
                                BorderBrush="{DynamicResource Pinceau.Texte}" Margin="{StaticResource Marge.Haut.12}">
                            <ItemsControl ItemsSource="{Binding Cellules}" Focusable="False" AutomationProperties.Name="Grille de la matrice">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding DataContext.ColonnesGrille, ElementName=Racine}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CaseMatrice}" Tag="cellule" Text="{Binding Texte, UpdateSourceTrigger=PropertyChanged}"
                                                 GotKeyboardFocus="CaseFocus" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Marge.Haut.12}">
                            <Button Content="Enregistrer" Style="{StaticResource BoutonPrincipal}" Command="{Binding EnregistrerCommand}"
                                    ToolTip="Garde la matrice pour tes calculs (Entrée dans une case fait pareil)" />
                            <Button Content="Supprimer" Style="{StaticResource BoutonFantome}" Command="{Binding SupprimerCommand}"
                                    Margin="{StaticResource Marge.Gauche.8}" />
                        </StackPanel>
                        <TextBlock Text="{Binding MessageEditeur}" TextWrapping="Wrap" Margin="{StaticResource Marge.Haut.8}"
                                   Visibility="{Binding MessageEditeur, Converter={StaticResource VisibleSi}}" AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Texte.Secondaire}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErreurEditeur}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Ton.Attention.Texte}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Cases : 3, -1/2 ou 0,25 · Taille de 1×1 à 5×5" Style="{StaticResource Texte.Meta}" Margin="{StaticResource Marge.Haut.8}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
