<UserControl x:Class="Revisions.App.Views.VueCalculatrice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ds="clr-namespace:Revisions.App.Controles"
             x:Name="Racine" Focusable="False">
    <!--
        Calculatrice en panneau latéral : elle se pose à droite de l'exercice sans le masquer.
        Tout se fait au clavier : Entrée calcule, ↑ ↓ parcourent l'historique, Échap ferme (Ctrl + K ouvre ou ferme).
        Toute la logique est dans CalculatriceViewModel ; ce fichier ne contient que l'apparence.
    -->
    <UserControl.Resources>
        <!-- Une case de l'éditeur de matrice : gabarit simple (celui du thème Fluent ajoute un bouton « × » qui mange la case). -->
        <Style x:Key="CaseMatrice" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="{StaticResource Hauteur.CaseNombre}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="{StaticResource Remplissage.CaseNombre}" />
            <Setter Property="FontSize" Value="{DynamicResource Taille.Interface}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Pinceau.Texte}" />
            <Setter Property="Background" Value="{DynamicResource Pinceau.Controle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pinceau.Bordure}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Cadre" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Rayon.Controle}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{DynamicResource Pinceau.Accent}" />
                                <Setter TargetName="Cadre" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Petite touche d'aide à la saisie (Ans, ^-1, det(…) : elle insère du texte dans la ligne de calcul. -->
        <Style x:Key="Touche" TargetType="Button" BasedOn="{StaticResource BoutonSecondaire}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="FontFamily" Value="{DynamicResource Police.Code}" />
        </Style>
    </UserControl.Resources>

    <Border Width="{StaticResource Largeur.Calculatrice}" Background="{DynamicResource Pinceau.Surface}"
            BorderBrush="{DynamicResource Pinceau.Bordure}" BorderThickness="1,0,0,0"
            AutomationProperties.Name="Calculatrice">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="{StaticResource Remplissage.CarteLarge}">

                <!-- ===== En-tête ===== -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BoutonIcone}" ds:Forme.Icone="{x:Static ds:Icones.Fermer}"
                            Command="{Binding FermerCommand}" ToolTip="Fermer la calculatrice (Échap)"
                            AutomationProperties.Name="Fermer la calculatrice" />
                    <TextBlock Text="Calculatrice" Style="{StaticResource Texte.SousTitre}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource Texte.Meta}" Margin="{StaticResource Marge.Haut.4}" TextWrapping="Wrap"
                           Text="Entrée : calculer · ↑ ↓ : historique · Échap : fermer · Ctrl + K : ouvrir ou fermer" />

                <!-- Calculatrice grisée : l'exercice demande justement de calculer à la main. -->
                <Border Style="{StaticResource CarteSurface}" Margin="{StaticResource Marge.Haut.12}"
                        Background="{DynamicResource Ton.Attention.Pale}" BorderBrush="{DynamicResource Ton.Attention.Trait}"
                        Visibility="{Binding Desactivee, Converter={StaticResource VisibleSi}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ds:Icones.Attention}" Style="{StaticResource Texte.Icone}" Foreground="{DynamicResource Ton.Attention.Texte}"
                                   VerticalAlignment="Top" Margin="{StaticResource Marge.Droite.12}" />
                        <TextBlock Text="{Binding Raison}" TextWrapping="Wrap" MaxWidth="290" Foreground="{DynamicResource Ton.Attention.Texte}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <!-- Tout le reste est grisé (et inutilisable) quand la calculatrice est désactivée. -->
                <StackPanel IsEnabled="{Binding Active}" Margin="{StaticResource Marge.Haut.12}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Active}" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- ===== Ligne de calcul ===== -->
                    <TextBlock Text="Ton calcul" Style="{StaticResource Texte.Meta}" />
                    <TextBox x:Name="SaisieBox" Text="{Binding Saisie, UpdateSourceTrigger=PropertyChanged}"
                             Margin="{StaticResource Marge.Haut.4}" FontFamily="{DynamicResource Police.Code}"
                             FontSize="{DynamicResource Taille.SousTitre}" MinHeight="44" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Ton calcul" AutomationProperties.HelpText="Par exemple 1/3+1/6 ou det(A). Entrée pour calculer."
                             ToolTip="Ex. : 1/3+1/6   2(3+4)   sqrt(16)   A*B   A^-1   det(A)   A^T   I3" />

                    <!-- Erreur expliquée en français (ambre, jamais rouge : le ton reste doux). -->
                    <Border Margin="{StaticResource Marge.Haut.8}" Padding="12,8" CornerRadius="{StaticResource Rayon.Controle}"
                            Background="{DynamicResource Ton.Attention.Pale}" BorderBrush="{DynamicResource Ton.Attention.Trait}" BorderThickness="1"
                            Visibility="{Binding Erreur, Converter={StaticResource VisibleSi}}">
                        <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" Foreground="{DynamicResource Ton.Attention.Texte}"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </Border>

                    <!-- Touches d'aide : elles écrivent dans la ligne de calcul à l'endroit du curseur. -->
                    <WrapPanel Margin="{StaticResource Marge.Haut.8}">
                        <Button Style="{StaticResource Touche}" Content="Ans" Tag="Ans" Click="Inserer" ToolTip="Le dernier résultat" AutomationProperties.Name="Dernier résultat (Ans)" />
                        <Button Style="{StaticResource Touche}" Content="^-1" Tag="^-1" Click="Inserer" ToolTip="Inverse d'une matrice : A^-1" AutomationProperties.Name="Inverse" />
                        <Button Style="{StaticResource Touche}" Content="^T" Tag="^T" Click="Inserer" ToolTip="Transposée : A^T" AutomationProperties.Name="Transposée" />
                        <Button Style="{StaticResource Touche}" Content="det(" Tag="det(" Click="Inserer" ToolTip="Déterminant : det(A)" AutomationProperties.Name="Déterminant" />
                        <Button Style="{StaticResource Touche}" Content="sqrt(" Tag="sqrt(" Click="Inserer" ToolTip="Racine carrée" AutomationProperties.Name="Racine carrée" />
                        <Button Style="{StaticResource Touche}" Content="pi" Tag="pi" Click="Inserer" ToolTip="Le nombre pi" AutomationProperties.Name="Pi" />
                        <Button Style="{StaticResource Touche}" Content="I3" Tag="I3" Click="Inserer" ToolTip="Matrice identité 3×3 (I2, I4…)" AutomationProperties.Name="Matrice identité" />
                    </WrapPanel>
                    <Button Content="Calculer" Style="{StaticResource BoutonPrincipal}" Command="{Binding CalculerCommand}" HorizontalAlignment="Stretch"
                            ToolTip="Entrée" />

                    <!-- ===== Résultat ===== -->
                    <Border Style="{StaticResource CarteSurface}" Margin="{StaticResource Marge.Haut.16}" Background="{DynamicResource Pinceau.Surelevee}">
                        <StackPanel>
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource BoutonBascule}" IsChecked="{Binding ModeDecimal}"
                                              Content="Décimal" Padding="10,4" ToolTip="Passer des fractions exactes aux valeurs décimales (avec la virgule), et inversement"
                                              AutomationProperties.Name="Afficher en valeur décimale" />
                                <TextBlock Text="Résultat" Style="{StaticResource Texte.Meta}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="Fais un calcul : 1/3+1/6 donne 1/2." Style="{StaticResource Texte.Secondaire}" TextWrapping="Wrap"
                                       Margin="{StaticResource Marge.Haut.8}" Visibility="{Binding APasDeResultat, Converter={StaticResource VisibleSi}}" />
                            <TextBlock Text="{Binding ResultatTexte}" Style="{StaticResource Texte.Titre}" TextWrapping="Wrap"
                                       Margin="{StaticResource Marge.Haut.8}" FontFamily="{DynamicResource Police.Code}"
                                       Visibility="{Binding ResultatEstNombre, Converter={StaticResource VisibleSi}}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="Valeur approchée (arrondie à 10 chiffres)" Style="{StaticResource Texte.Meta}"
                                       Visibility="{Binding ResultatApproche, Converter={StaticResource VisibleSi}}" />

                            <!-- Résultat matriciel : une grille entre parenthèses, en fractions exactes. -->
                            <StackPanel Visibility="{Binding ResultatEstMatrice, Converter={StaticResource VisibleSi}}" Margin="{StaticResource Marge.Haut.8}">
                                <TextBlock Text="{Binding ResultatTaille}" Style="{StaticResource Texte.Meta}" />
                                <Border HorizontalAlignment="Left" Padding="8,4" CornerRadius="12" BorderThickness="2,0,2,0"
                                        BorderBrush="{DynamicResource Pinceau.Texte}" Margin="{StaticResource Marge.Haut.4}">
                                    <ItemsControl ItemsSource="{Binding ResultatCases}" Focusable="False" AutomationProperties.Name="Matrice résultat">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding DataContext.ResultatColonnes, ElementName=Racine}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextAlignment="Center" Margin="10,4" MinWidth="28"
                                                           FontFamily="{DynamicResource Police.Code}" FontSize="{DynamicResource Taille.SousTitre}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <Button Content="Copier dans la réponse" Style="{StaticResource BoutonSecondaire}" Command="{Binding CopierDansReponseCommand}"
                                    ds:Forme.Icone="{x:Static ds:Icones.Copier}" HorizontalAlignment="Left" Margin="{StaticResource Marge.Haut.12}"
                                    Visibility="{Binding PeutCopier, Converter={StaticResource VisibleSi}}"
                                    ToolTip="Remplit la grille de réponse de l'exercice avec ce résultat (si les tailles correspondent)" />
                            <TextBlock Text="{Binding Retour}" Style="{StaticResource Texte.Secondaire}" TextWrapping="Wrap" Margin="{StaticResource Marge.Haut.8}"
                                       Visibility="{Binding Retour, Converter={StaticResource VisibleSi}}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>

                    <!-- ===== Matrices ===== -->
                    <Expander Header="Matrices (A, B, C…)" IsExpanded="{Binding EditeurOuvert, Mode=TwoWay}" Margin="{StaticResource Marge.Haut.16}"
                              AutomationProperties.Name="Éditeur de matrices">
                        <StackPanel Margin="{StaticResource Marge.Haut.8}">
                            <TextBlock Text="Choisis un nom et une taille (de 1×1 à 5×5), remplis la grille, puis enregistre. Les cases acceptent 3, -1/2 ou 0,25."
                                       Style="{StaticResource Texte.Secondaire}" TextWrapping="Wrap" />
                            <Grid Margin="{StaticResource Marge.Haut.12}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Noms}" SelectedValuePath="Nom" SelectedValue="{Binding NomEdite}" DisplayMemberPath="Etiquette"
                                          AutomationProperties.Name="Nom de la matrice" ToolTip="Nom de la matrice à définir" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Tailles}" SelectedItem="{Binding LignesEditeur}" MinWidth="56"
                                          AutomationProperties.Name="Nombre de lignes" ToolTip="Nombre de lignes" />
                                <TextBlock Grid.Column="3" Text="×" Margin="8,0" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="4" ItemsSource="{Binding Tailles}" SelectedItem="{Binding ColonnesEditeur}" MinWidth="56"
                                          AutomationProperties.Name="Nombre de colonnes" ToolTip="Nombre de colonnes" />
                            </Grid>

                            <!-- La grille : Entrée dans une case enregistre. -->
                            <Border HorizontalAlignment="Stretch" Padding="6,4" CornerRadius="12" BorderThickness="2,0,2,0"
                                    BorderBrush="{DynamicResource Pinceau.Texte}" Margin="{StaticResource Marge.Haut.12}">
                                <ItemsControl ItemsSource="{Binding Cellules}" Focusable="False" AutomationProperties.Name="Grille de la matrice">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding DataContext.ColonnesGrille, ElementName=Racine}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource CaseMatrice}" Tag="cellule" Text="{Binding Texte, UpdateSourceTrigger=PropertyChanged}"
                                                     GotKeyboardFocus="CaseFocus" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Marge.Haut.12}">
                                <Button Content="Enregistrer" Style="{StaticResource BoutonPrincipal}" Command="{Binding EnregistrerCommand}"
                                        ToolTip="Garde la matrice pour tes calculs (Entrée dans une case fait pareil)" />
                                <Button Content="Supprimer" Style="{StaticResource BoutonSecondaire}" Command="{Binding SupprimerCommand}"
                                        Margin="{StaticResource Marge.Gauche.8}" />
                            </StackPanel>
                            <TextBlock Text="{Binding MessageEditeur}" TextWrapping="Wrap" Margin="{StaticResource Marge.Haut.8}"
                                       Visibility="{Binding MessageEditeur, Converter={StaticResource VisibleSi}}" AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Texte.Secondaire}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ErreurEditeur}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Ton.Attention.Texte}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ResumeMatrices}" Style="{StaticResource Texte.Meta}" TextWrapping="Wrap" Margin="{StaticResource Marge.Haut.8}" />
                        </StackPanel>
                    </Expander>

                    <!-- ===== Historique ===== -->
                    <DockPanel Margin="{StaticResource Marge.Haut.16}">
                        <Button DockPanel.Dock="Right" Content="Effacer" Style="{StaticResource BoutonFantome}" Command="{Binding ViderHistoriqueCommand}"
                                ToolTip="Vider l'historique" />
                        <TextBlock Text="Historique" Style="{StaticResource Texte.Meta}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Historique}" Focusable="False" Margin="{StaticResource Marge.Haut.4}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BoutonListe}" HorizontalContentAlignment="Stretch" Padding="8,6"
                                        Command="{Binding DataContext.ReprendreCommand, ElementName=Racine}" CommandParameter="{Binding}"
                                        ToolTip="Remettre ce calcul dans la ligne de saisie">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Expression}" FontFamily="{DynamicResource Police.Code}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Resume}" Style="{StaticResource Texte.Secondaire}" TextWrapping="Wrap"
                                                   FontFamily="{DynamicResource Police.Code}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
