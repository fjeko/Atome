<UserControl x:Class="Revisions.App.Views.Mascotte"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Petit personnage tout simple : une bouille ronde avec une pousse (un nœud de l'arbre de compétences) sur la tête.
         Il suit la couleur du texte (blanc en thème sombre). Quatre expressions, voir Mascotte.xaml.cs. Grille : 100 × 100. -->
    <UserControl.Resources>
        <Style x:Key="Trait" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <Style x:Key="Oeil" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>
    <Viewbox>
        <Canvas Width="100" Height="100">
            <!-- Pousse. -->
            <Path Style="{StaticResource Trait}" Stroke="{DynamicResource AccentFillColorDefaultBrush}" Data="M50,30 L50,19" />
            <Ellipse Width="14" Height="14" Canvas.Left="43" Canvas.Top="5" StrokeThickness="4.5"
                     Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
            <!-- Tête. -->
            <Ellipse Width="76" Height="68" Canvas.Left="12" Canvas.Top="28" StrokeThickness="5"
                     Stroke="{DynamicResource TextFillColorPrimaryBrush}" />
            <!-- Yeux. -->
            <Ellipse x:Name="OeilG" Style="{StaticResource Oeil}" Canvas.Left="33.5" Canvas.Top="52" />
            <Ellipse x:Name="OeilD" Style="{StaticResource Oeil}" Canvas.Left="57.5" Canvas.Top="52" />
            <Path x:Name="ArcG" Style="{StaticResource Trait}" Data="M31,58 Q38,48 45,58" Visibility="Collapsed" />
            <Path x:Name="ArcD" Style="{StaticResource Trait}" Data="M55,58 Q62,48 69,58" Visibility="Collapsed" />
            <!-- Bouches. -->
            <Path x:Name="Sourire" Style="{StaticResource Trait}" Data="M37,69 Q50,81 63,69" />
            <Path x:Name="Rire" Style="{StaticResource Trait}" Fill="{DynamicResource TextFillColorPrimaryBrush}"
                  Data="M36,67 Q50,88 64,67 Z" Visibility="Collapsed" />
            <Path x:Name="EnCoin" Style="{StaticResource Trait}" Data="M38,72 Q54,78 64,66" Visibility="Collapsed" />
        </Canvas>
    </Viewbox>
</UserControl>
