<UserControl x:Class="Revisions.App.Views.VueMesSignalements"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Revisions.App.Views"
             xmlns:ds="clr-namespace:Revisions.App.Controles"
             x:Name="Racine">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource Largeur.Contenu}" Margin="{StaticResource Marge.Ecran}">
            <TextBlock Text="Mes signalements" Style="{StaticResource Texte.Titre}" />
            <TextBlock Style="{StaticResource Texte.Secondaire}" Margin="{StaticResource Marge.Haut.4}"
                       Text="Merci de repérer les erreurs : chaque signalement permet de corriger le cours pour tout le monde. Exporte-les dans un fichier et envoie-le." />

            <Border Style="{StaticResource CarteSurface}" Margin="{StaticResource Marge.Haut.16}">
                <StackPanel>
                    <TextBlock Text="Ton prénom ou pseudo (facultatif)" />
                    <TextBox Text="{Binding Auteur, UpdateSourceTrigger=LostFocus}" MaxLength="40" Margin="{StaticResource Marge.Haut.8}" MaxWidth="320" HorizontalAlignment="Left"
                             ToolTip="Il apparaît dans le nom du fichier exporté, pour savoir de qui viennent les signalements" />
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Marge.Haut.12}">
                        <Button Content="Exporter mes signalements" Command="{Binding ExporterCommand}" Style="{StaticResource BoutonPrincipal}" ds:Forme.Icone="{x:Static ds:Icones.Exporter}" />
                        <Button Content="Réglages" Command="{Binding RetourCommand}" Style="{StaticResource BoutonFantome}" ds:Forme.Icone="{x:Static ds:Icones.Retour}" Margin="{StaticResource Marge.Gauche.8}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Texte.Secondaire}" Margin="{StaticResource Marge.Haut.8}"
                               Visibility="{Binding Message, Converter={StaticResource VisibleSi}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CarteSurface}" Margin="{StaticResource Marge.Haut.16}"
                    Visibility="{Binding EstVide, Converter={StaticResource VisibleSi}}">
                <v:EtatVide Titre="Rien n'a encore été signalé" Humeur="Contente"
                            Texte="Pendant une session ou une lecture, le petit drapeau permet de signaler une erreur." />
            </Border>

            <ItemsControl ItemsSource="{Binding Lignes}" Margin="{StaticResource Marge.Haut.8}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CarteSurface}" Padding="{StaticResource Remplissage.Compact}" Margin="{StaticResource Marge.Haut.12}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Supprimer" Style="{StaticResource BoutonFantome}" Margin="{StaticResource Marge.Gauche.12}" VerticalAlignment="Top"
                                        Command="{Binding DataContext.SupprimerCommand, ElementName=Racine}" CommandParameter="{Binding}" />
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{Binding Motif, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="  ·  " /><Run Text="{Binding Etat, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Titre}" Style="{StaticResource Texte.Meta}" />
                                    <TextBlock Text="{Binding Extrait}" TextWrapping="Wrap" Margin="{StaticResource Marge.Haut.8}" />
                                    <TextBlock Text="{Binding Commentaire}" TextWrapping="Wrap" FontStyle="Italic" Margin="{StaticResource Marge.Haut.8}"
                                               Visibility="{Binding Commentaire, Converter={StaticResource VisibleSi}}" />
                                    <TextBlock Text="{Binding Date}" Style="{StaticResource Texte.Meta}" Margin="{StaticResource Marge.Haut.8}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
