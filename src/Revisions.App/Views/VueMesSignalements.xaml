<UserControl x:Class="Revisions.App.Views.VueMesSignalements"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Racine">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="940" Margin="32,28,32,28">
            <TextBlock Text="Mes signalements" Style="{StaticResource Titre}" />
            <TextBlock Style="{StaticResource Discret}" Margin="0,4,0,0"
                       Text="Merci de repérer les erreurs : chaque signalement permet de corriger le cours pour tout le monde. Exporte-les dans un fichier et envoie-le." />

            <Border Style="{StaticResource Carte}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Ton prénom ou pseudo (facultatif)" />
                    <TextBox Text="{Binding Auteur, UpdateSourceTrigger=LostFocus}" MaxLength="40" Margin="0,6,0,0" MaxWidth="320" HorizontalAlignment="Left"
                             ToolTip="Il apparaît dans le nom du fichier exporté, pour savoir de qui viennent les signalements" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Exporter mes signalements" Command="{Binding ExporterCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="18,8" />
                        <Button Content="← Réglages" Command="{Binding RetourCommand}" Padding="16,8" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Discret}" Margin="0,10,0,0"
                               Visibility="{Binding Message, Converter={StaticResource VisibleSi}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Rien n'a encore été signalé. Pendant une session ou une lecture, le petit drapeau permet de signaler une erreur."
                       Style="{StaticResource Discret}" Margin="0,18,0,0"
                       Visibility="{Binding EstVide, Converter={StaticResource VisibleSi}}" />

            <ItemsControl ItemsSource="{Binding Lignes}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Carte}" Padding="18,14" Margin="0,10,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Supprimer" Padding="14,6" Margin="14,0,0,0" VerticalAlignment="Top"
                                        Command="{Binding DataContext.SupprimerCommand, ElementName=Racine}" CommandParameter="{Binding}" />
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{Binding Motif, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="  ·  " /><Run Text="{Binding Etat, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Titre}" Style="{StaticResource Discret}" FontSize="12" />
                                    <TextBlock Text="{Binding Extrait}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Commentaire}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,6,0,0"
                                               Visibility="{Binding Commentaire, Converter={StaticResource VisibleSi}}" />
                                    <TextBlock Text="{Binding Date}" Style="{StaticResource Discret}" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
