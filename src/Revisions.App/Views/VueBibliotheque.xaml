<UserControl x:Class="Revisions.App.Views.VueBibliotheque"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Revisions.App.Views"
             xmlns:ds="clr-namespace:Revisions.App.Controles"
             x:Name="Racine">
    <!--
        Bibliothèque : des tuiles aux couleurs des matières, avec leur anneau de maîtrise
        (matière → compétence → thème → séances). Recherche, filtres de collections, fil d'Ariane,
        badge « Libre » et états vides (aucun cours, ou collections toutes masquées).
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="{StaticResource Largeur.Contenu}" Margin="{StaticResource Marge.Ecran}">

            <!-- En-tête : titre, recherche, actualiser, importer. -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="240" Margin="{StaticResource Marge.Droite.8}">
                        <TextBox x:Name="ZoneRecherche" Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}" Padding="32,6,8,6"
                                 VerticalContentAlignment="Center" AutomationProperties.Name="Rechercher une séance" ToolTip="Rechercher une séance" />
                        <TextBlock Style="{StaticResource Texte.Icone}" Text="{x:Static ds:Icones.Recherche}" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Pinceau.TexteDiscret}" HorizontalAlignment="Left" Margin="{StaticResource Marge.Gauche.12}" />
                    </Grid>
                    <Button Style="{StaticResource BoutonIcone}" ds:Forme.Icone="{x:Static ds:Icones.Actualiser}" Command="{Binding ActualiserCommand}"
                            Margin="{StaticResource Marge.Droite.8}" ToolTip="Relire le dossier des packs" AutomationProperties.Name="Actualiser" />
                    <Button Content="Importer…" Style="{StaticResource BoutonSecondaire}" ds:Forme.Icone="{x:Static ds:Icones.Importer}"
                            Command="{Binding ImporterCommand}" ToolTip="Importer un ou plusieurs fichiers de pack (.json)" />
                </StackPanel>
                <TextBlock Text="Bibliothèque" Style="{StaticResource Texte.Titre}" VerticalAlignment="Center" />
            </DockPanel>
            <v:BandeauMascotte Contexte="bibliotheque" Taille="56" HorizontalAlignment="Left" Margin="{StaticResource Marge.Haut.12}" />

            <!-- Filtres rapides par collection : les mêmes réglages que « Mes collections » dans les Réglages. -->
            <StackPanel Margin="{StaticResource Marge.Haut.16}" Visibility="{Binding AfficherFiltres, Converter={StaticResource VisibleSi}}">
                <ItemsControl ItemsSource="{Binding MesCollections}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding Nom}" IsChecked="{Binding Visible}" Style="{StaticResource BoutonBascule}"
                                          Margin="{StaticResource Marge.Droite.8}" ToolTip="{Binding Detail}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding MessageCollections}" Style="{StaticResource Texte.Base}" Margin="{StaticResource Marge.Haut.8}"
                           Foreground="{DynamicResource Pinceau.AccentTexte}"
                           Visibility="{Binding MessageCollections, Converter={StaticResource VisibleSi}}" />
            </StackPanel>

            <ProgressBar Style="{StaticResource BarreProgression}" IsIndeterminate="True" Height="3" Margin="{StaticResource Marge.Haut.12}"
                         Visibility="{Binding ImportEnCours, Converter={StaticResource VisibleSi}}" />

            <!-- Retour et fil d'Ariane cliquable. -->
            <DockPanel Margin="{StaticResource Marge.Haut.16}" Visibility="{Binding PeutRevenir, Converter={StaticResource VisibleSi}}">
                <Button DockPanel.Dock="Left" Style="{StaticResource BoutonIcone}" ds:Forme.Icone="{x:Static ds:Icones.Retour}"
                        Command="{Binding RetourCommand}" Margin="{StaticResource Marge.Droite.4}" ToolTip="Retour" AutomationProperties.Name="Retour" />
                <ItemsControl Style="{StaticResource FilAriane}" ItemsSource="{Binding Fil}" Tag="{Binding AllerACommand}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Des cours existent mais toutes les collections sont masquées. -->
            <Border Style="{StaticResource CarteSurface}" Margin="{StaticResource Marge.Haut.16}"
                    Visibility="{Binding CollectionsToutesMasquees, Converter={StaticResource VisibleSi}}">
                <v:EtatVide Titre="Tes cours sont masqués"
                            Texte="Toutes tes collections sont masquées. Rien n'est perdu : ta progression est intacte.">
                    <v:EtatVide.Action>
                        <Button Content="Afficher mes collections" Command="{Binding AfficherMesCollectionsCommand}" Style="{StaticResource BoutonPrincipal}" />
                    </v:EtatVide.Action>
                </v:EtatVide>
            </Border>

            <!-- Premier lancement, aucun pack : on met en avant l'import du contenu d'un camarade. -->
            <Border Style="{StaticResource CarteSurface}" Margin="{StaticResource Marge.Haut.16}"
                    Visibility="{Binding EstVide, Converter={StaticResource VisibleSi}}">
                <StackPanel>
                    <v:EtatVide Titre="Aucun cours pour l'instant"
                                Texte="Si un camarade t'a envoyé un fichier .atome, importe-le : tu auras tous les cours d'un coup. Sinon, ajoute un pack avec « Importer… » ou vérifie le dossier des packs dans les Réglages.">
                        <v:EtatVide.Action>
                            <Button Content="Importer du contenu" Command="{Binding Partage.ImporterCommand}" Style="{StaticResource BoutonPrincipal}"
                                    ds:Forme.Icone="{x:Static ds:Icones.Importer}" IsDefault="True" />
                        </v:EtatVide.Action>
                    </v:EtatVide>
                    <ProgressBar Style="{StaticResource BarreProgression}" Value="{Binding Partage.Progression, Mode=OneWay}" Margin="{StaticResource Marge.Haut.12}"
                                 Visibility="{Binding Partage.EnCours, Converter={StaticResource VisibleSi}}" />
                    <TextBlock Text="{Binding Partage.Message}" Style="{StaticResource Texte.Secondaire}" TextAlignment="Center" Margin="{StaticResource Marge.Haut.8}"
                               Visibility="{Binding Partage.Message, Converter={StaticResource VisibleSi}}" />
                </StackPanel>
            </Border>

            <!-- Matière avec test de positionnement : niveau de départ, test et choix du niveau. -->
            <Border Style="{StaticResource CarteSurface}" Margin="{StaticResource Marge.Haut.16}"
                    Visibility="{Binding PositionnementVisible, Converter={StaticResource VisibleSi}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource Marge.Gauche.16}">
                        <Button Content="Choisir mon niveau" Command="{Binding ChoisirNiveauCommand}" Style="{StaticResource BoutonSecondaire}"
                                Margin="{StaticResource Marge.Droite.8}" />
                        <Button Content="{Binding BoutonTest}" Command="{Binding PasserTestCommand}" Style="{StaticResource BoutonPrincipal}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Test de positionnement" Style="{StaticResource Texte.Fort}" />
                        <TextBlock Text="{Binding TextePositionnement}" Style="{StaticResource Texte.Secondaire}" TextWrapping="Wrap"
                                   Margin="{StaticResource Marge.Haut.4}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding TitreNiveau}" Style="{StaticResource Texte.SousTitre}" Margin="{StaticResource Marge.Haut.16}"
                       Visibility="{Binding TitreNiveau, Converter={StaticResource VisibleSi}}" />

            <!-- Tuiles des sous-niveaux : couleur et icône de la matière, anneau de maîtrise, « à revoir », coche quand tout est maîtrisé. -->
            <ItemsControl ItemsSource="{Binding Tuiles}" Margin="0,16,-16,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <!-- Grille qui remplit toute la largeur : alignée sur le bandeau du test de positionnement. -->
                    <ItemsPanelTemplate><ds:GrilleTuiles LargeurMin="244" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ds:TuileMatiere Height="236" Margin="{StaticResource Marge.Tuile}"
                                         ds:Ton.Matiere="{Binding Matiere}" ds:Ton.Partie="{Binding Partie}"
                                         Etiquette="{Binding Etiquette}" Titre="{Binding Titre}" Detail="{Binding Detail}"
                                         Progression="{Binding Maitrise}" Mention="{Binding Dues}" Cochee="{Binding Finie}" Libre="{Binding Libre}"
                                         ToolTip="{Binding InfoMaitrise}" AutomationProperties.Name="{Binding Titre}"
                                         Command="{Binding DataContext.OuvrirCommand, ElementName=Racine}" CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Séances du niveau (ou résultats de la recherche). -->
            <ItemsControl ItemsSource="{Binding Seances}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CarteSurface}" Padding="0" Margin="{StaticResource Marge.Bas.12}"
                                ds:Ton.Matiere="{Binding Matiere}" ds:Ton.Partie="{Binding Partie}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Liseré de la matière. -->
                                <Border Width="4" CornerRadius="2" Margin="12,14,0,14" Background="{Binding (ds:Ton.Trait), RelativeSource={RelativeSource Self}}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,14,8,14">
                                    <TextBlock Text="{Binding Emplacement}" Style="{StaticResource Texte.Meta}"
                                               Visibility="{Binding Emplacement, Converter={StaticResource VisibleSi}}" />
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Titre}" Style="{StaticResource Texte.Corps}" FontWeight="SemiBold" Margin="{StaticResource Marge.Droite.8}" />
                                        <Border Style="{StaticResource BadgeLibre}" Visibility="{Binding EstLibre, Converter={StaticResource VisibleSi}}">
                                            <TextBlock Text="Libre" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Texte.Meta}" Margin="{StaticResource Marge.Haut.4}" />
                                    <TextBlock Text="{Binding Controle}" Style="{StaticResource Texte.Meta}" Foreground="{DynamicResource Ton.Succes.Texte}"
                                               Visibility="{Binding Controle, Converter={StaticResource VisibleSi}}" />
                                </StackPanel>
                                <!-- Maîtrise : mini-anneau, avec son pourcentage en infobulle. -->
                                <ds:Anneau Grid.Column="2" Width="32" Height="32" Epaisseur="4" Valeur="{Binding Maitrise}" Margin="{StaticResource Marge.Droite.16}"
                                           Trait="{Binding (ds:Ton.Trait), RelativeSource={RelativeSource Self}}" Piste="{DynamicResource Pinceau.Voile}"
                                           ToolTip="Part des cartes maîtrisées" AutomationProperties.Name="Maîtrise de la séance" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource Marge.Droite.16}">
                                    <Button Content="Lire" Style="{StaticResource BoutonSecondaire}" ds:Forme.Icone="{x:Static ds:Icones.Lire}"
                                            Margin="{StaticResource Marge.Droite.8}"
                                            Command="{Binding DataContext.LireCommand, ElementName=Racine}" CommandParameter="{Binding}" />
                                    <Button Content="Lire puis contrôler" Style="{StaticResource BoutonSecondaire}" ds:Forme.Icone="{x:Static ds:Icones.Lire}"
                                            Margin="{StaticResource Marge.Droite.8}" IsEnabled="{Binding ADesCartes}"
                                            ToolTip="Le cours section par section avec des questions flash, puis un petit contrôle (on peut quitter et reprendre)"
                                            Command="{Binding DataContext.LireEtControlerCommand, ElementName=Racine}" CommandParameter="{Binding}" />
                                    <Button Content="Réviser" Style="{StaticResource BoutonSecondaire}" ds:Forme.Icone="{x:Static ds:Icones.Jouer}"
                                            IsEnabled="{Binding ADesCartes}"
                                            Command="{Binding DataContext.ReviserCommand, ElementName=Racine}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding InfoRecherche}" Style="{StaticResource Texte.Secondaire}" Margin="{StaticResource Marge.Haut.4}"
                       Visibility="{Binding InfoRecherche, Converter={StaticResource VisibleSi}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
