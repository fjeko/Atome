<UserControl x:Class="Revisions.App.Views.VueBibliotheque"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Revisions.App.Views"
             x:Name="Racine">
    <DockPanel Margin="28,28,28,16">
        <v:BandeauMascotte DockPanel.Dock="Top" Contexte="bibliotheque" Taille="72" HorizontalAlignment="Left" Margin="0,0,0,10" />
        <!-- En-tête : titre, recherche, import. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Bibliothèque" Style="{StaticResource Titre}" />
            <TextBox Grid.Column="1" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"
                     Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rechercher une séance" />
            <Button Grid.Column="2" Content="Actualiser" Command="{Binding ActualiserCommand}" Padding="16,7" Margin="0,0,10,0"
                    ToolTip="Relire le dossier des packs" />
            <Button Grid.Column="3" Content="Importer…" Command="{Binding ImporterCommand}" Padding="16,7"
                    ToolTip="Importer un ou plusieurs fichiers de pack (.json)" />
        </Grid>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding ImportEnCours, Converter={StaticResource VisibleSi}}" />

        <!-- Bouton Retour et fil d'Ariane cliquable. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Content="← Retour" Command="{Binding RetourCommand}" Padding="14,6" Margin="0,0,12,0"
                    Visibility="{Binding PeutRevenir, Converter={StaticResource VisibleSi}}" />
            <ItemsControl ItemsSource="{Binding Fil}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Padding="8,4" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.AllerACommand, ElementName=Racine}" CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Titre}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!-- Le niveau affiché est en gras. -->
                                                <DataTrigger Binding="{Binding EstCourant}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <TextBlock Text="›" VerticalAlignment="Center" Margin="2,0" Style="{StaticResource Discret}"
                                       Visibility="{Binding EstCourant, Converter={StaticResource VisibleSi}, ConverterParameter=inverse}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Premier lancement, aucun pack : on met en avant l'import du contenu d'un camarade. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14" Visibility="{Binding EstVide, Converter={StaticResource VisibleSi}}">
            <TextBlock Style="{StaticResource Discret}" FontSize="15" TextWrapping="Wrap"
                       Text="Aucun cours pour l'instant. Si un camarade t'a envoyé un fichier .atome, importe-le : tu auras tous les cours d'un coup. Sinon, ajoute un pack avec « Importer… » ou vérifie le dossier des packs dans les réglages." />
            <Button Content="Importer du contenu" Command="{Binding Partage.ImporterCommand}"                    HorizontalAlignment="Left" Padding="24,10" Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold" IsDefault="True" />
            <ProgressBar Value="{Binding Partage.Progression, Mode=OneWay}" Maximum="1" Height="6" Margin="0,10,0,0"
                         Visibility="{Binding Partage.EnCours, Converter={StaticResource VisibleSi}}" />
            <TextBlock Text="{Binding Partage.Message}" Style="{StaticResource Discret}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding Partage.Message, Converter={StaticResource VisibleSi}}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding TitreNiveau}" Style="{StaticResource SousTitre}" FontSize="19" Margin="0,2,0,10"
                           Visibility="{Binding TitreNiveau, Converter={StaticResource VisibleSi}}" />

                <!-- Tuiles des sous-niveaux. -->
                <ItemsControl ItemsSource="{Binding Tuiles}" Margin="-7,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Height="188" Margin="7" Padding="20,18" Cursor="Hand" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Command="{Binding DataContext.OuvrirCommand, ElementName=Racine}" CommandParameter="{Binding}">
                                <DockPanel>
                                    <!-- Bas de la tuile : barre de maîtrise et compteurs. -->
                                    <ProgressBar DockPanel.Dock="Bottom" Value="{Binding Maitrise, Mode=OneWay}" Maximum="1" Height="6"
                                                 ToolTip="{Binding InfoMaitrise}" />
                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Dues}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="13" Style="{StaticResource Discret}" TextWrapping="NoWrap" />
                                    </DockPanel>
                                    <!-- Pictogramme de la matière, dans le coin : un dessin au trait sur une pastille
                                         à peine teintée, pour repérer la matière sans alourdir la tuile. -->
                                    <!-- Il partage une ligne avec le nom du bloc : le titre garde ainsi toute la largeur. -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,-2,0,8"
                                               Visibility="{Binding Dessin, Converter={StaticResource VisibleSi}}">
                                        <Grid DockPanel.Dock="Right" Width="42" Height="42">
                                            <Border CornerRadius="10" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.16" />
                                            <Path Data="{Binding Dessin}" Width="24" Height="24" Stretch="Uniform"
                                                  Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Grid>
                                        <TextBlock Text="{Binding Etiquette}" FontSize="13" Style="{StaticResource Discret}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Titre}" FontSize="16.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Top" ToolTip="{Binding Titre}" />
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Séances du niveau (ou résultats de la recherche). -->
                <ItemsControl ItemsSource="{Binding Seances}" Margin="0,6,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Carte}" Padding="20,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Emplacement}" Style="{StaticResource Discret}" FontSize="12"
                                                   Visibility="{Binding Emplacement, Converter={StaticResource VisibleSi}}" />
                                        <TextBlock Text="{Binding Titre}" FontSize="16" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Discret}" FontSize="12" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" Value="{Binding Maitrise, Mode=OneWay}" Maximum="1" Height="6"
                                                 VerticalAlignment="Center" Margin="12,0" ToolTip="Part des cartes maîtrisées" />
                                    <Button Grid.Column="2" Content="Lire" Padding="16,6" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.LireCommand, ElementName=Racine}" CommandParameter="{Binding}" />
                                    <Button Grid.Column="3" Content="Réviser" Padding="16,6" VerticalAlignment="Center"
                                            IsEnabled="{Binding ADesCartes}"
                                            Command="{Binding DataContext.ReviserCommand, ElementName=Racine}" CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding InfoRecherche}" Style="{StaticResource Discret}" Margin="0,4,0,0"
                           Visibility="{Binding InfoRecherche, Converter={StaticResource VisibleSi}}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
