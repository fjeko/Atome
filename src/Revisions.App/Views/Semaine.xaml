<UserControl x:Class="Revisions.App.Views.Semaine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ds="clr-namespace:Revisions.App.Controles"
             x:Name="Racine" Focusable="False" IsTabStop="False">
    <!-- Semaine : 7 pastilles du lundi au dimanche. Jour révisé = pastille pleine AVEC une coche (pas la couleur seule) ;
         aujourd'hui = anneau d'accent et lettre en gras. -->
    <ItemsControl ItemsSource="{Binding Jours, ElementName=Racine}" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel HorizontalAlignment="Center" AutomationProperties.Name="{Binding NomAccessible}">
                    <Grid Width="32" Height="32">
                        <Ellipse x:Name="Contour" StrokeThickness="1.5" Stroke="{DynamicResource Pinceau.Bordure}" />
                        <Ellipse x:Name="Plein" Fill="{DynamicResource Pinceau.AccentTrait}" Visibility="Collapsed" />
                        <TextBlock x:Name="Coche" Style="{StaticResource Texte.Icone}" Text="{x:Static ds:Icones.Coche}"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Pinceau.Surface}" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="Lettre" Text="{Binding Lettre}" Style="{StaticResource Texte.Meta}" HorizontalAlignment="Center"
                               Margin="{StaticResource Marge.Haut.4}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Actif}" Value="True">
                        <Setter TargetName="Plein" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Coche" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding EstAujourdhui}" Value="True">
                        <Setter TargetName="Contour" Property="Stroke" Value="{DynamicResource Pinceau.AccentTrait}" />
                        <Setter TargetName="Contour" Property="StrokeThickness" Value="2.5" />
                        <Setter TargetName="Lettre" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="Lettre" Property="Foreground" Value="{DynamicResource Pinceau.Texte}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
