<Window x:Class="Revisions.App.Views.FenetreRapport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ds="clr-namespace:Revisions.App.Controles"
        Title="Rapport d'import" Width="760" Height="560" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Rapport d'import : un pack par carte ; un pack refusé est marqué en ambre ET écrit « Refusé ». -->
    <DockPanel Margin="{StaticResource Remplissage.Carte}">
        <TextBlock DockPanel.Dock="Top" Text="Rapport d'import" Style="{StaticResource Texte.SousTitre}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Resume}" Style="{StaticResource Texte.Secondaire}" Margin="0,4,0,12" />
        <Button DockPanel.Dock="Bottom" Content="Fermer" IsCancel="True" IsDefault="True" Click="Fermer" Style="{StaticResource BoutonPrincipal}"
                Margin="{StaticResource Marge.Haut.12}" HorizontalAlignment="Right" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Lignes}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CarteSurface}" Padding="{StaticResource Remplissage.Compact}" Margin="0,0,6,8">
                            <StackPanel>
                                <DockPanel>
                                    <Border x:Name="Statut" DockPanel.Dock="Right" Style="{StaticResource PastilleNeutre}" Margin="{StaticResource Marge.Gauche.12}">
                                        <TextBlock Text="{Binding Statut}" />
                                    </Border>
                                    <TextBlock Text="{Binding Fichier}" Style="{StaticResource Texte.Fort}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Problemes}" Margin="{StaticResource Marge.Haut.4}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Texte.Meta}" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding EstRefuse}" Value="True">
                                <Setter TargetName="Statut" Property="ds:Ton.Nom" Value="Attention" />
                                <Setter TargetName="Statut" Property="Background" Value="{DynamicResource Ton.Attention.Pale}" />
                                <Setter TargetName="Statut" Property="TextElement.Foreground" Value="{DynamicResource Ton.Attention.Texte}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
