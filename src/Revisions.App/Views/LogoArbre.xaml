<UserControl x:Class="Revisions.App.Views.LogoArbre"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Logo : un arbre de compétences dans l'esprit de celui d'Arc Raiders.
         Trois troncs partent du bas, chacun avec un gros nœud (hub) d'où s'écartent des branches courbes.
         Couleur d'accent = compétences acquises ou disponibles ; gris et fin = verrouillé.
         Pas de fond, traits épais. Grille de dessin : 120 × 120. -->
    <UserControl.Resources>
        <Style x:Key="Tige" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <Style x:Key="TigeVerrouillee" TargetType="Path" BasedOn="{StaticResource Tige}">
            <Setter Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="3.5" />
        </Style>
        <Style x:Key="Plein" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Creux" TargetType="Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="4" />
        </Style>
        <Style x:Key="Verrouille" TargetType="Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="3.5" />
        </Style>
    </UserControl.Resources>

    <Viewbox>
        <Canvas Width="120" Height="120">
            <!-- Troncs et branches débloquées. -->
            <Path Style="{StaticResource Tige}" Data="M60,118 L60,86" />
            <Path Style="{StaticResource Tige}" Data="M60,66 C60,56 46,56 46,50" />
            <Path Style="{StaticResource Tige}" Data="M60,66 C60,56 74,56 74,50" />
            <Path Style="{StaticResource Tige}" Data="M36,118 C36,104 22,102 22,88" />
            <Path Style="{StaticResource Tige}" Data="M22,72 C22,66 12,64 12,57.5" />
            <Path Style="{StaticResource Tige}" Data="M84,118 C84,104 98,102 98,88" />
            <!-- Branches verrouillées (fines et grises). -->
            <Path Style="{StaticResource TigeVerrouillee}" Data="M46,38 L46,23" />
            <Path Style="{StaticResource TigeVerrouillee}" Data="M74,38 L74,21" />
            <Path Style="{StaticResource TigeVerrouillee}" Data="M25,73 L31,57.5" />
            <Path Style="{StaticResource TigeVerrouillee}" Data="M98,72 L108,57.5" />
            <Path Style="{StaticResource TigeVerrouillee}" Data="M94,73 L90,56.5" />

            <!-- Nœuds (coin haut-gauche = centre − rayon). -->
            <Ellipse Style="{StaticResource Plein}" Width="20" Height="20" Canvas.Left="50" Canvas.Top="66" />
            <Ellipse Style="{StaticResource Plein}" Width="12" Height="12" Canvas.Left="40" Canvas.Top="38" />
            <Ellipse Style="{StaticResource Plein}" Width="16" Height="16" Canvas.Left="14" Canvas.Top="72" />
            <Ellipse Style="{StaticResource Plein}" Width="11" Height="11" Canvas.Left="6.5" Canvas.Top="46.5" />
            <Ellipse Style="{StaticResource Creux}" Width="12" Height="12" Canvas.Left="68" Canvas.Top="38" />
            <Ellipse Style="{StaticResource Creux}" Width="16" Height="16" Canvas.Left="90" Canvas.Top="72" />
            <Ellipse Style="{StaticResource Verrouille}" Width="14" Height="14" Canvas.Left="39" Canvas.Top="9" />
            <Ellipse Style="{StaticResource Verrouille}" Width="14" Height="14" Canvas.Left="67" Canvas.Top="7" />
            <Ellipse Style="{StaticResource Verrouille}" Width="11" Height="11" Canvas.Left="26.5" Canvas.Top="46.5" />
            <Ellipse Style="{StaticResource Verrouille}" Width="11" Height="11" Canvas.Left="104.5" Canvas.Top="46.5" />
            <Ellipse Style="{StaticResource Verrouille}" Width="11" Height="11" Canvas.Left="83.5" Canvas.Top="45.5" />
        </Canvas>
    </Viewbox>
</UserControl>
