<UserControl x:Class="Revisions.App.Views.LogoArbre"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Logo : un arbre de compétences (« skill tree » de jeu vidéo).
         Nœuds pleins = compétences acquises, nœuds creux = à débloquer, reliés par des traits droits.
         Pas de fond, traits épais, couleur d'accent du thème. Grille de dessin : 120 × 120. -->
    <UserControl.Resources>
        <Style x:Key="Lien" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <Style x:Key="NoeudPlein" TargetType="Ellipse">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="NoeudCreux" TargetType="Ellipse">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="4.5" />
        </Style>
    </UserControl.Resources>

    <Viewbox>
        <Canvas Width="120" Height="120">
            <!-- Liens (ils s'arrêtent au bord des nœuds creux). -->
            <Path Style="{StaticResource Lien}" Data="M60,104 L60,76" />
            <Path Style="{StaticResource Lien}" Data="M60,76 L34,54 L34,26" />
            <Path Style="{StaticResource Lien}" Data="M60,76 L79.5,58.5" />
            <Path Style="{StaticResource Lien}" Data="M60,76 L60,33" />
            <Path Style="{StaticResource Lien}" Data="M86,47 L86,33" />

            <!-- Nœuds (coin haut-gauche = centre − 9). -->
            <Ellipse Style="{StaticResource NoeudPlein}" Canvas.Left="51" Canvas.Top="95" />
            <Ellipse Style="{StaticResource NoeudPlein}" Canvas.Left="51" Canvas.Top="67" />
            <Ellipse Style="{StaticResource NoeudPlein}" Canvas.Left="25" Canvas.Top="45" />
            <Ellipse Style="{StaticResource NoeudPlein}" Canvas.Left="25" Canvas.Top="8" />
            <Ellipse Style="{StaticResource NoeudCreux}" Canvas.Left="77" Canvas.Top="45" />
            <Ellipse Style="{StaticResource NoeudCreux}" Canvas.Left="77" Canvas.Top="8" />
            <Ellipse Style="{StaticResource NoeudCreux}" Canvas.Left="51" Canvas.Top="15" />
        </Canvas>
    </Viewbox>
</UserControl>
