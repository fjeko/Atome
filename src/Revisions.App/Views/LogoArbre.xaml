<UserControl x:Class="Revisions.App.Views.LogoArbre"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Logo : un livre ouvert dont sort un arbre de compétences (skill tree).
         Les branches sont des pistes de circuit imprimé (angles à 45°) qui finissent par des nœuds :
         pleins = compétences acquises, creux = à débloquer. Pas de fond, traits épais, couleur d'accent du thème.
         Grille de dessin : 120 × 120. -->
    <UserControl.Resources>
        <Style x:Key="Piste" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="6" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <Style x:Key="NoeudPlein" TargetType="Ellipse">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="NoeudCreux" TargetType="Ellipse">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="4.5" />
        </Style>
        <!-- Livre : suit la couleur du texte pour rester visible en thème clair comme sombre. -->
        <Style x:Key="Livre" TargetType="Path" BasedOn="{StaticResource Piste}">
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Viewbox>
        <Canvas Width="120" Height="120">
            <!-- Livre ouvert : deux pages qui se rejoignent au milieu. -->
            <Path Style="{StaticResource Livre}" Data="M10,78 L10,98 L60,110 L110,98 L110,78" />
            <Path Style="{StaticResource Livre}" Data="M10,78 L60,90 L110,78" />

            <!-- Tronc, puis pistes à 45°. -->
            <Path Style="{StaticResource Piste}" Data="M60,90 L60,22" />
            <Path Style="{StaticResource Piste}" Data="M60,84 L38,62 L25,62" />
            <Path Style="{StaticResource Piste}" Data="M60,84 L82,62 L95,62" />
            <Path Style="{StaticResource Piste}" Data="M60,56 L42,38 L42,24" />
            <Path Style="{StaticResource Piste}" Data="M60,56 L78,38 L78,24" />

            <!-- Nœuds : pleins = acquis, creux = à débloquer (coin haut-gauche = centre − 7,5). -->
            <Ellipse Style="{StaticResource NoeudPlein}" Canvas.Left="52.5" Canvas.Top="7" />
            <Ellipse Style="{StaticResource NoeudCreux}" Canvas.Left="34.5" Canvas.Top="9" />
            <Ellipse Style="{StaticResource NoeudPlein}" Canvas.Left="70.5" Canvas.Top="9" />
            <Ellipse Style="{StaticResource NoeudPlein}" Canvas.Left="10" Canvas.Top="54.5" />
            <Ellipse Style="{StaticResource NoeudCreux}" Canvas.Left="95" Canvas.Top="54.5" />
        </Canvas>
    </Viewbox>
</UserControl>
