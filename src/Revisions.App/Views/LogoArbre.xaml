<UserControl x:Class="Revisions.App.Views.LogoArbre"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Logo de l'application, redessiné en tracés : pas de fond, traits épais, net à toutes les tailles.
         L'arbre garde sa couleur cuivre ; le livre prend la couleur du texte, pour rester visible
         en thème clair comme en thème sombre. Grille de dessin : 120 × 120. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Cuivre" Color="#CC8553" />
        <!-- Trait de l'arbre. -->
        <Style x:Key="Branche" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Cuivre}" />
            <Setter Property="StrokeThickness" Value="5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <!-- Nœud au bout d'une branche : un anneau, comme une pastille de circuit. -->
        <Style x:Key="Noeud" TargetType="Ellipse">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stroke" Value="{StaticResource Cuivre}" />
            <Setter Property="StrokeThickness" Value="4" />
        </Style>
        <!-- Feuille : une amande pleine, tournée selon sa branche. -->
        <Style x:Key="Feuille" TargetType="Path">
            <Setter Property="Fill" Value="{StaticResource Cuivre}" />
            <Setter Property="Data" Value="M0,0 C4,-6.5 12,-6.5 17,0 C12,6.5 4,6.5 0,0 Z" />
        </Style>
        <!-- Page du livre. -->
        <Style x:Key="Page" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Opacity" Value="0.88" />
        </Style>
    </UserControl.Resources>

    <Viewbox>
        <Canvas Width="120" Height="120">
            <!-- Livre ouvert : deux pages de chaque côté. -->
            <Path Style="{StaticResource Page}" Data="M5,92 Q34,89 55,107" />
            <Path Style="{StaticResource Page}" Data="M15,81 Q38,80 55,96" />
            <Path Style="{StaticResource Page}" Data="M115,92 Q86,89 65,107" />
            <Path Style="{StaticResource Page}" Data="M105,81 Q82,80 65,96" />

            <!-- Tronc et branches. -->
            <Path Style="{StaticResource Branche}" StrokeThickness="6.5" Data="M60,110 C60,90 59,70 60,52" />
            <Path Style="{StaticResource Branche}" Data="M60,52 C58,42 62,34 60,26" />
            <Path Style="{StaticResource Branche}" Data="M60,66 C53,53 45,45 36,40" />
            <Path Style="{StaticResource Branche}" Data="M60,66 C67,53 75,45 84,40" />
            <Path Style="{StaticResource Branche}" Data="M60,82 C48,68 35,62 23,60" />
            <Path Style="{StaticResource Branche}" Data="M60,82 C72,68 85,62 97,60" />

            <!-- Nœuds (le coin haut-gauche de chaque anneau est donné par Canvas.Left / Top). -->
            <Ellipse Style="{StaticResource Noeud}" Canvas.Left="52.5" Canvas.Top="9" />
            <Ellipse Style="{StaticResource Noeud}" Canvas.Left="22" Canvas.Top="28" />
            <Ellipse Style="{StaticResource Noeud}" Canvas.Left="83" Canvas.Top="28" />
            <Ellipse Style="{StaticResource Noeud}" Canvas.Left="7" Canvas.Top="52" />
            <Ellipse Style="{StaticResource Noeud}" Canvas.Left="98" Canvas.Top="52" />

            <!-- Feuilles. -->
            <!-- Chaque feuille part du point (Left, Top) et s'allonge dans la direction de l'angle. -->
            <Path Style="{StaticResource Feuille}" Canvas.Left="57" Canvas.Top="46">
                <Path.RenderTransform><RotateTransform Angle="-140" /></Path.RenderTransform>
            </Path>
            <Path Style="{StaticResource Feuille}" Canvas.Left="63" Canvas.Top="46">
                <Path.RenderTransform><RotateTransform Angle="-40" /></Path.RenderTransform>
            </Path>
            <Path Style="{StaticResource Feuille}" Canvas.Left="44" Canvas.Top="70">
                <Path.RenderTransform><RotateTransform Angle="-175" /></Path.RenderTransform>
            </Path>
            <Path Style="{StaticResource Feuille}" Canvas.Left="76" Canvas.Top="70">
                <Path.RenderTransform><RotateTransform Angle="-5" /></Path.RenderTransform>
            </Path>
        </Canvas>
    </Viewbox>
</UserControl>
