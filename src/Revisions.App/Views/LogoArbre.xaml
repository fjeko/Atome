<UserControl x:Class="Revisions.App.Views.LogoArbre"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Logo : un arbre de compétences (« skill tree » de jeu vidéo).
         Nœuds pleins = compétences acquises, nœuds creux = à débloquer, reliés par des traits droits.
         Pas de fond, traits épais, couleur d'accent du thème. Grille de dessin : 120 × 120. -->
    <UserControl.Resources>
        <Style x:Key="Lien" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <Style x:Key="NoeudPlein" TargetType="Ellipse">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="NoeudCreux" TargetType="Ellipse">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="4.5" />
        </Style>
    </UserControl.Resources>

    <Viewbox>
        <Canvas Width="120" Height="120">
            <!-- Liens (ils s'arrêtent au bord des nœuds creux). -->
            <Path Style="{StaticResource Lien}" Data="M60,106 L60,82 L30,60 L14,34" />
            <Path Style="{StaticResource Lien}" Data="M30,60 L40,28" />
            <Path Style="{StaticResource Lien}" Data="M60,82 L82.7,65.3" />
            <Path Style="{StaticResource Lien}" Data="M60,82 L60,25" />
            <Path Style="{StaticResource Lien}" Data="M87.3,51.4 L82.7,36.6" />
            <Path Style="{StaticResource Lien}" Data="M94.7,52.3 L101.3,41.7" />

            <!-- Nœuds (coin haut-gauche = centre − 9). -->
            <Ellipse Style="{StaticResource NoeudPlein}" Canvas.Left="51" Canvas.Top="97" />
            <Ellipse Style="{StaticResource NoeudPlein}" Canvas.Left="51" Canvas.Top="73" />
            <Ellipse Style="{StaticResource NoeudPlein}" Canvas.Left="21" Canvas.Top="51" />
            <Ellipse Style="{StaticResource NoeudPlein}" Canvas.Left="5" Canvas.Top="25" />
            <Ellipse Style="{StaticResource NoeudPlein}" Canvas.Left="31" Canvas.Top="19" />
            <Ellipse Style="{StaticResource NoeudCreux}" Canvas.Left="51" Canvas.Top="7" />
            <Ellipse Style="{StaticResource NoeudCreux}" Canvas.Left="81" Canvas.Top="51" />
            <Ellipse Style="{StaticResource NoeudCreux}" Canvas.Left="71" Canvas.Top="19" />
            <Ellipse Style="{StaticResource NoeudCreux}" Canvas.Left="97" Canvas.Top="25" />
        </Canvas>
    </Viewbox>
</UserControl>
