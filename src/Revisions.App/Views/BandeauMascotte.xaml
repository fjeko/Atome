<UserControl x:Class="Revisions.App.Views.BandeauMascotte"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Revisions.App.Views">
    <!-- La mascotte et sa bulle. -->
    <StackPanel Orientation="Horizontal">
        <v:Mascotte x:Name="Perso" />
        <Border Style="{StaticResource Carte}" Padding="20,12" Margin="10,0,0,0" CornerRadius="16"
                VerticalAlignment="Center" MaxWidth="560">
            <TextBlock x:Name="Texte" FontSize="17" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
