<UserControl x:Class="Revisions.App.Views.BandeauMascotte"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Revisions.App.Views"
             Focusable="False" IsTabStop="False">
    <!-- La mascotte et sa bulle. Réduite ou masquée selon le réglage « Mascotte » (Réglages → Apparence). -->
    <StackPanel Orientation="Horizontal">
        <v:Mascotte x:Name="Perso" VerticalAlignment="Center" />
        <Border x:Name="Bulle" Margin="{StaticResource Marge.Gauche.12}" Padding="16,10" VerticalAlignment="Center"
                CornerRadius="{StaticResource Rayon.Tuile}" BorderThickness="1"
                Background="{DynamicResource Pinceau.Surface}" BorderBrush="{DynamicResource Pinceau.Bordure}"
                MaxWidth="{StaticResource Largeur.Bulle}">
            <TextBlock x:Name="Texte" Style="{StaticResource Texte.Corps}" />
        </Border>
    </StackPanel>
</UserControl>
