<UserControl x:Class="Revisions.App.Views.VuePositionnement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Revisions.App.Controles"
             xmlns:v="clr-namespace:Revisions.App.Views"
             xmlns:ds="clr-namespace:Revisions.App.Controles"
             x:Name="Racine">
    <!--
        Test de positionnement, en mode concentration : consignes (et test du son), questions une à une
        (sans correction), résultat ; ou choix direct du niveau de départ.
    -->
    <UserControl.Resources>
        <!-- Bouton de niveau : le code et le nom, puis ce qu'on sait déjà faire. -->
        <Style x:Key="Niveau" TargetType="Button" BasedOn="{StaticResource BoutonSecondaire}">
            <Setter Property="Padding" Value="{StaticResource Remplissage.Compact}" />
            <Setter Property="ds:Forme.Rayon" Value="{StaticResource Rayon.Carte}" />
            <Setter Property="Margin" Value="{StaticResource Marge.Bas.8}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="{DynamicResource Taille.Corps}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Marge.Ecran}" MaxWidth="{StaticResource Largeur.Contenu}" ds:Ton.Matiere="{Binding Matiere}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Quitter, repère, avancement ===== -->
        <DockPanel>
            <Button DockPanel.Dock="Left" Content="Quitter" Command="{Binding QuitterCommand}" Style="{StaticResource BoutonFantome}"
                    ds:Forme.Icone="{x:Static ds:Icones.Pause}" Foreground="{DynamicResource Pinceau.TexteSecondaire}"
                    ToolTip="Revenir à la bibliothèque (Échap)" />
            <Border DockPanel.Dock="Right" Style="{StaticResource PastilleNeutre}" Padding="10,3"
                    Visibility="{Binding EstQuestion, Converter={StaticResource VisibleSi}}">
                <TextBlock Text="{Binding Repere}" FontSize="{DynamicResource Taille.Interface}" />
            </Border>
            <ProgressBar Style="{StaticResource BarreTon}" Height="4" Value="{Binding Avancement, Mode=OneWay}" Margin="16,0" VerticalAlignment="Center"
                         AutomationProperties.Name="Avancement du test"
                         Visibility="{Binding EstQuestion, Converter={StaticResource VisibleSi}}" />
        </DockPanel>

        <!-- ===== Titre et mascotte ===== -->
        <DockPanel Grid.Row="1" Margin="0,12,0,12">
            <v:BandeauMascotte DockPanel.Dock="Right" Taille="56" Message="{Binding Message}" Humeur="{Binding Humeur}" />
            <StackPanel VerticalAlignment="Center" Margin="{StaticResource Marge.Droite.16}">
                <TextBlock Text="{Binding Matiere}" Style="{StaticResource Texte.Meta}" Foreground="{Binding (ds:Ton.Texte), RelativeSource={RelativeSource Self}}" />
                <TextBlock Text="{Binding Titre}" Style="{StaticResource Texte.TitreCours}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Consignes et vérification du son ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding EstConsignes, Converter={StaticResource VisibleSi}}">
            <Border Style="{StaticResource CarteSurface}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Avant de commencer" Style="{StaticResource Texte.SousTitre}" />
                    <TextBlock Text="{Binding Consignes}" Style="{StaticResource Texte.Corps}" TextWrapping="Wrap" Margin="{StaticResource Marge.Haut.8}" />

                    <StackPanel Margin="{StaticResource Marge.Haut.16}" Visibility="{Binding AEcoute, Converter={StaticResource VisibleSi}}">
                        <TextBlock Text="🎧 Le son" Style="{StaticResource Texte.Fort}" />
                        <TextBlock Text="{Binding EtatVoix}" Style="{StaticResource Texte.Secondaire}" TextWrapping="Wrap" Margin="{StaticResource Marge.Haut.4}" />
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Marge.Haut.8}">
                            <Button Content="Tester le son" Command="{Binding TesterSonCommand}" Style="{StaticResource BoutonSecondaire}"
                                    Margin="{StaticResource Marge.Droite.8}" Visibility="{Binding VoixDisponible, Converter={StaticResource VisibleSi}}" />
                            <Button Content="Vérifier à nouveau" Command="{Binding VerifierVoixCommand}" Style="{StaticResource BoutonSecondaire}"
                                    Margin="{StaticResource Marge.Droite.8}"
                                    Visibility="{Binding VoixDisponible, Converter={StaticResource VisibleSi}, ConverterParameter=inverse}" />
                        </StackPanel>
                        <!-- Volume de la voix : retenu dans les réglages. -->
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Marge.Haut.8}" Visibility="{Binding VoixDisponible, Converter={StaticResource VisibleSi}}">
                            <TextBlock Text="Volume de la voix" Style="{StaticResource Texte.Base}" VerticalAlignment="Center" Margin="{StaticResource Marge.Droite.12}" />
                            <Slider Width="200" Value="{Binding VolumeVoix}" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" AutomationProperties.Name="Volume de la voix" />
                            <TextBlock Text="{Binding VolumeVoix, StringFormat={}{0} %}" Style="{StaticResource Texte.Meta}" VerticalAlignment="Center"
                                       Margin="{StaticResource Marge.Gauche.8}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Marge.Haut.24}">
                        <Button Content="Commencer le test" Command="{Binding CommencerCommand}" Style="{StaticResource BoutonPrincipal}" IsDefault="True"
                                Margin="{StaticResource Marge.Droite.8}" ds:Forme.Icone="{x:Static ds:Icones.Jouer}" />
                        <Button Content="Passer le test sans l'écoute" Command="{Binding CommencerSansEcouteCommand}" Style="{StaticResource BoutonSecondaire}"
                                Margin="{StaticResource Marge.Droite.8}"
                                Visibility="{Binding AEcoute, Converter={StaticResource VisibleSi}}" />
                        <Button Content="Je connais déjà mon niveau" Command="{Binding AfficherChoixCommand}" Style="{StaticResource BoutonFantome}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ===== Question (Markdown, choix cliquables) ===== -->
        <Border Grid.Row="2" Style="{StaticResource CarteSurface}" Padding="12,16,12,8" Background="{DynamicResource Pinceau.Surface}"
                Visibility="{Binding EstQuestion, Converter={StaticResource VisibleSi}}">
            <c:VueMarkdown Message="{Binding MessageRendu}" CommandeChoix="{Binding ChoisirCommand}" CommandeTouche="{Binding ToucheCommand}" />
        </Border>
        <DockPanel Grid.Row="3" Margin="{StaticResource Marge.Haut.12}" Visibility="{Binding EstQuestion, Converter={StaticResource VisibleSi}}">
            <Button DockPanel.Dock="Right" Content="Je ne sais pas" Command="{Binding JeNeSaisPasCommand}" Style="{StaticResource BoutonSecondaire}"
                    ToolTip="Mieux qu'une réponse au hasard : le résultat sera plus juste" />
            <Button DockPanel.Dock="Left" Content="{Binding TexteReecouter}" Command="{Binding ReecouterCommand}" Style="{StaticResource BoutonPrincipal}"
                    IsEnabled="{Binding PeutReecouter}" ToolTip="Écouter le texte (Espace) : trois écoutes au plus"
                    Visibility="{Binding EstEcoute, Converter={StaticResource VisibleSi}}" HorizontalAlignment="Left" />
            <!-- Volume réglable aussi pendant une question d'écoute. -->
            <Slider DockPanel.Dock="Left" Width="120" Value="{Binding VolumeVoix}" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" Margin="{StaticResource Marge.Gauche.12}" ToolTip="Volume de la voix"
                    AutomationProperties.Name="Volume de la voix" Visibility="{Binding EstEcoute, Converter={StaticResource VisibleSi}}" />
            <TextBlock Text="Clique sur ta réponse (ou tape A, B, C, D)." Style="{StaticResource Texte.Meta}" VerticalAlignment="Center"
                       Margin="{StaticResource Marge.Gauche.12}" />
        </DockPanel>

        <!-- ===== Résultat ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding EstResultat, Converter={StaticResource VisibleSi}}">
            <Border Style="{StaticResource CarteSurface}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding TitreResultat}" Style="{StaticResource Texte.Titre}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TexteResultat}" Style="{StaticResource Texte.Corps}" TextWrapping="Wrap" Margin="{StaticResource Marge.Haut.8}" />

                    <TextBlock Text="Par compétence" Style="{StaticResource Texte.Fort}" Margin="{StaticResource Marge.Haut.16}" />
                    <ItemsControl ItemsSource="{Binding Competences}" Margin="{StaticResource Marge.Haut.4}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Pinceau.Bordure}" BorderThickness="0,1,0,0" Padding="0,8,0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Score}" Style="{StaticResource Texte.Base}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="{StaticResource Marge.Gauche.12}" />
                                        <TextBlock Text="{Binding Nom}" Style="{StaticResource Texte.Base}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Conseil}" Style="{StaticResource Texte.Secondaire}" TextWrapping="Wrap" Margin="{StaticResource Marge.Haut.16}"
                               Visibility="{Binding Conseil, Converter={StaticResource VisibleSi}}" />

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Marge.Haut.24}">
                        <Button Content="{Binding BoutonCommencer}" Command="{Binding AllerAuCoursCommand}" Style="{StaticResource BoutonPrincipal}" IsDefault="True"
                                Margin="{StaticResource Marge.Droite.8}" ds:Forme.Icone="{x:Static ds:Icones.Jouer}" />
                        <Button Content="Choisir un autre niveau" Command="{Binding AfficherChoixCommand}" Style="{StaticResource BoutonSecondaire}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ===== Choix direct du niveau de départ ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding EstChoix, Converter={StaticResource VisibleSi}}">
            <StackPanel MaxWidth="{StaticResource Largeur.Etroite}" HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Niveaux}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Niveau}" Command="{Binding DataContext.ChoisirNiveauCommand, ElementName=Racine}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Titre}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" FontSize="{DynamicResource Taille.Meta}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Pinceau.TexteSecondaire}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Pas sûr ? Passer le test" Command="{Binding PasserLeTestCommand}" Style="{StaticResource BoutonFantome}"
                        HorizontalAlignment="Left" Margin="{StaticResource Marge.Haut.8}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
