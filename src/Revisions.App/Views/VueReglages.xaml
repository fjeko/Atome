<UserControl x:Class="Revisions.App.Views.VueReglages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Racine">
    <UserControl.Resources>
        <Style x:Key="Libelle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="Valeur" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="44" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Defilement" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="940" Margin="32,28,32,28">
            <TextBlock Text="Réglages" Style="{StaticResource Titre}" />
            <TextBlock Text="Chaque changement est enregistré tout de suite." Style="{StaticResource Discret}" Margin="0,4,0,0" />

            <Border Style="{StaticResource Carte}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Rythme" Style="{StaticResource SousTitre}" />

                    <TextBlock Text="Objectif minimal du jour (cartes)" Style="{StaticResource Libelle}" />
                    <TextBlock Text="Le nombre de cartes qui suffit pour réussir ta journée." Style="{StaticResource Discret}" FontSize="12" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ObjectifMinimal}" Style="{StaticResource Valeur}" />
                        <Slider Value="{Binding ObjectifMinimal}" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>

                    <TextBlock Text="Plafond quotidien (cartes)" Style="{StaticResource Libelle}" />
                    <TextBlock Text="Au-delà, l'application propose de s'arrêter." Style="{StaticResource Discret}" FontSize="12" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PlafondQuotidien}" Style="{StaticResource Valeur}" />
                        <Slider Value="{Binding PlafondQuotidien}" Minimum="10" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" />
                    </DockPanel>

                    <TextBlock Text="Nouvelles cartes par jour" Style="{StaticResource Libelle}" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding NouvellesParJour}" Style="{StaticResource Valeur}" />
                        <Slider Value="{Binding NouvellesParJour}" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Reprise après une pause" Style="{StaticResource SousTitre}" />

                    <TextBlock Text="Jours d'absence avant le mode reprise" Style="{StaticResource Libelle}" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding JoursAvantReprise}" Style="{StaticResource Valeur}" />
                        <Slider Value="{Binding JoursAvantReprise}" Minimum="3" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>

                    <TextBlock Text="Taille de la première session de reprise (cartes)" Style="{StaticResource Libelle}" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TailleReprise}" Style="{StaticResource Valeur}" />
                        <Slider Value="{Binding TailleReprise}" Minimum="5" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Mémorisation" Style="{StaticResource SousTitre}" />
                    <TextBlock Text="Réussite visée (%)" Style="{StaticResource Libelle}" />
                    <TextBlock Text="Plus c'est haut, plus les cartes reviennent souvent. 90 % est un bon équilibre."
                               Style="{StaticResource Discret}" FontSize="12" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Retention}" Style="{StaticResource Valeur}" />
                        <Slider Value="{Binding Retention}" Minimum="80" Maximum="95" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Personnalisation" Style="{StaticResource SousTitre}" />

                    <!-- Thèmes : chaque tuile est un aperçu (fond, feuille de lecture, accent). -->
                    <TextBlock Text="Thème" Style="{StaticResource Libelle}" />
                    <ItemsControl ItemsSource="{Binding Themes}" Margin="-5,6,-5,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ChoisirThemeCommand, ElementName=Racine}" CommandParameter="{Binding}"
                                        Margin="5" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="{Binding Nom}">
                                    <Border Width="132" Height="84" CornerRadius="8" Background="{Binding Fond}" BorderThickness="3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstChoisi}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Margin="9,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Background="{Binding Feuille}" CornerRadius="4" Margin="0,0,0,6">
                                                <Rectangle Fill="{Binding Accent}" Width="34" Height="10" RadiusX="3" RadiusY="3"
                                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7" />
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Nom}" Foreground="{Binding Texte}" FontSize="13" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Couleur d'accent : pastilles toutes faites, ou couleur libre. -->
                    <TextBlock Text="Couleur d'accent" Style="{StaticResource Libelle}" />
                    <TextBlock Text="Celle des boutons principaux, de la sélection et des barres de progression."
                               Style="{StaticResource Discret}" FontSize="12" />
                    <ItemsControl ItemsSource="{Binding Accents}" Margin="-4,6,-4,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ChoisirAccentCommand, ElementName=Racine}" CommandParameter="{Binding}"
                                        Margin="4" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{Binding Nom}">
                                    <Grid Width="38" Height="38">
                                        <!-- Anneau autour de la pastille choisie. -->
                                        <Ellipse StrokeThickness="2.5" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                                 Visibility="{Binding EstChoisi, Converter={StaticResource VisibleSi}}" />
                                        <Ellipse Margin="6" Fill="{Binding Hex}" />
                                        <!-- « Celle du thème » : pastille vide barrée d'un A. -->
                                        <Grid Visibility="{Binding EstAutomatique, Converter={StaticResource VisibleSi}}">
                                            <Ellipse Margin="6" StrokeThickness="1.5" Stroke="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="A" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Ou une couleur précise :" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Text="{Binding AccentLibre, UpdateSourceTrigger=PropertyChanged}" Width="120" MaxLength="7"
                                 ToolTip="Code de la couleur, par exemple #2F7DE1" />
                    </StackPanel>
                    <TextBlock Text="{Binding ErreurAccent}" Style="{StaticResource Discret}" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding ErreurAccent, Converter={StaticResource VisibleSi}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Dossiers" Style="{StaticResource SousTitre}" />

                    <TextBlock Text="Dossier des packs" Style="{StaticResource Libelle}" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Choisir…" Command="{Binding ChoisirDossierPacksCommand}" Padding="14,6" Margin="10,0,0,0" />
                        <TextBox Text="{Binding DossierPacks, Mode=OneWay}" IsReadOnly="True" />
                    </DockPanel>

                    <TextBlock Text="Dossier « Cours » (pour ouvrir les PDF d'origine)" Style="{StaticResource Libelle}" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Choisir…" Command="{Binding ChoisirDossierCoursCommand}" Padding="14,6" Margin="10,0,0,0" />
                        <TextBox Text="{Binding DossierCours, Mode=OneWay}" IsReadOnly="True" />
                    </DockPanel>

                    <TextBlock Text="Mes données (base et sauvegardes automatiques)" Style="{StaticResource Libelle}" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Ouvrir" Command="{Binding OuvrirDossierDonneesCommand}" Padding="14,6" Margin="10,0,0,0" />
                        <TextBox Text="{Binding DossierDonnees, Mode=OneWay}" IsReadOnly="True" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
