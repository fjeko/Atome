<UserControl x:Class="Revisions.App.Views.VueReglages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Libelle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="Valeur" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="44" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Margin="28,28,28,28">
            <TextBlock Text="Réglages" Style="{StaticResource Titre}" />
            <TextBlock Text="Chaque changement est enregistré tout de suite." Style="{StaticResource Discret}" Margin="0,4,0,0" />

            <Border Style="{StaticResource Carte}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Rythme" Style="{StaticResource SousTitre}" />

                    <TextBlock Text="Objectif minimal du jour (cartes)" Style="{StaticResource Libelle}" />
                    <TextBlock Text="Le nombre de cartes qui suffit pour réussir ta journée." Style="{StaticResource Discret}" FontSize="12" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ObjectifMinimal}" Style="{StaticResource Valeur}" />
                        <Slider Value="{Binding ObjectifMinimal}" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>

                    <TextBlock Text="Plafond quotidien (cartes)" Style="{StaticResource Libelle}" />
                    <TextBlock Text="Au-delà, l'application propose de s'arrêter." Style="{StaticResource Discret}" FontSize="12" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PlafondQuotidien}" Style="{StaticResource Valeur}" />
                        <Slider Value="{Binding PlafondQuotidien}" Minimum="10" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" />
                    </DockPanel>

                    <TextBlock Text="Nouvelles cartes par jour" Style="{StaticResource Libelle}" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding NouvellesParJour}" Style="{StaticResource Valeur}" />
                        <Slider Value="{Binding NouvellesParJour}" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Reprise après une pause" Style="{StaticResource SousTitre}" />

                    <TextBlock Text="Jours d'absence avant le mode reprise" Style="{StaticResource Libelle}" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding JoursAvantReprise}" Style="{StaticResource Valeur}" />
                        <Slider Value="{Binding JoursAvantReprise}" Minimum="3" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>

                    <TextBlock Text="Taille de la première session de reprise (cartes)" Style="{StaticResource Libelle}" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TailleReprise}" Style="{StaticResource Valeur}" />
                        <Slider Value="{Binding TailleReprise}" Minimum="5" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Mémorisation" Style="{StaticResource SousTitre}" />
                    <TextBlock Text="Réussite visée (%)" Style="{StaticResource Libelle}" />
                    <TextBlock Text="Plus c'est haut, plus les cartes reviennent souvent. 90 % est un bon équilibre."
                               Style="{StaticResource Discret}" FontSize="12" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Retention}" Style="{StaticResource Valeur}" />
                        <Slider Value="{Binding Retention}" Minimum="80" Maximum="95" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Apparence et dossiers" Style="{StaticResource SousTitre}" />

                    <TextBlock Text="Thème" Style="{StaticResource Libelle}" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" DisplayMemberPath="Libelle"
                              Width="220" HorizontalAlignment="Left" Margin="0,6,0,0" />

                    <TextBlock Text="Dossier des packs" Style="{StaticResource Libelle}" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Choisir…" Command="{Binding ChoisirDossierPacksCommand}" Padding="14,6" Margin="10,0,0,0" />
                        <TextBox Text="{Binding DossierPacks, Mode=OneWay}" IsReadOnly="True" />
                    </DockPanel>

                    <TextBlock Text="Dossier « Cours » (pour ouvrir les PDF d'origine)" Style="{StaticResource Libelle}" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Choisir…" Command="{Binding ChoisirDossierCoursCommand}" Padding="14,6" Margin="10,0,0,0" />
                        <TextBox Text="{Binding DossierCours, Mode=OneWay}" IsReadOnly="True" />
                    </DockPanel>

                    <TextBlock Text="Mes données (base et sauvegardes automatiques)" Style="{StaticResource Libelle}" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Ouvrir" Command="{Binding OuvrirDossierDonneesCommand}" Padding="14,6" Margin="10,0,0,0" />
                        <TextBox Text="{Binding DossierDonnees, Mode=OneWay}" IsReadOnly="True" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
