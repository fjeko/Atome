<UserControl x:Class="Revisions.App.Views.VueQuestionnaire"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Revisions.App.Views"
             xmlns:vm="clr-namespace:Revisions.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" Margin="32,28,32,28">
            <!-- La mascotte pose les questions. -->
            <v:BandeauMascotte Taille="112" HorizontalAlignment="Center" Margin="0,0,0,22"
                               Message="{Binding Message}" Expression="{Binding Expression}" />

            <!-- Étape 1 : « tu as déjà commencé cette matière ? » -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Visibility="{Binding EstQuestion, Converter={StaticResource VisibleSi}}">
                <Button Content="Oui" Command="{Binding OuiCommand}" Style="{DynamicResource AccentButtonStyle}"
                        FontSize="17" Padding="44,12" Margin="0,0,14,0" />
                <Button Content="Non, pas encore" Command="{Binding NonCommand}" FontSize="17" Padding="30,12" />
            </StackPanel>

            <!-- Étape 2 : où il en est dans chaque partie. -->
            <StackPanel Visibility="{Binding EstDetail, Converter={StaticResource VisibleSi}}">
                <CheckBox Content="Détailler jusqu'aux séances" IsChecked="{Binding Detailler}" Margin="0,0,0,10" />
                <Border Style="{StaticResource Carte}" Padding="18,12">
                    <ItemsControl ItemsSource="{Binding Lignes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding Retrait}" Height="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="136" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Titre}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Titre}" Margin="0,0,10,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ListesAcquis.Avancements}"
                                              SelectedIndex="{Binding Avancement, Mode=TwoWay}" Margin="0,0,8,0" MinWidth="108" />
                                    <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:ListesAcquis.Comprehensions}"
                                              SelectedIndex="{Binding Comprehension, Mode=TwoWay}" MinWidth="128" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Button Content="Suivant" Command="{Binding SuivantCommand}" Style="{DynamicResource AccentButtonStyle}"
                        FontSize="16" Padding="40,11" Margin="0,18,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Étape finale : récapitulatif. -->
            <StackPanel Visibility="{Binding EstRecap, Converter={StaticResource VisibleSi}}" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Recap}" TextWrapping="Wrap" FontSize="16" TextAlignment="Center" MaxWidth="560" />
                <Button Content="C'est parti !" Command="{Binding TerminerCommand}" Style="{DynamicResource AccentButtonStyle}"
                        FontSize="17" Padding="44,12" Margin="0,22,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- On peut tout laisser pour plus tard (et le refaire depuis « Mes acquis »). -->
            <Button Content="Plus tard" Command="{Binding PlusTardCommand}" Margin="0,26,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
