<UserControl x:Class="Revisions.App.Views.VueQuestionnaire"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Revisions.App.Views">
    <!-- Questionnaire de premier lancement : une seule question à la fois, que des gros boutons. -->
    <UserControl.Resources>
        <!-- Bouton de réponse : un titre et, en dessous, une courte explication. -->
        <Style x:Key="Reponse" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="22,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Margin="32,26,32,28">
            <!-- Repère discret : bloc et avancement dans le questionnaire. -->
            <TextBlock Text="{Binding Repere}" Style="{StaticResource Discret}" HorizontalAlignment="Center" Margin="0,0,0,6" />

            <!-- La mascotte pose les questions. -->
            <v:BandeauMascotte Taille="112" HorizontalAlignment="Center" Margin="0,0,0,22"
                               Message="{Binding Message}" Humeur="{Binding Humeur}" />

            <!-- Intro : partir de zéro ou non. -->
            <StackPanel Visibility="{Binding EstIntro, Converter={StaticResource VisibleSi}}">
                <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding PartirDeZeroCommand}" Padding="22,14" Margin="0,0,0,10"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="16">
                    <StackPanel>
                        <TextBlock Text="Oui, je pars de zéro" FontWeight="SemiBold" />
                        <TextBlock Text="C'est tout : on commence directement." FontSize="13" Opacity="0.8" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Reponse}" Command="{Binding DejaBosseCommand}">
                    <StackPanel>
                        <TextBlock Text="Non, j'ai déjà bossé certains cours" FontWeight="SemiBold" />
                        <TextBlock Text="Quelques questions rapides, matière par matière." FontSize="13" Opacity="0.7" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Une matière : où en es-tu ? -->
            <StackPanel Visibility="{Binding EstQuestion, Converter={StaticResource VisibleSi}}">
                <Button Style="{StaticResource Reponse}" Command="{Binding PasEncoreCommand}">
                    <TextBlock Text="Pas encore commencé" FontWeight="SemiBold" />
                </Button>
                <Button Style="{StaticResource Reponse}" Command="{Binding UnPeuCommand}">
                    <StackPanel>
                        <TextBlock Text="Un peu" FontWeight="SemiBold" />
                        <TextBlock Text="Je te montre jusqu'où je suis allé." FontSize="13" Opacity="0.7" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Reponse}" Command="{Binding ToutVuCommand}">
                    <TextBlock Text="J'ai tout vu" FontWeight="SemiBold" />
                </Button>
            </StackPanel>

            <!-- Jusqu'où : un clic sur la dernière partie vue. -->
            <StackPanel Visibility="{Binding EstJusqua, Converter={StaticResource VisibleSi}}">
                <ItemsControl ItemsSource="{Binding Parties}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Reponse}" Margin="0,0,0,6" Padding="18,9" FontSize="15"
                                    Command="{Binding DataContext.JusquIciCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Titre}" TextWrapping="Wrap" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Cours sans ordre (anglais…) : on coche ce qui a été vu. -->
            <StackPanel Visibility="{Binding EstChoix, Converter={StaticResource VisibleSi}}">
                <ItemsControl ItemsSource="{Binding Parties}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Coche, Mode=TwoWay}" Margin="0,0,0,4" FontSize="15">
                                <TextBlock Text="{Binding Titre}" TextWrapping="Wrap" />
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Valider" Command="{Binding ValiderChoixCommand}" Style="{DynamicResource AccentButtonStyle}"
                        FontSize="16" Padding="40,11" Margin="0,16,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Ressenti : une seule question pour tout ce qui a été vu. -->
            <StackPanel Visibility="{Binding EstRessenti, Converter={StaticResource VisibleSi}}">
                <Button Style="{StaticResource Reponse}" Command="{Binding RessentiCommand}" CommandParameter="1">
                    <StackPanel>
                        <TextBlock Text="Je découvre" FontWeight="SemiBold" />
                        <TextBlock Text="J'ai à peine regardé : je veux le revoir en premier." FontSize="13" Opacity="0.7" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Reponse}" Command="{Binding RessentiCommand}" CommandParameter="2">
                    <StackPanel>
                        <TextBlock Text="Fragile" FontWeight="SemiBold" />
                        <TextBlock Text="Je me souviens de peu : à revoir dans un jour ou deux." FontSize="13" Opacity="0.7" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Reponse}" Command="{Binding RessentiCommand}" CommandParameter="3">
                    <StackPanel>
                        <TextBlock Text="Correct" FontWeight="SemiBold" />
                        <TextBlock Text="Ça va, il me faut juste des rappels : dans environ une semaine." FontSize="13" Opacity="0.7" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Reponse}" Command="{Binding RessentiCommand}" CommandParameter="4">
                    <StackPanel>
                        <TextBlock Text="Solide" FontWeight="SemiBold" />
                        <TextBlock Text="Je maîtrise : un simple rappel dans environ trois semaines." FontSize="13" Opacity="0.7" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Récapitulatif. -->
            <StackPanel Visibility="{Binding EstRecap, Converter={StaticResource VisibleSi}}" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Recap}" TextWrapping="Wrap" FontSize="16" TextAlignment="Center" />
                <Button Content="C'est parti !" Command="{Binding TerminerCommand}" Style="{DynamicResource AccentButtonStyle}"
                        FontSize="17" Padding="44,12" Margin="0,22,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- On peut tout laisser pour plus tard (et le refaire depuis « Mes acquis »). -->
            <Button Content="Plus tard" Command="{Binding PlusTardCommand}" Margin="0,18,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
