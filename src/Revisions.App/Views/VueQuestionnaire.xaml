<UserControl x:Class="Revisions.App.Views.VueQuestionnaire"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Revisions.App.Views"
             xmlns:ds="clr-namespace:Revisions.App.Controles">
    <!-- Questionnaire de premier lancement : une seule question à la fois, que des gros boutons. -->
    <UserControl.Resources>
        <!-- Bouton de réponse : un titre et, en dessous, une courte explication. -->
        <Style x:Key="Reponse" TargetType="Button" BasedOn="{StaticResource BoutonSecondaire}">
            <Setter Property="Padding" Value="{StaticResource Remplissage.Compact}" />
            <Setter Property="ds:Forme.Rayon" Value="{StaticResource Rayon.Carte}" />
            <Setter Property="Margin" Value="{StaticResource Marge.Bas.8}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="{DynamicResource Taille.Corps}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource Largeur.Etroite}" Margin="{StaticResource Marge.Ecran}">
            <!-- Repère discret : bloc et avancement dans le questionnaire. -->
            <TextBlock Text="{Binding Repere}" Style="{StaticResource Texte.Meta}" HorizontalAlignment="Center" Margin="{StaticResource Marge.Bas.8}" />

            <!-- La mascotte pose les questions. -->
            <v:BandeauMascotte Taille="104" HorizontalAlignment="Center" Margin="{StaticResource Marge.Bas.24}"
                               Message="{Binding Message}" Humeur="{Binding Humeur}" />

            <!-- Intro : partir de zéro ou non. -->
            <StackPanel Visibility="{Binding EstIntro, Converter={StaticResource VisibleSi}}">
                <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding PartirDeZeroCommand}" Padding="{StaticResource Remplissage.Compact}" Margin="{StaticResource Marge.Bas.8}" ds:Forme.Rayon="{StaticResource Rayon.Carte}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Oui, je pars de zéro" FontWeight="SemiBold" />
                        <TextBlock Text="C'est tout : on commence directement." FontSize="{DynamicResource Taille.Meta}" FontWeight="Normal" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Reponse}" Command="{Binding DejaBosseCommand}">
                    <StackPanel>
                        <TextBlock Text="Non, j'ai déjà bossé certains cours" FontWeight="SemiBold" />
                        <TextBlock Text="Quelques questions rapides, matière par matière." FontSize="{DynamicResource Taille.Meta}" Foreground="{DynamicResource Pinceau.TexteSecondaire}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Une matière : où en es-tu ? -->
            <StackPanel Visibility="{Binding EstQuestion, Converter={StaticResource VisibleSi}}">
                <Button Style="{StaticResource Reponse}" Command="{Binding PasEncoreCommand}">
                    <TextBlock Text="Pas encore commencé" FontWeight="SemiBold" />
                </Button>
                <Button Style="{StaticResource Reponse}" Command="{Binding UnPeuCommand}">
                    <StackPanel>
                        <TextBlock Text="Un peu" FontWeight="SemiBold" />
                        <TextBlock Text="Je te montre jusqu'où je suis allé." FontSize="{DynamicResource Taille.Meta}" Foreground="{DynamicResource Pinceau.TexteSecondaire}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Reponse}" Command="{Binding ToutVuCommand}">
                    <TextBlock Text="J'ai tout vu" FontWeight="SemiBold" />
                </Button>
            </StackPanel>

            <!-- Jusqu'où : un clic sur la dernière partie vue. -->
            <StackPanel Visibility="{Binding EstJusqua, Converter={StaticResource VisibleSi}}">
                <ItemsControl ItemsSource="{Binding Parties}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Reponse}"
                                    Command="{Binding DataContext.JusquIciCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Titre}" TextWrapping="Wrap" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Cours sans ordre (anglais…) : on coche ce qui a été vu. -->
            <StackPanel Visibility="{Binding EstChoix, Converter={StaticResource VisibleSi}}">
                <ItemsControl ItemsSource="{Binding Parties}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Coche, Mode=TwoWay}" Margin="{StaticResource Marge.Bas.8}" FontSize="{DynamicResource Taille.Corps}">
                                <TextBlock Text="{Binding Titre}" TextWrapping="Wrap" />
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Valider" Command="{Binding ValiderChoixCommand}" Style="{StaticResource BoutonPrincipal}"
                        Margin="{StaticResource Marge.Haut.16}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Ressenti : une seule question pour tout ce qui a été vu. -->
            <StackPanel Visibility="{Binding EstRessenti, Converter={StaticResource VisibleSi}}">
                <Button Style="{StaticResource Reponse}" Command="{Binding RessentiCommand}" CommandParameter="1">
                    <StackPanel>
                        <TextBlock Text="Je découvre" FontWeight="SemiBold" />
                        <TextBlock Text="J'ai à peine regardé : je veux le revoir en premier." FontSize="{DynamicResource Taille.Meta}" Foreground="{DynamicResource Pinceau.TexteSecondaire}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Reponse}" Command="{Binding RessentiCommand}" CommandParameter="2">
                    <StackPanel>
                        <TextBlock Text="Fragile" FontWeight="SemiBold" />
                        <TextBlock Text="Je me souviens de peu : à revoir dans un jour ou deux." FontSize="{DynamicResource Taille.Meta}" Foreground="{DynamicResource Pinceau.TexteSecondaire}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Reponse}" Command="{Binding RessentiCommand}" CommandParameter="3">
                    <StackPanel>
                        <TextBlock Text="Correct" FontWeight="SemiBold" />
                        <TextBlock Text="Ça va, il me faut juste des rappels : dans environ une semaine." FontSize="{DynamicResource Taille.Meta}" Foreground="{DynamicResource Pinceau.TexteSecondaire}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Reponse}" Command="{Binding RessentiCommand}" CommandParameter="4">
                    <StackPanel>
                        <TextBlock Text="Solide" FontWeight="SemiBold" />
                        <TextBlock Text="Je maîtrise : un simple rappel dans environ trois semaines." FontSize="{DynamicResource Taille.Meta}" Foreground="{DynamicResource Pinceau.TexteSecondaire}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Récapitulatif. -->
            <StackPanel Visibility="{Binding EstRecap, Converter={StaticResource VisibleSi}}" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Recap}" Style="{StaticResource Texte.Corps}" TextAlignment="Center" />
                <Button Content="C'est parti !" Command="{Binding TerminerCommand}" Style="{StaticResource BoutonHeros}"
                        Margin="{StaticResource Marge.Haut.24}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- On peut tout laisser pour plus tard (et le refaire depuis « Mes acquis »). -->
            <Button Content="Plus tard" Command="{Binding PlusTardCommand}" Style="{StaticResource BoutonFantome}" Margin="{StaticResource Marge.Haut.16}" HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
