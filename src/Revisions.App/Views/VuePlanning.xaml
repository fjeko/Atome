<UserControl x:Class="Revisions.App.Views.VuePlanning"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="28,28,28,24" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid>
                <TextBlock Text="Planning" Style="{StaticResource Titre}" />
                <Button Content="Importer un planning…" Command="{Binding ImporterCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Style="{StaticResource Discret}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="La proposition de planning du CNED, pour te repérer. Ce n'est pas une obligation : tu avances à ton rythme. Quand tu le suis, les nouvelles cartes viennent d'abord de ce qui est au programme, et le contenu d'un devoir proche est révisé un peu plus." />
            <TextBlock Text="{Binding MessageImport}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding MessageImport, Converter={StaticResource VisibleSi}}" />

            <!-- Aucun planning : l'application fonctionne comme avant. -->
            <Border Style="{StaticResource Carte}" Margin="0,18,0,0" Visibility="{Binding SansPlanning, Converter={StaticResource VisibleSi}}">
                <TextBlock TextWrapping="Wrap"
                           Text="Aucun planning pour l'instant. Place un fichier de planning dans le dossier « planning » (à côté du dossier « packs »), ou importe-le avec le bouton ci-dessus. Sans planning, les nouvelles cartes suivent simplement l'ordre du cours." />
            </Border>

            <StackPanel Visibility="{Binding APlanning, Converter={StaticResource VisibleSi}}">
                <Border Style="{StaticResource Carte}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Source}" Style="{StaticResource Discret}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,10" />
                        <CheckBox Content="Suivre le planning" IsChecked="{Binding Suivre}" />
                        <CheckBox Content="Masquer les quiz d'auto-évaluation" IsChecked="{Binding MasquerQuiz}" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Discret}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Dans les frises : la période en cours est colorée, les barres plus pâles ont des dates à confirmer, la barre verticale marque aujourd'hui. Survole une barre pour voir ses dates." />
                        <Button Content="Remettre toutes les dates du fichier" Command="{Binding ReinitialiserDatesCommand}"
                                HorizontalAlignment="Left" Padding="12,5" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Points à vérifier dans le fichier. -->
                <Expander Header="Points à vérifier dans le fichier" Margin="0,12,0,0"
                          Visibility="{Binding AAvertissements, Converter={StaticResource VisibleSi}}">
                    <ItemsControl ItemsSource="{Binding Avertissements}" Margin="8,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Style="{StaticResource Discret}" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- Une carte par matière : interrupteur, frise, puis les dates modifiables. -->
                <ItemsControl ItemsSource="{Binding Matieres}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Carte}" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Nom}" Style="{StaticResource SousTitre}" />
                                        <CheckBox Content="Suivre cette matière" IsChecked="{Binding Suivie}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Frise : mois, périodes, devoirs, et la ligne d'aujourd'hui. -->
                                    <Canvas Width="760" Height="{Binding HauteurFrise}" HorizontalAlignment="Left" Margin="0,22,0,6" ClipToBounds="False">
                                        <ItemsControl ItemsSource="{Binding DataContext.Mois, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Gauche}" />
                                                    <Setter Property="Canvas.Top" Value="-20" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="1" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas, AncestorLevel=2}}" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,3,0" />
                                                        <TextBlock Text="{Binding Nom}" FontSize="11" Style="{StaticResource Discret}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Periodes}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Gauche}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Haut}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Largeur}" Height="22" CornerRadius="4" ToolTip="{Binding Bulle}"
                                                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EnCours}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding AConfirmer}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.75" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Libelle}" FontSize="11" Margin="5,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EnCours}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Devoirs}" Canvas.Top="{Binding HauteurPeriodes}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Gauche}" />
                                                    <Setter Property="Visibility" Value="{Binding Visible, Converter={StaticResource VisibleSi}}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Bulle}">
                                                        <Path Data="M 5,0 L 10,8 L 0,8 Z" Fill="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Code}" FontSize="11" Margin="2,0,0,0" Style="{StaticResource Discret}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Rectangle Width="2" Height="{Binding HauteurFrise}" Fill="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.6"
                                                   Canvas.Left="{Binding DataContext.PositionAujourdhui, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   ToolTip="Aujourd'hui" />
                                    </Canvas>

                                    <!-- Dates modifiables. -->
                                    <Expander Header="Changer les dates" Margin="0,8,0,0">
                                        <StackPanel Margin="0,6,0,0">
                                            <ItemsControl ItemsSource="{Binding Periodes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="300" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding Libelle}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding InfoConfirmer}" Style="{StaticResource Discret}" FontSize="12"
                                                                           Visibility="{Binding AConfirmer, Converter={StaticResource VisibleSi}}" />
                                                            </StackPanel>
                                                            <DatePicker Grid.Column="1" SelectedDate="{Binding Debut}" Margin="0,0,8,0" ToolTip="Début" />
                                                            <DatePicker Grid.Column="2" SelectedDate="{Binding Fin}" Margin="0,0,8,0" ToolTip="Fin" />
                                                            <Button Grid.Column="3" Content="Dates du fichier" Command="{Binding ReinitialiserCommand}"
                                                                    HorizontalAlignment="Left" Padding="10,4"
                                                                    Visibility="{Binding Modifiee, Converter={StaticResource VisibleSi}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Devoirs}" Margin="0,8,0,0">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Visibility" Value="{Binding Visible, Converter={StaticResource VisibleSi}}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="300" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                                <TextBlock TextWrapping="Wrap"><Run Text="{Binding Type, Mode=OneWay}" /> <Run Text="{Binding Code, Mode=OneWay}" /></TextBlock>
                                                                <TextBlock Text="{Binding Remarque}" Style="{StaticResource Discret}" FontSize="12" TextWrapping="Wrap"
                                                                           Visibility="{Binding Remarque, Converter={StaticResource VisibleSi}}" />
                                                            </StackPanel>
                                                            <DatePicker Grid.Column="1" SelectedDate="{Binding Semaine}" Margin="0,0,8,0" ToolTip="Un jour de la semaine du devoir" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Texte}" Style="{StaticResource Discret}" VerticalAlignment="Center" />
                                                            <Button Grid.Column="3" Content="Date du fichier" Command="{Binding ReinitialiserCommand}"
                                                                    HorizontalAlignment="Left" Padding="10,4"
                                                                    Visibility="{Binding Modifie, Converter={StaticResource VisibleSi}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
