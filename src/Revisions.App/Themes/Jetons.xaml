<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Jetons du système de design (docs/design-atome.md, section 1).
        Les couleurs (« Pinceau.* », « Ton.* ») et les tailles de texte (« Taille.* ») sont posées par
        Services/ServiceTheme.cs, selon le thème et la taille du texte choisis. Ici : tout ce qui est fixe.
        Aucun écran ne contient de couleur, de taille ou de marge en dur : il utilise ces jetons.
    -->


    <!-- Logo Discord (Clyde), tracé vectoriel sur une grille 24×24. Usage : renvoyer vers le serveur Discord d'Atome
         (autorisé par les règles de marque de Discord). Couleur officielle : blurple #5865F2. -->
    <Geometry x:Key="Logo.Discord">M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z</Geometry>
    <SolidColorBrush x:Key="Pinceau.Discord" Color="#5865F2" />
    <!-- Polices : Segoe UI Variable (Windows 11), Sitka pour le salut et les titres de cours, Segoe Fluent Icons. -->
    <FontFamily x:Key="Police.Interface">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Police.Titres">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Police.Empattements">Sitka Heading, Sitka Text, Georgia</FontFamily>
    <FontFamily x:Key="Police.Icones">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Police.Code">Cascadia Code, Consolas</FontFamily>

    <!-- Rayons : 8 contrôles, 12 cartes, 16 tuiles et bouton principal. -->
    <CornerRadius x:Key="Rayon.Controle">8</CornerRadius>
    <CornerRadius x:Key="Rayon.Carte">12</CornerRadius>
    <CornerRadius x:Key="Rayon.Tuile">16</CornerRadius>
    <CornerRadius x:Key="Rayon.Pilule">999</CornerRadius>

    <!-- Espaces : grille de 4 px, marges de 8, 12, 16, 24 et 32. -->
    <sys:Double x:Key="Espace.4">4</sys:Double>
    <sys:Double x:Key="Espace.8">8</sys:Double>
    <sys:Double x:Key="Espace.12">12</sys:Double>
    <sys:Double x:Key="Espace.16">16</sys:Double>
    <sys:Double x:Key="Espace.24">24</sys:Double>
    <sys:Double x:Key="Espace.32">32</sys:Double>
    <!-- Espace entre deux colonnes de cartes. -->
    <GridLength x:Key="Gouttiere">16</GridLength>

    <!-- Marges toutes faites (haut, droite, gauche…), pour ne jamais écrire de chiffres dans les écrans. -->
    <Thickness x:Key="Marge.Haut.4">0,4,0,0</Thickness>
    <Thickness x:Key="Marge.Haut.8">0,8,0,0</Thickness>
    <Thickness x:Key="Marge.Haut.12">0,12,0,0</Thickness>
    <Thickness x:Key="Marge.Haut.16">0,16,0,0</Thickness>
    <Thickness x:Key="Marge.Haut.24">0,24,0,0</Thickness>
    <Thickness x:Key="Marge.Haut.32">0,32,0,0</Thickness>
    <Thickness x:Key="Marge.Bas.4">0,0,0,4</Thickness>
    <Thickness x:Key="Marge.Bas.8">0,0,0,8</Thickness>
    <Thickness x:Key="Marge.Bas.12">0,0,0,12</Thickness>
    <Thickness x:Key="Marge.Bas.16">0,0,0,16</Thickness>
    <Thickness x:Key="Marge.Bas.24">0,0,0,24</Thickness>
    <Thickness x:Key="Marge.Droite.4">0,0,4,0</Thickness>
    <Thickness x:Key="Marge.Droite.8">0,0,8,0</Thickness>
    <Thickness x:Key="Marge.Droite.12">0,0,12,0</Thickness>
    <Thickness x:Key="Marge.Droite.16">0,0,16,0</Thickness>
    <Thickness x:Key="Marge.Droite.24">0,0,24,0</Thickness>
    <Thickness x:Key="Marge.Gauche.8">8,0,0,0</Thickness>
    <Thickness x:Key="Marge.Gauche.12">12,0,0,0</Thickness>
    <Thickness x:Key="Marge.Gauche.4">4,0,0,0</Thickness>
    <Thickness x:Key="Marge.Gauche.16">16,0,0,0</Thickness>
    <Thickness x:Key="Marge.Gauche.24">24,0,0,0</Thickness>
    <Thickness x:Key="Marge.Gauche.32">32,0,0,0</Thickness>
    <Thickness x:Key="Marge.Tuile">0,0,16,16</Thickness>
    <!-- Marges de l'écran : le contenu est centré, avec une largeur maximale lisible. -->
    <Thickness x:Key="Marge.Ecran">32,28,32,32</Thickness>
    <Thickness x:Key="Marge.Navigation">32,28,32,0</Thickness>
    <Thickness x:Key="Remplissage.Carte">24</Thickness>
    <Thickness x:Key="Remplissage.CarteLarge">32,28</Thickness>
    <Thickness x:Key="Remplissage.Compact">16,12</Thickness>
    <Thickness x:Key="Remplissage.Tuile">20,18</Thickness>
    <Thickness x:Key="Remplissage.Bouton">16,8</Thickness>
    <Thickness x:Key="Remplissage.BoutonPrincipal">24,12</Thickness>
    <Thickness x:Key="Remplissage.BoutonHeros">36,16</Thickness>
    <Thickness x:Key="Remplissage.Pastille">8,2</Thickness>

    <!-- Largeurs maximales du contenu centré. -->
    <sys:Double x:Key="Largeur.Contenu">980</sys:Double>
    <sys:Double x:Key="Largeur.Etroite">720</sys:Double>
    <sys:Double x:Key="Largeur.Lecture">760</sys:Double>
    <sys:Double x:Key="Largeur.Bulle">520</sys:Double>
    <sys:Double x:Key="Largeur.Tuile">228</sys:Double>
    <sys:Double x:Key="Hauteur.Barre">8</sys:Double>
    <!-- Case de saisie d'un nombre (grille du TD en groupe) : « -12,75 » tient sans être coupé ;
         6 colonnes passent encore dans une fenêtre de 960 px. -->
    <sys:Double x:Key="Largeur.CaseNombre">104</sys:Double>
    <sys:Double x:Key="Hauteur.CaseNombre">40</sys:Double>
    <Thickness x:Key="Remplissage.CaseNombre">8,4</Thickness>
    <!-- Colonne des réponses du TD en groupe : une grille de 4 colonnes y tient ; les choix passent à la ligne. -->
    <sys:Double x:Key="Largeur.ZoneReponse">520</sys:Double>

    <!-- Panneau de la calculatrice (colonne à droite de l.exercice, sans le masquer). -->
    <sys:Double x:Key="Largeur.Calculatrice">380</sys:Double>

    <!-- Écran Réglages : colonne de navigation, largeur d'un contrôle aligné à droite (curseur, champ, liste), largeur de la valeur chiffrée. -->
    <sys:Double x:Key="Largeur.ControleReglage">240</sys:Double>
    <sys:Double x:Key="Largeur.ValeurReglage">56</sys:Double>
    <sys:Double x:Key="Largeur.SaisieCourte">120</sys:Double>

    <!-- Durées : 150 ms pour les survols et changements d'état. -->
    <Duration x:Key="Duree.Survol">0:0:0.15</Duration>

    <!-- Ombre très douce, réservée aux éléments flottants (dialogues, bandeaux, toasts). -->
    <DropShadowEffect x:Key="Ombre.Flottante" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.18" Color="Black" />
    <DropShadowEffect x:Key="Ombre.Legere" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.10" Color="Black" />
</ResourceDictionary>
