<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ds="clr-namespace:Revisions.App.Controles">
    <!--
        Styles de base du système de design : textes, cartes, boutons, pastilles, barres, interrupteur, navigation.
        Chaque style n'existe qu'une fois et sert partout (docs/design-atome.md, section 2).
    -->

    <!-- ===== Focus clavier : toujours visible (section 6). ===== -->
    <Style x:Key="FocusVisible">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Pinceau.AccentTrait}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Textes ===== -->
    <Style x:Key="Texte.Base" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Pinceau.Texte}" />
        <Setter Property="FontSize" Value="{DynamicResource Taille.Interface}" />
    </Style>
    <!-- 12 : métadonnées. -->
    <Style x:Key="Texte.Meta" TargetType="TextBlock" BasedOn="{StaticResource Texte.Base}">
        <Setter Property="FontSize" Value="{DynamicResource Taille.Meta}" />
        <Setter Property="Foreground" Value="{DynamicResource Pinceau.TexteDiscret}" />
    </Style>
    <!-- 14 : interface, en couleur secondaire (explications sous un titre). -->
    <Style x:Key="Texte.Secondaire" TargetType="TextBlock" BasedOn="{StaticResource Texte.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Pinceau.TexteSecondaire}" />
    </Style>
    <!-- 16 : corps et cartes. -->
    <Style x:Key="Texte.Corps" TargetType="TextBlock" BasedOn="{StaticResource Texte.Base}">
        <Setter Property="FontSize" Value="{DynamicResource Taille.Corps}" />
    </Style>
    <Style x:Key="Texte.Fort" TargetType="TextBlock" BasedOn="{StaticResource Texte.Base}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 18 : sous-titres. -->
    <Style x:Key="Texte.SousTitre" TargetType="TextBlock" BasedOn="{StaticResource Texte.Base}">
        <Setter Property="FontSize" Value="{DynamicResource Taille.SousTitre}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 22 : titres d'écran. -->
    <Style x:Key="Texte.Titre" TargetType="TextBlock" BasedOn="{StaticResource Texte.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource Police.Titres}" />
        <Setter Property="FontSize" Value="{DynamicResource Taille.Titre}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Titres de cours, à empattements (Sitka). -->
    <Style x:Key="Texte.TitreCours" TargetType="TextBlock" BasedOn="{StaticResource Texte.Titre}">
        <Setter Property="FontFamily" Value="{DynamicResource Police.Empattements}" />
    </Style>
    <!-- Salut de l'accueil, à empattements. -->
    <Style x:Key="Texte.Salut" TargetType="TextBlock" BasedOn="{StaticResource Texte.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource Police.Empattements}" />
        <Setter Property="FontSize" Value="{DynamicResource Taille.Salut}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 40 : chiffre du jour. -->
    <Style x:Key="Texte.Chiffre" TargetType="TextBlock" BasedOn="{StaticResource Texte.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource Police.Titres}" />
        <Setter Property="FontSize" Value="{DynamicResource Taille.Chiffre}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- Icône (police Segoe Fluent Icons). Les icônes seules ont toujours un nom accessible. -->
    <Style x:Key="Texte.Icone" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Police.Icones}" />
        <Setter Property="FontSize" Value="{DynamicResource Taille.Icone}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="Texte.Lien" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource Pinceau.AccentTexte}" />
        <Setter Property="TextDecorations" Value="None" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Surfaces ===== -->
    <!-- CarteSurface : bloc posé sur la page. -->
    <Style x:Key="CarteSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Pinceau.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Pinceau.Bordure}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Rayon.Carte}" />
        <Setter Property="Padding" Value="{StaticResource Remplissage.Carte}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- Carte posée au-dessus du reste (dialogue, menu) : surface surélevée et ombre très douce. -->
    <Style x:Key="CarteFlottante" TargetType="Border" BasedOn="{StaticResource CarteSurface}">
        <Setter Property="Background" Value="{DynamicResource Pinceau.Surelevee}" />
        <Setter Property="Effect" Value="{StaticResource Ombre.Flottante}" />
    </Style>
    <!-- Encadré coloré par un ton (ds:Ton.Nom ou ds:Ton.Matiere sur le même élément). -->
    <Style x:Key="EncadreTon" TargetType="Border">
        <Setter Property="Background" Value="{Binding (ds:Ton.Pale), RelativeSource={RelativeSource Self}}" />
        <Setter Property="CornerRadius" Value="{StaticResource Rayon.Carte}" />
        <Setter Property="Padding" Value="{StaticResource Remplissage.Compact}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Pinceau.Texte}" />
    </Style>
    <Style x:Key="Separateur" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Pinceau.Bordure}" />
        <Setter Property="Margin" Value="0,16" />
    </Style>

    <!-- Anciens noms (écrans pas encore relookés) : mêmes jetons. -->
    <Style x:Key="Carte" TargetType="Border" BasedOn="{StaticResource CarteSurface}" />
    <Style x:Key="Titre" TargetType="TextBlock" BasedOn="{StaticResource Texte.Titre}" />
    <Style x:Key="SousTitre" TargetType="TextBlock" BasedOn="{StaticResource Texte.SousTitre}" />
    <Style x:Key="Discret" TargetType="TextBlock" BasedOn="{StaticResource Texte.Secondaire}" />

    <!-- ===== Boutons ===== -->
    <!-- Modèle commun : fond, voile de survol (fondu de 150 ms), voile d'appui, icône facultative, raccourci facultatif. -->
    <ControlTemplate x:Key="Modele.Bouton" TargetType="ButtonBase">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Fond" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{Binding (ds:Forme.Rayon), RelativeSource={RelativeSource TemplatedParent}}" />
            <Border x:Name="Voile" Background="{DynamicResource Pinceau.Voile}" Opacity="0"
                    CornerRadius="{Binding (ds:Forme.Rayon), RelativeSource={RelativeSource TemplatedParent}}" />
            <Border x:Name="Appui" Background="{DynamicResource Pinceau.Voile}" Visibility="Collapsed"
                    CornerRadius="{Binding (ds:Forme.Rayon), RelativeSource={RelativeSource TemplatedParent}}" />
            <Grid Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Icone" Style="{StaticResource Texte.Icone}" Margin="{StaticResource Marge.Droite.8}"
                           Text="{Binding (ds:Forme.Icone), RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter Grid.Column="1" RecognizesAccessKey="True" VerticalAlignment="Center" />
                <Border x:Name="Raccourci" Grid.Column="2" Margin="{StaticResource Marge.Gauche.12}" Padding="6,0"
                        CornerRadius="4" BorderThickness="1" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                        Opacity="0.75" VerticalAlignment="Center">
                    <TextBlock Text="{Binding (ds:Forme.Raccourci), RelativeSource={RelativeSource TemplatedParent}}"
                               FontSize="{DynamicResource Taille.Meta}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="ds:Forme.Icone" Value="{x:Null}">
                <Setter TargetName="Icone" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Icone" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="ds:Forme.Raccourci" Value="{x:Null}">
                <Setter TargetName="Raccourci" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Voile" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Duree.Survol}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Voile" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Duree.Survol}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Appui" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Bouton.Base" TargetType="ButtonBase">
        <Setter Property="Template" Value="{StaticResource Modele.Bouton}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisible}" />
        <Setter Property="FontFamily" Value="{DynamicResource Police.Interface}" />
        <Setter Property="FontSize" Value="{DynamicResource Taille.Interface}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Pinceau.Texte}" />
        <Setter Property="Padding" Value="{StaticResource Remplissage.Bouton}" />
        <Setter Property="ds:Forme.Rayon" Value="{StaticResource Rayon.Controle}" />
    </Style>

    <!-- BoutonPrincipal : l'action principale, un seul par écran. -->
    <Style x:Key="BoutonPrincipal" TargetType="ButtonBase" BasedOn="{StaticResource Bouton.Base}">
        <Setter Property="Background" Value="{DynamicResource Pinceau.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Pinceau.SurAccent}" />
        <Setter Property="FontSize" Value="{DynamicResource Taille.Corps}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="{StaticResource Remplissage.BoutonPrincipal}" />
        <Setter Property="ds:Forme.Rayon" Value="{StaticResource Rayon.Tuile}" />
    </Style>
    <!-- Le gros bouton d'action de l'accueil. -->
    <Style x:Key="BoutonHeros" TargetType="ButtonBase" BasedOn="{StaticResource BoutonPrincipal}">
        <Setter Property="FontSize" Value="{DynamicResource Taille.SousTitre}" />
        <Setter Property="Padding" Value="{StaticResource Remplissage.BoutonHeros}" />
    </Style>
    <!-- BoutonSecondaire : les autres actions. -->
    <Style x:Key="BoutonSecondaire" TargetType="ButtonBase" BasedOn="{StaticResource Bouton.Base}">
        <Setter Property="Background" Value="{DynamicResource Pinceau.Controle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Pinceau.Bordure}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- BoutonFantome : action discrète, sans fond (lien, « Retour »). -->
    <Style x:Key="BoutonFantome" TargetType="ButtonBase" BasedOn="{StaticResource Bouton.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Pinceau.AccentTexte}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <!-- Bouton fantôme neutre (texte normal) : liste d'éléments cliquables. -->
    <Style x:Key="BoutonListe" TargetType="ButtonBase" BasedOn="{StaticResource Bouton.Base}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource Remplissage.Compact}" />
    </Style>
    <!-- Icône seule : toujours avec AutomationProperties.Name et une infobulle. -->
    <Style x:Key="BoutonIcone" TargetType="ButtonBase" BasedOn="{StaticResource Bouton.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Pinceau.TexteSecondaire}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
    </Style>

    <!-- Boutons de note : couleur ET texte (jamais la couleur seule). Raté, Difficile, Bien, Facile. -->
    <Style x:Key="BoutonNote" TargetType="ButtonBase" BasedOn="{StaticResource Bouton.Base}">
        <Setter Property="Background" Value="{Binding (ds:Ton.Pale), RelativeSource={RelativeSource Self}}" />
        <Setter Property="Foreground" Value="{Binding (ds:Ton.Texte), RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderBrush" Value="{Binding (ds:Ton.Trait), RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource Taille.Corps}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="ds:Forme.Rayon" Value="{StaticResource Rayon.Carte}" />
    </Style>
    <Style x:Key="BoutonRate" TargetType="ButtonBase" BasedOn="{StaticResource BoutonNote}">
        <Setter Property="ds:Ton.Nom" Value="Erreur" />
    </Style>
    <Style x:Key="BoutonDifficile" TargetType="ButtonBase" BasedOn="{StaticResource BoutonNote}">
        <Setter Property="ds:Ton.Nom" Value="Attention" />
    </Style>
    <Style x:Key="BoutonBien" TargetType="ButtonBase" BasedOn="{StaticResource BoutonNote}">
        <Setter Property="ds:Ton.Nom" Value="Succes" />
    </Style>
    <Style x:Key="BoutonFacile" TargetType="ButtonBase" BasedOn="{StaticResource BoutonNote}">
        <Setter Property="ds:Ton.Nom" Value="Facile" />
    </Style>

    <!-- Boutons « bascule » (filtres, choix d'un onglet) : coché = ton accent. -->
    <Style x:Key="BoutonBascule" TargetType="ToggleButton" BasedOn="{StaticResource BoutonSecondaire}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ton.Info.Pale}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Ton.Info.Trait}" />
                <Setter Property="Foreground" Value="{DynamicResource Ton.Info.Texte}" />
                <!-- Pas la couleur seule : une coche dit aussi « actif ». -->
                <Setter Property="ds:Forme.Icone" Value="{x:Static ds:Icones.Coche}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tous les boutons sans style précis prennent le style secondaire ; « AccentButtonStyle » (Fluent) devient le principal. -->
    <Style TargetType="Button" BasedOn="{StaticResource BoutonSecondaire}" />
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BoutonPrincipal}" />

    <!-- ===== Pastilles et badges ===== -->
    <!-- Pastille : puce de matière (ds:Ton.Matiere) ou de statut (ds:Ton.Nom). -->
    <Style x:Key="Pastille" TargetType="Border">
        <Setter Property="Background" Value="{Binding (ds:Ton.Pale), RelativeSource={RelativeSource Self}}" />
        <Setter Property="TextElement.Foreground" Value="{Binding (ds:Ton.Texte), RelativeSource={RelativeSource Self}}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource Taille.Meta}" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource Rayon.Pilule}" />
        <Setter Property="Padding" Value="{StaticResource Remplissage.Pastille}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Pastille sans couleur (compteur, information neutre). -->
    <Style x:Key="PastilleNeutre" TargetType="Border" BasedOn="{StaticResource Pastille}">
        <Setter Property="Background" Value="{DynamicResource Pinceau.Controle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Pinceau.TexteSecondaire}" />
    </Style>
    <!-- BadgeLibre : cours libres intégrés (contour, pour se distinguer d'une pastille de matière). -->
    <Style x:Key="BadgeLibre" TargetType="Border" BasedOn="{StaticResource Pastille}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ton.Succes.Trait}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Ton.Succes.Texte}" />
        <Setter Property="ToolTip" Value="Cours libre intégré à Atome (licence CC BY-SA 4.0)" />
    </Style>

    <!-- ===== BarreProgression ===== -->
    <Style x:Key="BarreProgression" TargetType="ProgressBar">
        <Setter Property="Height" Value="{StaticResource Hauteur.Barre}" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Pinceau.AccentTrait}" />
        <Setter Property="Background" Value="{DynamicResource Pinceau.Voile}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="4" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Barre aux couleurs d'un ton (matière). -->
    <Style x:Key="BarreTon" TargetType="ProgressBar" BasedOn="{StaticResource BarreProgression}">
        <Setter Property="Foreground" Value="{Binding (ds:Ton.Trait), RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style TargetType="ProgressBar" BasedOn="{StaticResource BarreProgression}" />

    <!-- ===== Interrupteur (case à cocher en forme de bascule, pour les réglages) ===== -->
    <Style x:Key="Interrupteur" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisible}" />
        <Setter Property="Foreground" Value="{DynamicResource Pinceau.Texte}" />
        <Setter Property="FontSize" Value="{DynamicResource Taille.Interface}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Piste" Width="40" Height="20" CornerRadius="10" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0"
                                Background="{DynamicResource Pinceau.Controle}" BorderBrush="{DynamicResource Pinceau.TexteSecondaire}">
                            <Ellipse x:Name="Bouton" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                     Fill="{DynamicResource Pinceau.TexteSecondaire}">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="Glisse" /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="{StaticResource Marge.Gauche.12}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Piste" Property="Background" Value="{DynamicResource Pinceau.Accent}" />
                            <Setter TargetName="Piste" Property="BorderBrush" Value="{DynamicResource Pinceau.Accent}" />
                            <Setter TargetName="Bouton" Property="Fill" Value="{DynamicResource Pinceau.SurAccent}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glisse" Storyboard.TargetProperty="X" To="20" Duration="{StaticResource Duree.Survol}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glisse" Storyboard.TargetProperty="X" To="0" Duration="{StaticResource Duree.Survol}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Piste" Property="BorderBrush" Value="{DynamicResource Pinceau.Texte}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Navigation (barre latérale) ===== -->
    <Style x:Key="ElementNavigation" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisible}" />
        <Setter Property="Foreground" Value="{DynamicResource Pinceau.TexteSecondaire}" />
        <Setter Property="FontSize" Value="{DynamicResource Taille.Interface}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Fond" CornerRadius="{StaticResource Rayon.Controle}" />
                        <Border x:Name="Voile" CornerRadius="{StaticResource Rayon.Controle}" Background="{DynamicResource Pinceau.Voile}" Opacity="0" />
                        <Border x:Name="Indicateur" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{DynamicResource Pinceau.AccentTrait}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Voile" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Duree.Survol}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Voile" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Duree.Survol}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource Ton.Info.Pale}" />
                            <Setter TargetName="Indicateur" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Pinceau.Texte}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liste sans décor (le contenu de chaque ligne fait son propre style). -->
    <Style x:Key="ListeNue" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
</ResourceDictionary>
