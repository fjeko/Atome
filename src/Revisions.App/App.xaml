<Application x:Class="Revisions.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Revisions.App"
             xmlns:vm="clr-namespace:Revisions.App.ViewModels"
             xmlns:v="clr-namespace:Revisions.App.Views"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Système de design (docs/design-atome.md) : jetons, styles de base, composants.
                 Les couleurs et les tailles de texte sont posées par Services/ServiceTheme.cs. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Jetons.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
                <ResourceDictionary Source="Themes/Composants.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:VisibleSiConvertisseur x:Key="VisibleSi" />
            <local:VisibleSiEgalConvertisseur x:Key="VisibleSiEgal" />

            <!-- Quel écran (vue) afficher pour chaque ViewModel. -->
            <DataTemplate DataType="{x:Type vm:AccueilViewModel}"><v:VueAccueil /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BibliothequeViewModel}"><v:VueBibliotheque /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LectureViewModel}"><v:VueLecture /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SessionViewModel}"><v:VueSession /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ParcoursViewModel}"><v:VueParcours /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FinSessionViewModel}"><v:VueFinSession /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatistiquesViewModel}"><v:VueStatistiques /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReglagesViewModel}"><v:VueReglages /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AideViewModel}"><v:VueAide /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChoixRevisionViewModel}"><v:VueChoixRevision /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MesSignalementsViewModel}"><v:VueMesSignalements /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AcquisViewModel}"><v:VueAcquis /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlanningViewModel}"><v:VuePlanning /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuestionnaireViewModel}"><v:VueQuestionnaire /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TdGroupeViewModel}"><v:VueTdGroupe /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:GalerieViewModel}"><v:VueGalerie /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
